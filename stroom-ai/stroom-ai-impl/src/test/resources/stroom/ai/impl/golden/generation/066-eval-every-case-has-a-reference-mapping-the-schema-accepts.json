{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "json",
  "json_layout": "lines",
  "extract": [
   {
    "field": "sourceIPAddress",
    "regex": "^(\\d{1,3}(?:\\.\\d{1,3}){3})$",
    "names": [
     "source_ip"
    ]
   },
   {
    "field": "sourceIPAddress",
    "regex": "^([a-z][\\w.-]*\\.amazonaws\\.com)$",
    "names": [
     "source_service"
    ]
   }
  ],
  "for_each": "Records",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "eventTime",
    "time_format": "yyyy-MM-dd'T'HH:mm:ssX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "AWS CloudTrail"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "field": "eventSource"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "awsRegion"
   },
   {
    "path": "EventSource/User/Id",
    "field": "userIdentity.userName"
   },
   {
    "path": "EventSource/Client/IPAddress",
    "field": "source_ip"
   },
   {
    "path": "EventSource/Client/HostName",
    "field": "source_service"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "eventName"
   }
  ],
  "events": [
   {
    "name": "console-login",
    "when": [
     {
      "field": "eventName",
      "equals": "ConsoleLogin"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "userIdentity.userName"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "responseElements.ConsoleLogin",
      "map": {
       "Success": "true",
       "Failure": "false"
      }
     }
    ]
   },
   {
    "name": "object-read",
    "when": [
     {
      "field": "eventName",
      "equals": "GetObject"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/View/Object/Type",
      "value": "S3 object"
     },
     {
      "path": "EventDetail/View/Object/Id",
      "field": "requestParameters.key"
     },
     {
      "path": "EventDetail/View/Data",
      "field": "requestParameters.bucketName",
      "data_name": "bucket"
     },
     {
      "path": "EventDetail/View/Data",
      "field": "errorCode",
      "data_name": "error"
     }
    ]
   },
   {
    "name": "object-delete",
    "when": [
     {
      "field": "eventName",
      "equals": "DeleteObject"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Delete/Object/Type",
      "value": "S3 object"
     },
     {
      "path": "EventDetail/Delete/Object/Id",
      "field": "requestParameters.key"
     },
     {
      "path": "EventDetail/Delete/Data",
      "field": "requestParameters.bucketName",
      "data_name": "bucket"
     },
     {
      "path": "EventDetail/Delete/Data",
      "field": "errorCode",
      "data_name": "error"
     }
    ]
   },
   {
    "name": "user-create",
    "when": [
     {
      "field": "eventName",
      "equals": "CreateUser"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Create/Object/Type",
      "value": "IAM user"
     },
     {
      "path": "EventDetail/Create/Object/Id",
      "field": "requestParameters.userName"
     },
     {
      "path": "EventDetail/Create/Data",
      "field": "errorCode",
      "data_name": "error"
     }
    ]
   },
   {
    "name": "policy-change",
    "when": [
     {
      "field": "eventName",
      "equals": "PutBucketPolicy"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Update/After/Object/Type",
      "value": "S3 bucket policy"
     },
     {
      "path": "EventDetail/Update/After/Object/Id",
      "field": "requestParameters.bucketName"
     },
     {
      "path": "EventDetail/Update/Data",
      "field": "errorCode",
      "data_name": "error"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[console-login] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[object-read] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[object-delete] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[user-create] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[policy-change] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "console-login",
    "when": [
     "*[@key='eventName'] = 'ConsoleLogin'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Client/HostName",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "object-read",
    "when": [
     "*[@key='eventName'] = 'GetObject'"
    ],
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/View/Data[bucket]",
     "EventDetail/View/Data[error]",
     "EventDetail/View/Object/Id",
     "EventDetail/View/Object/Type",
     "EventSource/Client/HostName",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "object-delete",
    "when": [
     "*[@key='eventName'] = 'DeleteObject'"
    ],
    "fields": [
     "EventDetail/Delete/Data[bucket]",
     "EventDetail/Delete/Data[error]",
     "EventDetail/Delete/Object/Id",
     "EventDetail/Delete/Object/Type",
     "EventDetail/TypeId",
     "EventSource/Client/HostName",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "user-create",
    "when": [
     "*[@key='eventName'] = 'CreateUser'"
    ],
    "fields": [
     "EventDetail/Create/Data[error]",
     "EventDetail/Create/Object/Id",
     "EventDetail/Create/Object/Type",
     "EventDetail/TypeId",
     "EventSource/Client/HostName",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "policy-change",
    "when": [
     "*[@key='eventName'] = 'PutBucketPolicy'"
    ],
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/Update/After/Object/Id",
     "EventDetail/Update/After/Object/Type",
     "EventDetail/Update/Data[error]",
     "EventSource/Client/HostName",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": [],
  "items": "Records"
 }
}
