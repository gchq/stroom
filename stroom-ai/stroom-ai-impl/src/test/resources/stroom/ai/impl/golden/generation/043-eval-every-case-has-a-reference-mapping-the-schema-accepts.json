{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "any_of": [
     "time",
     "timestamp"
    ],
    "time_format": "yyyy-MM-dd'T'HH:mm:ssX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Acme VPN"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "value": "vpnd"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "device",
    "default": "vpn-gw-1"
   },
   {
    "path": "EventSource/Client/IPAddress",
    "field": "src_ip"
   },
   {
    "path": "EventSource/User/Id",
    "any_of": [
     "user",
     "username"
    ]
   },
   {
    "path": "EventDetail/Authenticate/User/Id",
    "any_of": [
     "user",
     "username"
    ]
   }
  ],
  "events": [
   {
    "name": "logon",
    "when": [
     {
      "field": "action",
      "equals": "login"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "Authenticate-Logon"
     },
     {
      "path": "EventDetail/Description",
      "value": "A user signed in to the VPN"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "field": "action",
      "data_name": "action"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "result",
      "map": {
       "ok": "true",
       "fail": "false"
      }
     }
    ]
   },
   {
    "name": "logoff",
    "when": [
     {
      "field": "action",
      "equals": "logout"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "Authenticate-Logoff"
     },
     {
      "path": "EventDetail/Description",
      "value": "A user signed out of the VPN, or their session timed out"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "field": "action",
      "data_name": "action"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     }
    ]
   },
   {
    "name": "timeout",
    "when": [
     {
      "field": "action",
      "equals": "timeout"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "Authenticate-Logoff"
     },
     {
      "path": "EventDetail/Description",
      "value": "A user signed out of the VPN, or their session timed out"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "field": "action",
      "data_name": "action"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[logon] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default. Given the sample, the sample check counts the records that leave each empty: no need to count them.",
   "[logoff] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default. Given the sample, the sample check counts the records that leave each empty: no need to count them.",
   "[timeout] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default. Given the sample, the sample check counts the records that leave each empty: no need to count them."
  ],
  "events": [
   {
    "event": "logon",
    "when": [
     "data[@name='action']/@value = 'login'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Data[action]",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "logoff",
    "when": [
     "data[@name='action']/@value = 'logout'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Data[action]",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "timeout",
    "when": [
     "data[@name='action']/@value = 'timeout'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Data[action]",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
