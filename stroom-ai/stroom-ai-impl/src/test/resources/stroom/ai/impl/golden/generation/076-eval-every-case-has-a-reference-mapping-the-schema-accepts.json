{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time",
    "time_format": "yyyy-MM-dd'T'HH:mm:ssX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Mail Gateway"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "value": "mailgw"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "host"
   },
   {
    "path": "EventSource/User/EmailAddress",
    "field": "from"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "action"
   }
  ],
  "events": [
   {
    "name": "message",
    "fields": [
     {
      "path": "EventDetail/Send/Source/User/EmailAddress",
      "field": "from"
     },
     {
      "path": "EventDetail/Send/Destination/User/EmailAddress",
      "field": "rcpt",
      "repeat": true
     },
     {
      "path": "EventDetail/Send/Payload/Email/Id",
      "field": "msgid"
     },
     {
      "path": "EventDetail/Send/Payload/Email/Name",
      "field": "subject"
     },
     {
      "path": "EventDetail/Send/Data",
      "field": "size",
      "data_name": "size"
     },
     {
      "path": "EventDetail/Send/Data",
      "field": "action",
      "data_name": "action"
     },
     {
      "path": "EventDetail/Send/Outcome/Success",
      "field": "action",
      "map": {
       "deliver": "true"
      },
      "default": "false"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[message] TypeId is read from action, which its records may lack: those get TypeId 'message', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[message] required ['EventTime', 'EventSource/Device', 'EventDetail/Send/Source', 'EventDetail/Send/Destination'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "message",
    "when": "every record",
    "fields": [
     "EventDetail/Send/Data[action]",
     "EventDetail/Send/Data[size]",
     "EventDetail/Send/Destination/User/EmailAddress",
     "EventDetail/Send/Outcome/Success",
     "EventDetail/Send/Payload/Email/Id",
     "EventDetail/Send/Payload/Email/Name",
     "EventDetail/Send/Source/User/EmailAddress",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/EmailAddress",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
