{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "xml_fragments",
  "record": "Event",
  "xml_namespace": "http://schemas.microsoft.com/win/2004/08/events/event",
  "nil_values": [
   "-"
  ],
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "xpath": "replace(System/TimeCreated/@SystemTime, '(\\.\\d{3})\\d*Z$', '$1Z')",
    "time_format": "yyyy-MM-dd'T'HH:mm:ss.SSSX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Active Directory"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "field": "System/Provider/@Name"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "System/Computer"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "System/EventID"
   }
  ],
  "events": [
   {
    "name": "logon",
    "when": [
     {
      "field": "System/EventID",
      "equals": "4624"
     }
    ],
    "fields": [
     {
      "path": "EventSource/User/Id",
      "field": "EventData/Data[@Name='TargetUserName']"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "EventData/Data[@Name='IpAddress']"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "EventData/Data[@Name='TargetUserName']"
     },
     {
      "path": "EventDetail/Authenticate/User/Domain",
      "field": "EventData/Data[@Name='TargetDomainName']"
     },
     {
      "path": "EventDetail/Authenticate/LogonType",
      "field": "EventData/Data[@Name='LogonType']",
      "map": {
       "2": "Interactive",
       "3": "Network",
       "4": "Batch",
       "5": "Service",
       "10": "RemoteInteractive",
       "11": "CachedInteractive"
      },
      "default": "Other"
     }
    ]
   },
   {
    "name": "failed logon",
    "when": [
     {
      "field": "System/EventID",
      "equals": "4625"
     }
    ],
    "fields": [
     {
      "path": "EventSource/User/Id",
      "field": "EventData/Data[@Name='TargetUserName']"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "EventData/Data[@Name='IpAddress']"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "EventData/Data[@Name='TargetUserName']"
     },
     {
      "path": "EventDetail/Authenticate/User/Domain",
      "field": "EventData/Data[@Name='TargetDomainName']"
     },
     {
      "path": "EventDetail/Authenticate/LogonType",
      "field": "EventData/Data[@Name='LogonType']",
      "map": {
       "2": "Interactive",
       "3": "Network",
       "4": "Batch",
       "5": "Service",
       "10": "RemoteInteractive",
       "11": "CachedInteractive"
      },
      "default": "Other"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "value": "false"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Description",
      "field": "EventData/Data[@Name='FailureReason']"
     }
    ]
   },
   {
    "name": "logoff",
    "when": [
     {
      "field": "System/EventID",
      "equals": "4634"
     }
    ],
    "fields": [
     {
      "path": "EventSource/User/Id",
      "field": "EventData/Data[@Name='TargetUserName']"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "EventData/Data[@Name='TargetUserName']"
     }
    ]
   },
   {
    "name": "special privileges",
    "when": [
     {
      "field": "System/EventID",
      "equals": "4672"
     }
    ],
    "fields": [
     {
      "path": "EventSource/User/Id",
      "field": "EventData/Data[@Name='SubjectUserName']"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "ElevatePrivilege"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "EventData/Data[@Name='SubjectUserName']"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "field": "EventData/Data[@Name='PrivilegeList']",
      "data_name": "privileges"
     }
    ]
   },
   {
    "name": "account locked",
    "when": [
     {
      "field": "System/EventID",
      "equals": "4740"
     }
    ],
    "fields": [
     {
      "path": "EventSource/User/Id",
      "field": "EventData/Data[@Name='SubjectUserName']"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "AccountLock"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "EventData/Data[@Name='TargetUserName']"
     }
    ]
   },
   {
    "name": "account created",
    "when": [
     {
      "field": "System/EventID",
      "equals": "4720"
     }
    ],
    "fields": [
     {
      "path": "EventSource/User/Id",
      "field": "EventData/Data[@Name='SubjectUserName']"
     },
     {
      "path": "EventDetail/Create/User/Id",
      "field": "EventData/Data[@Name='TargetUserName']"
     },
     {
      "path": "EventDetail/Create/User/Domain",
      "field": "EventData/Data[@Name='TargetDomainName']"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[logon] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[failed logon] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[logoff] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[special privileges] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[account locked] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[account created] required ['EventTime', 'EventDetail', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "logon",
    "when": [
     "System/EventID = '4624'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/LogonType",
     "EventDetail/Authenticate/User/Domain",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "failed logon",
    "when": [
     "System/EventID = '4625'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/LogonType",
     "EventDetail/Authenticate/Outcome/Description",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Domain",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "logoff",
    "when": [
     "System/EventID = '4634'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "special privileges",
    "when": [
     "System/EventID = '4672'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Data[privileges]",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "account locked",
    "when": [
     "System/EventID = '4740'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "account created",
    "when": [
     "System/EventID = '4720'"
    ],
    "fields": [
     "EventDetail/Create/User/Domain",
     "EventDetail/Create/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
