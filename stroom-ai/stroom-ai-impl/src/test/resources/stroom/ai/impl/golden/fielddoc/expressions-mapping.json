{
 "input": "data_splitter",
 "xml_namespace": "",
 "json_layout": "array",
 "json_fields": [],
 "xml_fields": [],
 "pairs": [],
 "extract": [],
 "nil_values": [],
 "drop_when": [],
 "common": [
  {
   "path": "EventTime/TimeCreated",
   "field": "time",
   "repeat": false
  },
  {
   "path": "EventSource/System/Name",
   "value": "Acme VPN",
   "repeat": false
  },
  {
   "path": "EventSource/System/Environment",
   "value": "Dev",
   "repeat": false
  },
  {
   "path": "EventSource/Generator",
   "value": "vpnd",
   "repeat": false
  },
  {
   "path": "EventSource/Device/HostName",
   "field": "host",
   "repeat": false,
   "default": "unknown"
  },
  {
   "path": "EventSource/User/Id",
   "xpath": "normalize-space(data[@name='user']/@value)",
   "repeat": false
  }
 ],
 "events": [
  {
   "name": "logon",
   "when": [
    {
     "xpath": "concat(data[@name='action']/@value, '-', data[@name='a']/data[@name='b']/@value)",
     "equals": "login-x"
    }
   ],
   "fields": [
    {
     "path": "EventDetail/TypeId",
     "value": "Logon",
     "repeat": false
    },
    {
     "path": "EventDetail/Authenticate/Action",
     "value": "Logon",
     "repeat": false
    },
    {
     "path": "EventDetail/Authenticate/User/Id",
     "field": "user",
     "repeat": false
    },
    {
     "path": "EventDetail/Authenticate/Outcome/Success",
     "field": "result",
     "repeat": false,
     "map": {
      "ok": "true",
      "fail": "false"
     }
    },
    {
     "path": "EventDetail/Authenticate/Data",
     "field": "sid",
     "repeat": false,
     "data_name": "session"
    }
   ],
   "drop": false,
   "keep_unknown": false,
   "data": []
  }
 ],
 "unmatched": "skip",
 "style": {
  "naming": "snake_case",
  "variable_min_reads": 3,
  "inline_map_max_keys": 3,
  "function_min_uses": 2,
  "data_values": "interpolated",
  "data_entries": "function",
  "data_run_min": 4,
  "variables": "just_in_time",
  "data_names": "as_given",
  "layout": "modes"
 },
 "imports": [],
 "shared": [],
 "functions": []
}
