{
 "source": "xsltgen-sampled-field-mapping-matches-events-to-rules-by-the",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Acme VPN"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Dev"
   },
   {
    "path": "EventSource/Generator",
    "value": "vpnd"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "host",
    "default": "unknown"
   },
   {
    "path": "EventSource/User/Id",
    "field": "user"
   }
  ],
  "events": [
   {
    "name": "logon",
    "when": [
     {
      "field": "action",
      "equals": "login"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "result",
      "map": {
       "ok": "true",
       "fail": "false"
      }
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "field": "sid",
      "data_name": "session"
     },
     {
      "path": "EventDetail/Description",
      "field": "result"
     }
    ]
   },
   {
    "name": "logoff",
    "when": [
     {
      "field": "action",
      "equals": "logout"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "result",
      "map": {
       "ok": "true",
       "fail": "false"
      }
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "field": "sid",
      "data_name": "session"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "ip"
     }
    ]
   },
   {
    "name": "other",
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "field": "action"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "field": "action",
      "data_name": "action"
     }
    ]
   }
  ],
  "unmatched": "skip"
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[logon] EventTime/TimeCreated: TimeCreated is a date-time; give time_format (from profile_sample) unless the input is already yyyy-MM-ddTHH:mm:ss.SSSZ",
   "[logon] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[logoff] EventTime/TimeCreated: TimeCreated is a date-time; give time_format (from profile_sample) unless the input is already yyyy-MM-ddTHH:mm:ss.SSSZ",
   "[logoff] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[other] TypeId is read from action, which its records may lack: those get TypeId 'other', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[other] EventTime/TimeCreated: TimeCreated is a date-time; give time_format (from profile_sample) unless the input is already yyyy-MM-ddTHH:mm:ss.SSSZ",
   "[other] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "logon",
    "when": [
     "data[@name='action']/@value = 'login'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Data[session]",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "logoff",
    "when": [
     "data[@name='action']/@value = 'logout'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Data[session]",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "other",
    "when": "every record",
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/Unknown/Data[action]",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
