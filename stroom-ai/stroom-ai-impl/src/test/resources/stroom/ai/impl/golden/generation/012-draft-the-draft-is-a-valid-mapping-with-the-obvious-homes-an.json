     "EventSource/Server/Port",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "login",
    "when": [
     "*[@key='event_type'] = 'LOGIN'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Data[action]",
     "EventDetail/Authenticate/Data[bytes_received]",
     "EventDetail/Authenticate/Data[bytes_sent]",
     "EventDetail/Authenticate/Data[protocol]",
     "EventDetail/Authenticate/Data[rule_id]",
     "EventDetail/Authenticate/Data[severity]",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Client/Port",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/Server/IPAddress",
     "EventSource/Server/Port",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "other",
    "when": "every record",
    "fields": [
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventDetail/Unknown/Data[action]",
     "EventDetail/Unknown/Data[bytes_received]",
