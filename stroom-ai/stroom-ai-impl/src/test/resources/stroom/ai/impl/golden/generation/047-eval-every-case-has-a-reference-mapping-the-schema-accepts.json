{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "json",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "xpath": "json-to-xml(*[@key='event'])/*/*[@key='timestamp']",
    "time_format": "yyyy-MM-dd'T'HH:mm:ss.SSSXXX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Document Service"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "value": "dms"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "host"
   },
   {
    "path": "EventSource/User/Id",
    "xpath": "json-to-xml(*[@key='event'])/*/*[@key='username']"
   },
   {
    "path": "EventDetail/TypeId",
    "xpath": "json-to-xml(*[@key='event'])/*/*[@key='event_type']"
   },
   {
    "path": "EventDetail/Description",
    "xpath": "json-to-xml(*[@key='event'])/*/*[@key='message']"
   }
  ],
  "events": [
   {
    "name": "logon",
    "when": [
     {
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='event_type']",
      "one_of": [
       "LOGIN_SUCCESS",
       "LOGIN_FAILURE"
      ]
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='username']"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='event_type']",
      "map": {
       "LOGIN_SUCCESS": "true",
       "LOGIN_FAILURE": "false"
      }
     }
    ]
   },
   {
    "name": "logoff",
    "when": [
     {
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='event_type']",
      "equals": "LOGOUT"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='username']"
     }
    ]
   },
   {
    "name": "password change",
    "when": [
     {
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='event_type']",
      "equals": "PASSWORD_CHANGE"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "ChangePassword"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='username']"
     }
    ]
   },
   {
    "name": "view",
    "when": [
     {
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='event_type']",
      "equals": "DOCUMENT_VIEW"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/View/Document/Name",
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='resource']"
     }
    ]
   },
   {
    "name": "delete",
    "when": [
     {
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='event_type']",
      "equals": "DOCUMENT_DELETE"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Delete/Document/Name",
      "xpath": "json-to-xml(*[@key='event'])/*/*[@key='resource']"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[logon] TypeId is read from its input, which its records may lack: those get TypeId 'logon', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[logon] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[logoff] TypeId is read from its input, which its records may lack: those get TypeId 'logoff', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[logoff] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[password change] TypeId is read from its input, which its records may lack: those get TypeId 'password change', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[password change] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[view] TypeId is read from its input, which its records may lack: those get TypeId 'view', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[view] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[delete] TypeId is read from its input, which its records may lack: those get TypeId 'delete', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[delete] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "logon",
    "when": [
     "mcp:json-to-xml(*[@key='event'])/*/*[@key='event_type'] = ('LOGIN_SUCCESS', 'LOGIN_FAILURE')"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "logoff",
    "when": [
     "mcp:json-to-xml(*[@key='event'])/*/*[@key='event_type'] = 'LOGOUT'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "password change",
    "when": [
     "mcp:json-to-xml(*[@key='event'])/*/*[@key='event_type'] = 'PASSWORD_CHANGE'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "view",
    "when": [
     "mcp:json-to-xml(*[@key='event'])/*/*[@key='event_type'] = 'DOCUMENT_VIEW'"
    ],
    "fields": [
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventDetail/View/Document/Name",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "delete",
    "when": [
     "mcp:json-to-xml(*[@key='event'])/*/*[@key='event_type'] = 'DOCUMENT_DELETE'"
    ],
    "fields": [
     "EventDetail/Delete/Document/Name",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
