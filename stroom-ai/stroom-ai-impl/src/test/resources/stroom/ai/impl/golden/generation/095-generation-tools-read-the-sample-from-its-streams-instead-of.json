{
 "source": "generation-tools-read-the-sample-from-its-streams-instead-of",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time",
    "time_format": "yyyy-MM-dd'T'HH:mm:ssX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "TODO system name"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "TODO e.g. Prod"
   },
   {
    "path": "EventSource/User/Id",
    "field": "user"
   },
   {
    "path": "EventSource/Generator",
    "value": "TODO generator"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "action"
   }
  ],
  "events": [
   {
    "name": "login",
    "when": [
     {
      "field": "action",
      "equals": "login"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     }
    ]
   },
   {
    "name": "logout",
    "when": [
     {
      "field": "action",
      "equals": "logout"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     }
    ]
   },
   {
    "name": "other",
    "fields": [
     {
      "path": "EventDetail/Unknown/Data",
      "field": "action",
      "data_name": "action"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": false,
  "problems": [
   "[login] Event/EventSource/Device is required by the schema; map it",
   "[logout] Event/EventSource/Device is required by the schema; map it",
   "[other] Event/EventSource/Device is required by the schema; map it"
  ],
  "warnings": [
   "[login] required ['EventTime', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[logout] required ['EventTime', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[other] TypeId is read from action, which its records may lack: those get TypeId 'other', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[other] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "login",
    "when": [
     "data[@name='action']/@value = 'login'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "logout",
    "when": [
     "data[@name='action']/@value = 'logout'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "other",
    "when": "every record",
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/Unknown/Data[action]",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
