{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "extract": [
   {
    "xpath": "replace(data[@name='message']/@value, '\\n\\S+ (stdout|stderr) [PF] ', '')",
    "regex": "^user=(\\S+) action=(\\S+) result=(\\S+) pod=(\\S+)(?: detail=(\\S+) rows=(\\d+))?$",
    "names": [
     "user",
     "action",
     "result",
     "pod",
     "detail",
     "rows"
    ]
   }
  ],
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time",
    "time_format": "yyyy-MM-dd'T'HH:mm:ss.SSSSSSX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "API"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "field": "stream"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "pod"
   },
   {
    "path": "EventSource/User/Id",
    "field": "user"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "action"
   }
  ],
  "events": [
   {
    "name": "logon",
    "when": [
     {
      "field": "action",
      "equals": "login"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "result",
      "map": {
       "success": "true",
       "failure": "false"
      }
     }
    ]
   },
   {
    "name": "logoff",
    "when": [
     {
      "field": "action",
      "equals": "logout"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     }
    ]
   },
   {
    "name": "export",
    "when": [
     {
      "field": "action",
      "equals": "export"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Export/Source/Object/Type",
      "value": "Records"
     },
     {
      "path": "EventDetail/Export/Source/Object/Description",
      "field": "detail"
     },
     {
      "path": "EventDetail/Export/Data",
      "field": "rows",
      "data_name": "rows"
     },
     {
      "path": "EventDetail/Export/Outcome/Success",
      "field": "result",
      "map": {
       "success": "true",
       "failure": "false"
      }
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[logon] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[logoff] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[export] required ['EventTime', 'EventSource/Generator', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "logon",
    "when": [
     "action = 'login'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "logoff",
    "when": [
     "action = 'logout'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "export",
    "when": [
     "action = 'export'"
    ],
    "fields": [
     "EventDetail/Export/Data[rows]",
     "EventDetail/Export/Outcome/Success",
     "EventDetail/Export/Source/Object/Description",
     "EventDetail/Export/Source/Object/Type",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
