{
 "source": "xsltgen-unknown-in-a-rule-with-conditions-is-a-problem-unles",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Acme VPN"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Dev"
   },
   {
    "path": "EventSource/Generator",
    "value": "vpnd"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "host",
    "default": "unknown"
   },
   {
    "path": "EventSource/User/Id",
    "field": "user"
   }
  ],
  "events": [
   {
    "name": "status",
    "when": [
     {
      "field": "action",
      "equals": "status"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "field": "action"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "field": "action",
      "data_name": "action"
     }
    ],
    "allow_unknown": "status lines carry no activity"
   },
   {
    "name": "other",
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "field": "action"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "field": "action",
      "data_name": "action"
     }
    ]
   }
  ],
  "unmatched": "skip"
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[status] EventTime/TimeCreated: TimeCreated is a date-time; give time_format (from profile_sample) unless the input is already yyyy-MM-ddTHH:mm:ss.SSSZ",
   "[status] required ['EventTime', 'EventDetail'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[other] TypeId is read from action, which its records may lack: those get TypeId 'other', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[other] EventTime/TimeCreated: TimeCreated is a date-time; give time_format (from profile_sample) unless the input is already yyyy-MM-ddTHH:mm:ss.SSSZ",
   "[other] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "status",
    "when": [
     "data[@name='action']/@value = 'status'"
    ],
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/Unknown/Data[action]",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "other",
    "when": "every record",
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/Unknown/Data[action]",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
