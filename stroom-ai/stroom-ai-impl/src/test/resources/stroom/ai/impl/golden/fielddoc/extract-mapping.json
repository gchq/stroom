{
 "input": "json",
 "xml_namespace": "",
 "json_layout": "lines",
 "json_fields": [],
 "xml_fields": [],
 "pairs": [],
 "extract": [
  {
   "field": "message",
   "regex": "^(\\S+) (\\S+) (\\S+) (.*)$",
   "names": [
    "ts",
    "user",
    "action",
    "desc"
   ],
   "flags": ""
  }
 ],
 "nil_values": [],
 "drop_when": [],
 "common": [
  {
   "path": "EventTime/TimeCreated",
   "field": "ts",
   "repeat": false
  },
  {
   "path": "EventSource/System/Name",
   "value": "App",
   "repeat": false
  },
  {
   "path": "EventSource/System/Environment",
   "value": "Dev",
   "repeat": false
  },
  {
   "path": "EventSource/Generator",
   "value": "app",
   "repeat": false
  },
  {
   "path": "EventSource/Device/HostName",
   "field": "host",
   "repeat": false
  },
  {
   "path": "EventSource/User/Id",
   "field": "user",
   "repeat": false
  },
  {
   "path": "EventDetail/TypeId",
   "field": "action",
   "repeat": false
  },
  {
   "path": "EventDetail/Description",
   "field": "desc",
   "repeat": false
  }
 ],
 "events": [
  {
   "name": "logon",
   "when": [
    {
     "field": "action",
     "equals": "LOGIN"
    }
   ],
   "fields": [
    {
     "path": "EventDetail/Authenticate/Action",
     "value": "Logon",
     "repeat": false
    },
    {
     "path": "EventDetail/Authenticate/User/Id",
     "field": "user",
     "repeat": false
    }
   ],
   "drop": false,
   "keep_unknown": false,
   "data": []
  },
  {
   "name": "logoff",
   "when": [
    {
     "field": "action",
     "equals": "LOGOUT"
    }
   ],
   "fields": [
    {
     "path": "EventDetail/Authenticate/Action",
     "value": "Logoff",
     "repeat": false
    },
    {
     "path": "EventDetail/Authenticate/User/Id",
     "field": "user",
     "repeat": false
    }
   ],
   "drop": false,
   "keep_unknown": false,
   "data": []
  },
  {
   "name": "unparsed",
   "when": [
    {
     "field": "ts",
     "present": false
    }
   ],
   "fields": [],
   "drop": true,
   "keep_unknown": false,
   "data": []
  }
 ],
 "unmatched": "skip",
 "style": {
  "naming": "snake_case",
  "variable_min_reads": 3,
  "inline_map_max_keys": 3,
  "function_min_uses": 2,
  "data_values": "interpolated",
  "data_entries": "function",
  "data_run_min": 4,
  "variables": "just_in_time",
  "data_names": "as_given",
  "layout": "modes"
 },
 "imports": [],
 "shared": [],
 "functions": []
}
