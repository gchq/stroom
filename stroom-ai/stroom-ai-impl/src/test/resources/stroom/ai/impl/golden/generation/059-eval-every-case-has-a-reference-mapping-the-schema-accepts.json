{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "json",
  "json_layout": "lines",
  "common": [
   {
    "path": "EventSource/System/Name",
    "value": "Identity Provider"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "value": "idp"
   },
   {
    "path": "EventSource/Device/HostName",
    "value": "idp.example.org"
   }
  ],
  "events": [
   {
    "name": "new session start",
    "when": [
     {
      "field": "eventType",
      "equals": "user.session.start"
     }
    ],
    "fields": [
     {
      "path": "EventTime/TimeCreated",
      "field": "published",
      "time_format": "yyyy-MM-dd'T'HH:mm:ss.SSSX"
     },
     {
      "path": "EventSource/User/Id",
      "field": "actor.alternateId"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "client.ipAddress"
     },
     {
      "path": "EventDetail/TypeId",
      "field": "eventType"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "actor.alternateId"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "outcome.result",
      "map": {
       "SUCCESS": "true",
       "FAILURE": "false"
      }
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Description",
      "field": "outcome.reason"
     }
    ]
   },
   {
    "name": "new session end",
    "when": [
     {
      "field": "eventType",
      "equals": "user.session.end"
     }
    ],
    "fields": [
     {
      "path": "EventTime/TimeCreated",
      "field": "published",
      "time_format": "yyyy-MM-dd'T'HH:mm:ss.SSSX"
     },
     {
      "path": "EventSource/User/Id",
      "field": "actor.alternateId"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "client.ipAddress"
     },
     {
      "path": "EventDetail/TypeId",
      "field": "eventType"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "actor.alternateId"
     }
    ]
   },
   {
    "name": "new account lock",
    "when": [
     {
      "field": "eventType",
      "equals": "user.account.lock"
     }
    ],
    "fields": [
     {
      "path": "EventTime/TimeCreated",
      "field": "published",
      "time_format": "yyyy-MM-dd'T'HH:mm:ss.SSSX"
     },
     {
      "path": "EventSource/User/Id",
      "field": "actor.alternateId"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "client.ipAddress"
     },
     {
      "path": "EventDetail/TypeId",
      "field": "eventType"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "AccountLock"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "actor.alternateId"
     }
    ]
   },
   {
    "name": "legacy login",
    "when": [
     {
      "field": "type",
      "equals": "login"
     }
    ],
    "fields": [
     {
      "path": "EventTime/TimeCreated",
      "field": "ts",
      "time_format": "yyyy-MM-dd'T'HH:mm:ssX"
     },
     {
      "path": "EventSource/User/Id",
      "field": "user"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "ip"
     },
     {
      "path": "EventDetail/TypeId",
      "field": "type"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "ok"
     }
    ]
   },
   {
    "name": "legacy logout",
    "when": [
     {
      "field": "type",
      "equals": "logout"
     }
    ],
    "fields": [
     {
      "path": "EventTime/TimeCreated",
      "field": "ts",
      "time_format": "yyyy-MM-dd'T'HH:mm:ssX"
     },
     {
      "path": "EventSource/User/Id",
      "field": "user"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "ip"
     },
     {
      "path": "EventDetail/TypeId",
      "field": "type"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     }
    ]
   },
   {
    "name": "legacy password change",
    "when": [
     {
      "field": "type",
      "equals": "password_change"
     }
    ],
    "fields": [
     {
      "path": "EventTime/TimeCreated",
      "field": "ts",
      "time_format": "yyyy-MM-dd'T'HH:mm:ssX"
     },
     {
      "path": "EventSource/User/Id",
      "field": "user"
     },
     {
      "path": "EventSource/Client/IPAddress",
      "field": "ip"
     },
     {
      "path": "EventDetail/TypeId",
      "field": "type"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "ChangePassword"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "ok"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[new session start] required ['EventTime', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[new session end] required ['EventTime', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[new account lock] required ['EventTime', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[legacy login] EventDetail/Authenticate/Outcome/Success: Success is true/false; map the input values, e.g. {'ok': 'true', 'fail': 'false'}, unless they already are",
   "[legacy login] required ['EventTime', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[legacy logout] required ['EventTime', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[legacy password change] EventDetail/Authenticate/Outcome/Success: Success is true/false; map the input values, e.g. {'ok': 'true', 'fail': 'false'}, unless they already are",
   "[legacy password change] required ['EventTime', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
