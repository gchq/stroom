{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "xpath": "concat('2026 ', replace(data[@name='time']/@value, '  ', ' '))",
    "time_format": "yyyy MMM d HH:mm:ss",
    "timezone": "UTC"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Web"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "value": "sudo"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "host"
   },
   {
    "path": "EventSource/User/Id",
    "field": "user"
   },
   {
    "path": "EventSource/RunAs/Id",
    "field": "runas"
   }
  ],
  "events": [
   {
    "name": "sudo command",
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "Sudo"
     },
     {
      "path": "EventDetail/Process/Action",
      "value": "Execute"
     },
     {
      "path": "EventDetail/Process/Type",
      "value": "Application"
     },
     {
      "path": "EventDetail/Process/Command",
      "field": "command"
     },
     {
      "path": "EventDetail/Process/Arguments",
      "field": "args"
     },
     {
      "path": "EventDetail/Process/Data",
      "field": "pwd",
      "data_name": "working_directory"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[sudo command] required ['EventTime', 'EventSource/Device', 'EventDetail/Process/Command'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "sudo command",
    "when": "every record",
    "fields": [
     "EventDetail/Process/Action",
     "EventDetail/Process/Arguments",
     "EventDetail/Process/Command",
     "EventDetail/Process/Data[working_directory]",
     "EventDetail/Process/Type",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/RunAs/Id",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
