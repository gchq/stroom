{
 "source": "draft-key-value-pairs-in-a-text-field-are-drafted-as-fields",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "xml_fragments",
  "record": "Event",
  "xml_namespace": "http://schemas.microsoft.com/win/2004/08/events/event",
  "extract": [
   {
    "field": "EventData/Data",
    "regex": "(?:^|[;|()\\]]|\\s-)\\s*User: (.*?)(?:\\s*[;|()]|\\s+-\\s+(?:\\[|[A-Za-z][A-Za-z0-9_-]*(?: [A-Za-z][A-Za-z0-9_-]*){0,3}: )|\\s*$)",
    "names": [
     "user"
    ]
   },
   {
    "field": "EventData/Data",
    "regex": "(?:^|[;|()\\]]|\\s-)\\s*Event: \\[([^\\]]*)\\]",
    "names": [
     "event"
    ]
   },
   {
    "field": "EventData/Data",
    "regex": "(?:^|[;|()\\]]|\\s-)\\s*Action: \\[([^\\]]*)\\]",
    "names": [
     "action"
    ]
   },
   {
    "field": "EventData/Data",
    "regex": "(?:^|[;|()\\]]|\\s-)\\s*By User: (.*?)(?:\\s*[;|()]|\\s+-\\s+(?:\\[|[A-Za-z][A-Za-z0-9_-]*(?: [A-Za-z][A-Za-z0-9_-]*){0,3}: )|\\s*$)",
    "names": [
     "by_user"
    ]
   },
   {
    "field": "EventData/Data",
