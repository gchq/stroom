    "names": [
     "item_id"
    ]
   },
   {
    "field": "EventData/Data",
    "regex": "(?:^|[;|()\\]]|\\s-)\\s*Source IP: (.*?)(?:\\s*[;|()]|\\s+-\\s+(?:\\[|[A-Za-z][A-Za-z0-9_-]*(?: [A-Za-z][A-Za-z0-9_-]*){0,3}: )|\\s*$)",
    "names": [
     "source_ip"
    ]
   },
   {
    "field": "EventData/Data",
