      "field": "employee_name"
     },
     {
      "path": "EventDetail/Create/User/Data",
      "field": "department",
      "data_name": "department"
     }
    ]
   },
   {
    "name": "mover",
    "when": [
     {
      "field": "change",
      "equals": "mover"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Update/After/User/Id",
      "field": "employee_id"
     },
     {
      "path": "EventDetail/Update/After/User/Name",
      "field": "employee_name"
     },
     {
      "path": "EventDetail/Update/After/User/Data",
      "field": "department",
      "data_name": "department"
     }
    ]
   },
   {
    "name": "leaver",
    "when": [
     {
      "field": "change",
      "equals": "leaver"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Delete/User/Id",
      "field": "employee_id"
     },
     {
      "path": "EventDetail/Delete/User/Name",
      "field": "employee_name"
     },
     {
      "path": "EventDetail/Delete/User/Data",
      "field": "department",
      "data_name": "department"
     }
    ]
   }
  ]
 },
