      "data_name": "protocol",
      "field": "protocol"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "action",
      "field": "action"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "rule_id",
      "field": "rule_id"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "bytes_sent",
      "field": "bytes_sent"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "bytes_received",
