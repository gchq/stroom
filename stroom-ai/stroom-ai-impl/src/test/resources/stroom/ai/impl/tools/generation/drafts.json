{
 "fortigate": {
  "input": "json",
  "json_layout": "lines",
  "extract": [
   {
    "field": "body",
    "regex": "(?:^|[\\s,;])logid=\"([^\"]*)\"",
    "names": [
     "logid"
    ]
   },
   {
    "field": "body",
    "regex": "(?:^|[\\s,;])type=\"([^\"]*)\"",
    "names": [
     "type"
    ]
   },
   {
    "field": "body",
    "regex": "(?:^|[\\s,;])action=\"([^\"]*)\"",
    "names": [
     "action"
    ]
   },
   {
    "field": "body",
    "regex": "(?:^|[\\s,;])srcip=([^\\s,;\"]*)",
    "names": [
     "srcip"
    ]
   },
   {
    "field": "body",
    "regex": "(?:^|[\\s,;])dstip=([^\\s,;\"]*)",
    "names": [
     "dstip"
    ]
   },
   {
    "field": "body",
    "regex": "(?:^|[\\s,;])msg=\"([^\"]*)\"",
    "names": [
     "msg"
    ]
   },
   {
    "field": "body",
    "regex": "(?:^|[\\s,;])user=\"([^\"]*)\"",
    "names": [
     "user"
    ]
   }
  ],
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time",
    "time_format": "yyyy-MM-dd'T'HH:mm:ss.SSSX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Fortigate"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "TODO e.g. Prod"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "host"
   },
   {
    "path": "EventSource/Client/IPAddress",
    "field": "srcip"
   },
   {
    "path": "EventSource/Server/IPAddress",
    "field": "dstip"
   },
   {
    "path": "EventSource/User/Id",
    "field": "user"
   },
   {
    "path": "EventDetail/Description",
    "field": "msg"
   },
   {
    "path": "EventSource/Generator",
    "value": "Fortigate"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "type"
   }
  ],
  "events": [
   {
    "name": "traffic_permitted",
    "when": [
     {
      "field": "type",
      "equals": "traffic"
     },
     {
      "field": "action",
      "equals": "accept"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Network/Permit/Source/Device/IPAddress",
      "field": "srcip"
     },
     {
      "path": "EventDetail/Network/Permit/Destination/Device/IPAddress",
      "field": "dstip"
     },
     {
      "path": "EventDetail/Network/Permit/Data",
      "data_name": "logid",
      "field": "logid"
     }
    ]
   },
   {
    "name": "event_permitted",
    "when": [
     {
      "field": "type",
      "equals": "event"
     },
     {
      "field": "action",
      "equals": "accept"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Network/Permit/Source/Device/IPAddress",
      "field": "srcip"
     },
     {
      "path": "EventDetail/Network/Permit/Destination/Device/IPAddress",
      "field": "dstip"
     },
     {
      "path": "EventDetail/Network/Permit/Data",
      "data_name": "logid",
      "field": "logid"
     }
    ]
   },
   {
    "name": "other",
    "fields": [
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "logid",
      "field": "logid"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "action",
      "field": "action"
     }
    ]
   }
  ]
 },
 "fw": {
  "input": "data_splitter",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "timestamp",
    "time_format": "yyyy-MM-dd'T'HH:mm:ssXXX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "FW"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Prod"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "device"
   },
   {
    "path": "EventSource/Client/IPAddress",
    "field": "src_ip"
   },
   {
    "path": "EventSource/Client/Port",
    "field": "src_port"
   },
   {
    "path": "EventSource/Server/IPAddress",
    "field": "dst_ip"
   },
   {
    "path": "EventSource/Server/Port",
    "field": "dst_port"
   },
   {
    "path": "EventSource/User/Id",
    "field": "username"
   },
   {
    "path": "EventDetail/Description",
    "field": "message"
   },
   {
    "path": "EventSource/Generator",
    "value": "FW"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "event_type"
   }
  ],
  "events": [
   {
    "name": "traffic_permitted",
    "when": [
     {
      "field": "event_type",
      "equals": "TRAFFIC"
     },
     {
      "field": "action",
      "equals": "ALLOW"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Network/Permit/Source/Device/IPAddress",
      "field": "src_ip"
     },
     {
      "path": "EventDetail/Network/Permit/Source/Port",
      "field": "src_port"
     },
     {
      "path": "EventDetail/Network/Permit/Source/TransportProtocol",
      "field": "protocol",
      "map": {
       "TCP": "TCP"
      },
      "default": "Other"
     },
     {
      "path": "EventDetail/Network/Permit/Destination/Device/IPAddress",
      "field": "dst_ip"
     },
     {
      "path": "EventDetail/Network/Permit/Destination/Port",
      "field": "dst_port"
     },
     {
      "path": "EventDetail/Network/Permit/Data",
      "data_name": "severity",
      "field": "severity"
     },
     {
      "path": "EventDetail/Network/Permit/Data",
      "data_name": "rule_id",
      "field": "rule_id"
     },
     {
      "path": "EventDetail/Network/Permit/Data",
      "data_name": "bytes_sent",
      "field": "bytes_sent"
     },
     {
      "path": "EventDetail/Network/Permit/Data",
      "data_name": "bytes_received",
      "field": "bytes_received"
     }
    ]
   },
   {
    "name": "traffic_denied",
    "when": [
     {
      "field": "event_type",
      "equals": "TRAFFIC"
     },
     {
      "field": "action",
      "equals": "DENY"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Network/Deny/Source/Device/IPAddress",
      "field": "src_ip"
     },
     {
      "path": "EventDetail/Network/Deny/Source/Port",
      "field": "src_port"
     },
     {
      "path": "EventDetail/Network/Deny/Source/TransportProtocol",
      "field": "protocol",
      "map": {
       "TCP": "TCP"
      },
      "default": "Other"
     },
     {
      "path": "EventDetail/Network/Deny/Destination/Device/IPAddress",
      "field": "dst_ip"
     },
     {
      "path": "EventDetail/Network/Deny/Destination/Port",
      "field": "dst_port"
     },
     {
      "path": "EventDetail/Network/Deny/Data",
      "data_name": "severity",
      "field": "severity"
     },
     {
      "path": "EventDetail/Network/Deny/Data",
      "data_name": "rule_id",
      "field": "rule_id"
     },
     {
      "path": "EventDetail/Network/Deny/Data",
      "data_name": "bytes_sent",
      "field": "bytes_sent"
     },
     {
      "path": "EventDetail/Network/Deny/Data",
      "data_name": "bytes_received",
      "field": "bytes_received"
     }
    ]
   },
   {
    "name": "admin_logon",
    "when": [
     {
      "field": "event_type",
      "equals": "ADMIN"
     },
     {
      "field": "action",
      "equals": "LOGIN_SUCCESS"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "username"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "action",
      "map": {
       "LOGIN_SUCCESS": "true"
      }
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "data_name": "severity",
      "field": "severity"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "data_name": "protocol",
      "field": "protocol"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "data_name": "rule_id",
      "field": "rule_id"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "data_name": "bytes_sent",
      "field": "bytes_sent"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "data_name": "bytes_received",
      "field": "bytes_received"
     }
    ]
   },
   {
    "name": "system_alert",
    "when": [
     {
      "field": "event_type",
      "equals": "SYSTEM"
     },
     {
      "field": "action",
      "equals": "HIGH_CPU"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Alert/Type",
      "field": "action",
      "map": {
       "HIGH_CPU": "Other"
      }
     },
     {
      "path": "EventDetail/Alert/Severity",
      "field": "severity",
      "map": {
       "WARNING": "Minor",
       "DEBUG": "Info",
       "INFO": "Info",
       "NOTICE": "Info",
       "WARN": "Minor",
       "ERROR": "Major",
       "ERR": "Major",
       "CRITICAL": "Critical",
       "CRIT": "Critical",
       "ALERT": "Critical",
       "EMERGENCY": "Critical",
       "FATAL": "Critical"
      }
     },
     {
      "path": "EventDetail/Alert/Data",
      "data_name": "protocol",
      "field": "protocol"
     },
     {
      "path": "EventDetail/Alert/Data",
      "data_name": "rule_id",
      "field": "rule_id"
     },
     {
      "path": "EventDetail/Alert/Data",
      "data_name": "bytes_sent",
      "field": "bytes_sent"
     },
     {
      "path": "EventDetail/Alert/Data",
      "data_name": "bytes_received",
      "field": "bytes_received"
     }
    ]
   },
   {
    "name": "other",
    "fields": [
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "severity",
      "field": "severity"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "protocol",
      "field": "protocol"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "action",
      "field": "action"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "rule_id",
      "field": "rule_id"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "bytes_sent",
      "field": "bytes_sent"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "data_name": "bytes_received",
      "field": "bytes_received"
     }
    ]
   }
  ]
 },
