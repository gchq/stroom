{
 "source": "multi-repeated-data-elements-and-repeat-rules",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "json",
  "for_each": "events",
  "drop_when": [
   {
    "when": [
     {
      "field": "host",
      "matches": "^qa-",
      "scope": "record"
     }
    ],
    "reason": "QA traffic"
   },
   {
    "when": [
     {
      "field": "action",
      "equals": "HEARTBEAT"
     }
    ],
    "reason": "heartbeats are not events"
   }
  ],
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "ts"
   },
   {
    "path": "EventSource/System/Name",
    "value": "App"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "value": "audit"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "host",
    "scope": "record"
   },
   {
    "path": "EventSource/User/Id",
    "field": "user"
   },
   {
    "path": "EventSource/User/Groups/Group/Name",
    "field": "roles",
    "repeat": true
   }
  ],
  "events": [
   {
    "name": "any",
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "x"
     },
     {
      "path": "EventDetail/Unknown/Data",
      "field": "roles",
      "transform": "upper",
      "repeat": true,
      "data_name": "role"
     }
    ]
   }
  ],
  "unmatched": "skip"
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[any] EventTime/TimeCreated: TimeCreated is a date-time; give time_format (from profile_sample) unless the input is already yyyy-MM-ddTHH:mm:ss.SSSZ",
   "[any] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "drop: QA traffic",
    "when": [
     "exists($record/*[@key='host'][matches(., '^qa-')])"
    ],
    "dropped": true
   },
   {
    "event": "drop: heartbeats are not events",
    "when": [
     "*[@key='action'] = 'HEARTBEAT'"
    ],
    "dropped": true
   },
   {
    "event": "any",
    "when": "every record",
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/Unknown/Data[role]",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Groups/Group/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": [],
  "items": "events"
 }
}
