{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "extract": [
   {
    "field": "eventtime",
    "regex": "^(\\d{13})",
    "names": [
     "eventtime_ms"
    ]
   }
  ],
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "eventtime_ms",
    "time_format": "epoch_ms"
   },
   {
    "path": "EventSource/System/Name",
    "value": "VPN Portal"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "value": "fortigate"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "devname"
   },
   {
    "path": "EventSource/User/Id",
    "field": "user"
   },
   {
    "path": "EventSource/Client/IPAddress",
    "field": "remip"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "logid"
   },
   {
    "path": "EventDetail/Description",
    "field": "msg"
   }
  ],
  "events": [
   {
    "name": "signed in",
    "when": [
     {
      "field": "action",
      "equals": "tunnel-up"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     }
    ]
   },
   {
    "name": "failed sign in",
    "when": [
     {
      "field": "action",
      "equals": "ssl-login-fail"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "value": "false"
     }
    ]
   },
   {
    "name": "signed out",
    "when": [
     {
      "field": "action",
      "equals": "tunnel-down"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[signed in] TypeId is read from logid, which its records may lack: those get TypeId 'signed in', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[signed in] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[failed sign in] TypeId is read from logid, which its records may lack: those get TypeId 'failed sign in', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[failed sign in] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[signed out] TypeId is read from logid, which its records may lack: those get TypeId 'signed out', as the schema requires one (without it the event fails validation). Give TypeId a default to choose another.",
   "[signed out] required ['EventTime', 'EventSource/Device'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "signed in",
    "when": [
     "data[@name='action']/@value = 'tunnel-up'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "failed sign in",
    "when": [
     "data[@name='action']/@value = 'ssl-login-fail'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "signed out",
    "when": [
     "data[@name='action']/@value = 'tunnel-down'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/Description",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
