{
 "source": "xsltgen-extracted-fields-read-through-any-of-are-declared-in",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "extract": [
   {
    "field": "msg",
    "regex": " user=(?:\"([^\"]*)\"|(\\S+))",
    "names": [
     "user_quoted",
     "user_plain"
    ]
   }
  ],
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Acme VPN"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Dev"
   },
   {
    "path": "EventSource/Generator",
    "value": "vpnd"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "host",
    "default": "unknown"
   }
  ],
  "events": [
   {
    "name": "login",
    "when": [
     {
      "field": "action",
      "equals": "login"
     }
    ],
    "fields": [
     {
      "path": "EventSource/User/Id",
      "any_of": [
       "user_quoted",
       "user_plain"
      ]
     },
     {
      "path": "EventDetail/TypeId",
      "value": "login"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "any_of": [
       "user_quoted",
       "user_plain"
      ]
     }
    ]
   },
   {
    "name": "logout",
    "when": [
     {
      "field": "action",
      "equals": "logout"
     }
    ],
    "fields": [
     {
      "path": "EventSource/User/Id",
      "any_of": [
       "user_quoted",
       "user_plain"
      ]
     },
     {
      "path": "EventDetail/TypeId",
      "value": "logout"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "any_of": [
       "user_quoted",
       "user_plain"
      ]
     }
    ]
   }
  ],
  "unmatched": "skip"
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[login] EventTime/TimeCreated: TimeCreated is a date-time; give time_format (from profile_sample) unless the input is already yyyy-MM-ddTHH:mm:ss.SSSZ",
   "[login] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[logout] EventTime/TimeCreated: TimeCreated is a date-time; give time_format (from profile_sample) unless the input is already yyyy-MM-ddTHH:mm:ss.SSSZ",
   "[logout] required ['EventTime'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "login",
    "when": [
     "data[@name='action']/@value = 'login'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "logout",
    "when": [
     "data[@name='action']/@value = 'logout'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
