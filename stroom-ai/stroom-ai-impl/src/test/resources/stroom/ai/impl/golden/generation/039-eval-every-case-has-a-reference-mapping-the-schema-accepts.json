{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "xml",
  "root": "events",
  "record": "event",
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "@time",
    "time_format": "yyyy-MM-dd HH:mm:ss",
    "timezone": "UTC"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Workstations"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "value": "session-agent"
   },
   {
    "path": "EventSource/Device/HostName",
    "field": "@host"
   },
   {
    "path": "EventSource/User/Id",
    "field": "@user"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "@action"
   },
   {
    "path": "EventDetail/Authenticate/User/Id",
    "field": "@user"
   }
  ],
  "events": [
   {
    "name": "lock",
    "when": [
     {
      "field": "@action",
      "equals": "lock"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "ScreenLock"
     }
    ]
   },
   {
    "name": "unlock",
    "when": [
     {
      "field": "@action",
      "equals": "unlock"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "ScreenUnlock"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[lock] required ['EventTime', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[unlock] required ['EventTime', 'EventSource/Device', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "lock",
    "when": [
     "@action = 'lock'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "unlock",
    "when": [
     "@action = 'unlock'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
