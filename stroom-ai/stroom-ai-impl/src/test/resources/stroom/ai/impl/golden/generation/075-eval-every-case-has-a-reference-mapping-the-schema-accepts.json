{
 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "json",
  "json_layout": "lines",
  "xml_fields": [
   "payload"
  ],
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time",
    "time_format": "yyyy-MM-dd'T'HH:mm:ssX"
   },
   {
    "path": "EventSource/System/Name",
    "value": "API Gateway"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "field": "service"
   },
   {
    "path": "EventSource/Device/HostName",
    "value": "apigw01"
   },
   {
    "path": "EventSource/User/Id",
    "field": "payload//User"
   },
   {
    "path": "EventSource/Client/IPAddress",
    "field": "client_ip"
   },
   {
    "path": "EventDetail/TypeId",
    "field": "operation"
   }
  ],
  "events": [
   {
    "name": "login",
    "when": [
     {
      "field": "operation",
      "equals": "Login"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "payload//User"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "field": "payload//Result",
      "map": {
       "success": "true",
       "failure": "false"
      }
     }
    ]
   },
   {
    "name": "read",
    "when": [
     {
      "field": "operation",
      "equals": "GetAccount"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/View/Object/Type",
      "value": "Account"
     },
     {
      "path": "EventDetail/View/Object/Id",
      "field": "payload//Account/@id"
     },
     {
      "path": "EventDetail/View/Outcome/Success",
      "field": "payload//Result",
      "map": {
       "success": "true",
       "failure": "false"
      }
     }
    ]
   },
   {
    "name": "update",
    "when": [
     {
      "field": "operation",
      "equals": "UpdateAccount"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/Update/After/Object/Type",
      "value": "Account"
     },
     {
      "path": "EventDetail/Update/After/Object/Id",
      "field": "payload//Account/@id"
     },
     {
      "path": "EventDetail/Update/Outcome/Success",
      "field": "payload//Result",
      "map": {
       "success": "true",
       "failure": "false"
      }
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[login] required ['EventTime', 'EventSource/Generator', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[read] required ['EventTime', 'EventSource/Generator', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[update] required ['EventTime', 'EventSource/Generator', 'EventDetail/TypeId'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "login",
    "when": [
     "*[@key='operation'] = 'Login'"
    ],
    "fields": [
     "EventDetail/Authenticate/Action",
     "EventDetail/Authenticate/Outcome/Success",
     "EventDetail/Authenticate/User/Id",
     "EventDetail/TypeId",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "read",
    "when": [
     "*[@key='operation'] = 'GetAccount'"
    ],
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/View/Object/Id",
     "EventDetail/View/Object/Type",
     "EventDetail/View/Outcome/Success",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   },
   {
    "event": "update",
    "when": [
     "*[@key='operation'] = 'UpdateAccount'"
    ],
    "fields": [
     "EventDetail/TypeId",
     "EventDetail/Update/After/Object/Id",
     "EventDetail/Update/After/Object/Type",
     "EventDetail/Update/Outcome/Success",
     "EventSource/Client/IPAddress",
     "EventSource/Device/HostName",
     "EventSource/Generator",
     "EventSource/System/Environment",
     "EventSource/System/Name",
     "EventSource/User/Id",
     "EventTime/TimeCreated"
    ]
   }
  ],
  "reference_maps": [],
  "dictionaries": []
 }
}
