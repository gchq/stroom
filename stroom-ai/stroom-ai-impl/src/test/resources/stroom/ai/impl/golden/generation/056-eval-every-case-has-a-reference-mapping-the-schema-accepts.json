 "source": "eval-every-case-has-a-reference-mapping-the-schema-accepts",
 "schema": "4.1.0",
 "version": "4.1.0",
 "mark_rules": false,
 "mapping": {
  "input": "data_splitter",
  "extract": [
   {
    "field": "message",
    "regex": "^User '([^']+)' logged (in|out)",
    "names": [
     "user_ok",
     "direction"
    ]
   },
   {
    "field": "message",
    "regex": "^Login failed for user '([^']+)'",
    "names": [
     "user_failed"
    ]
   },
   {
    "field": "message",
    "regex": " from (\\S+)",
    "names": [
     "client"
    ]
   },
   {
    "field": "message",
    "regex": " session (\\S+)$",
    "names": [
     "session"
    ]
   },
   {
    "field": "message",
    "regex": " reason: (.+)$",
    "names": [
     "reason"
    ]
   }
  ],
  "common": [
   {
    "path": "EventTime/TimeCreated",
    "field": "time",
    "time_format": "yyyy-MM-dd HH:mm:ss,SSS",
    "timezone": "UTC"
   },
   {
    "path": "EventSource/System/Name",
    "value": "Auth Service"
   },
   {
    "path": "EventSource/System/Environment",
    "value": "Eval"
   },
   {
    "path": "EventSource/Generator",
    "field": "component"
   },
   {
    "path": "EventSource/Device/HostName",
    "value": "auth01.example.org"
   },
   {
    "path": "EventSource/User/Id",
    "any_of": [
     "user_ok",
     "user_failed"
    ]
   },
   {
    "path": "EventSource/Client/IPAddress",
    "field": "client"
   },
   {
    "path": "EventDetail/Description",
    "field": "message"
   }
  ],
  "events": [
   {
    "name": "logged in",
    "when": [
     {
      "field": "direction",
      "equals": "in"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "login"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user_ok"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "field": "session",
      "data_name": "session"
     }
    ]
   },
   {
    "name": "failed login",
    "when": [
     {
      "field": "user_failed",
      "present": true
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "login-failed"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logon"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user_failed"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Success",
      "value": "false"
     },
     {
      "path": "EventDetail/Authenticate/Outcome/Description",
      "field": "reason"
     }
    ]
   },
   {
    "name": "logged out",
    "when": [
     {
      "field": "direction",
      "equals": "out"
     }
    ],
    "fields": [
     {
      "path": "EventDetail/TypeId",
      "value": "logout"
     },
     {
      "path": "EventDetail/Authenticate/Action",
      "value": "Logoff"
     },
     {
      "path": "EventDetail/Authenticate/User/Id",
      "field": "user_ok"
     },
     {
      "path": "EventDetail/Authenticate/Data",
      "field": "session",
      "data_name": "session"
     }
    ]
   }
  ]
 },
 "result": {
  "ok": true,
  "problems": [],
  "warnings": [
   "[logged in] required ['EventTime', 'EventSource/Generator'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[failed login] required ['EventTime', 'EventSource/Generator'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default.",
   "[logged out] required ['EventTime', 'EventSource/Generator'] are left out when their input fields are empty, which makes the event invalid. Fine if those fields are always filled; otherwise give the mapping a default."
  ],
  "events": [
   {
    "event": "logged in",
    "when": [
     "direction = 'in'"
    ],
    "fields": [
