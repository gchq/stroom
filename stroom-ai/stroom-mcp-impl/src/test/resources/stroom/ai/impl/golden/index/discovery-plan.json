{
 "backend": "elasticsearch",
 "index_name": "raw-v1",
 "time_field": "@timestamp",
 "fields": [
  {
   "name": "StreamId",
   "type": "id",
   "source": "stroom:stream-id()",
   "description": "",
   "multiple": false
  },
  {
   "name": "EventId",
   "type": "id",
   "source": "stroom:record-no()",
   "description": "",
   "multiple": false
  },
  {
   "name": "@timestamp",
   "type": "date",
   "source": "ts",
   "description": "",
   "multiple": false
  }
 ],
 "drop_when": [],
 "discovery": {
  "input": "json",
  "timestamp_field": "ts",
  "timestamp_chosen_by_user": false,
  "timestamp_format": "yyyy",
  "meta": {
   "feed": "Feed"
  },
  "drop": [
   "junk",
   "more"
  ],
  "unpack_json": true,
  "ignore_above": 1024,
  "total_fields_limit": 2000
 },
 "imports": [],
 "shared": [],
 "subobjects": true,
 "custom_namespaces": [],
 "style": {
  "naming": "snake_case",
  "variable_min_reads": 3,
  "inline_map_max_keys": 3,
  "function_min_uses": 2,
  "data_values": "interpolated",
  "data_entries": "function",
  "data_run_min": 4,
  "variables": "just_in_time",
  "data_names": "as_given",
  "layout": "modes"
 }
}
