<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <g:SimplePanel addStyleNames="max">
        <split:SplitPane vertical="true" thin="true" sizes="50%, *"
                         names="Processors, Settings" addStyleNames="max">
            <g:SimplePanel ui:field="processorList"
                           addStyleNames="max dashboard-panel"/>
            <split:SplitPane thin="true" sizes="600px, *"
                             names="Info, Details" addStyleNames="max">
                <g:MaxScrollPanel addStyleNames="max dashboard-panel">
                    <g:SimplePanel ui:field="info"/>
                </g:MaxScrollPanel>
                <g:MaxScrollPanel addStyleNames="max dashboard-panel">
                    <g:SimplePanel ui:field="details"/>
                </g:MaxScrollPanel>
            </split:SplitPane>
        </split:SplitPane>
    </g:SimplePanel>
</ui:UiBinder>

