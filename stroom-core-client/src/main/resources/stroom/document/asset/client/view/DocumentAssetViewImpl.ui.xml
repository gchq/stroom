<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <g:FlowPanel ui:field="rootPanel" styleName="max form-padding form visualisation-assets">
        <!-- The files beside the selected one's editor, both added by the view -->
        <split:SplitPane ui:field="splitPane" thin="true" sizes="200px, *" names="Files, Editor"
                         addStyleNames="max"/>
    </g:FlowPanel>
</ui:UiBinder>
