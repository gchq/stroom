<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:b="urn:import:stroom.widget.button.client">

    <g:FlowPanel styleName="max dock-container-vertical">
        <g:FlowPanel styleName="dock-min dock-container-horizontal align-center form-padding input-row">
            <g:Label text="Query:" styleName="dock-min"/>
            <form:TextBox ui:field="query" addStyleNames="dock-max"/>
            <!-- Reset, Run, Stop and Create Dashboard, added by the view -->
            <b:Toolbar ui:field="toolbar" name="Query actions" addStyleNames="dock-min"/>
        </g:FlowPanel>
        <g:ScrollPanel ui:field="errorContainer" styleName="queryDataView-errorContainer" visible="false">
            <g:Label ui:field="errorLabel" styleName="queryDataView-errorLabel"/>
        </g:ScrollPanel>
        <g:SimplePanel ui:field="tableContainer" styleName="max dock-max"/>
    </g:FlowPanel>
</ui:UiBinder>
