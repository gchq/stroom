<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <split:SplitPane vertical="true" thin="true" sizes="600px, *"
                     names="Query, Results" addStyleNames="QueryEditViewImpl max">
        <split:SplitPane thin="true" sizes="300px, *"
                         names="Help, Query" addStyleNames="max">
            <g:SimplePanel ui:field="queryHelpContainer" styleName="max"/>
            <g:SimplePanel ui:field="queryEditorContainer" styleName="max"/>
        </split:SplitPane>
        <g:SimplePanel ui:field="resultContainer"
                       styleName="max"/>
    </split:SplitPane>
</ui:UiBinder>
