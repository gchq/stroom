<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <g:SimplePanel styleName="max stroom-control resultStoreViewImpl">
        <split:SplitPane vertical="true" thin="true" sizes="200px, *"
                         names="Result stores, Info" addStyleNames="max">
            <g:SimplePanel ui:field="tableContainer"
                           styleName="max dashboard-panel overflow-hidden"/>
            <split:ScrollPane ui:field="infoScroll" addStyleNames="max dashboard-panel scroll-region">
                <g:SimplePanel ui:field="infoPanel"/>
            </split:ScrollPane>
        </split:SplitPane>
    </g:SimplePanel>
</ui:UiBinder>
