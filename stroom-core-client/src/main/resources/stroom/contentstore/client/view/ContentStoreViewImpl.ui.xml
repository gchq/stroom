<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
>
    <g:SimplePanel styleName="max">

        <split:SplitPane vertical="true" thin="true" sizes="400px, *"
                         names="Content packs, Content pack details" addStyleNames="max">
            <g:SimplePanel ui:field="contentPackList" styleName="max dashboard-panel"/>
            <g:SimplePanel ui:field="contentPackDetails" styleName="max dashboard-panel contentstore-scroll-y"/>
        </split:SplitPane>
    </g:SimplePanel>
</ui:UiBinder>
