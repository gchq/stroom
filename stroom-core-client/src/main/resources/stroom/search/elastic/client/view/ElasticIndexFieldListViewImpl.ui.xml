<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:tab="urn:import:stroom.widget.tab.client.view"
             xmlns:view="urn:import:stroom.widget.dropdowntree.client.view">
    <ui:style>
        .filters {
            display: flex;
            flex-direction: row;
            align-items: flex-end;
            gap: 8px;
        }

        .nameFilter {
            flex-grow: 1;
            min-width: 150px;
        }

        .typeFilter {
            width: 250px;
            flex-shrink: 0;
        }

        .noSelection {
            padding: 10px;
        }
    </ui:style>

    <g:ThinSplitLayoutPanel styleName="max">
        <g:north size="350">
            <g:FlowPanel styleName="max dock-container-vertical">
                <!-- Both filters narrow the same list, so they sit side by side above it -->
                <g:FlowPanel styleName="dock-min form-padding {style.filters}">
                    <form:FormGroup identity="elasticIndexFieldsNameFilter" label="Name"
                                    addStyleNames="{style.nameFilter}">
                        <view:QuickFilter ui:field="nameFilter"/>
                    </form:FormGroup>
                    <form:FormGroup identity="elasticIndexFieldsTypeFilter" label="Field types"
                                    helpText="Show only fields of the ticked types. Tick none to show all types."
                                    addStyleNames="{style.typeFilter}">
                        <l:MultiSelectionBox ui:field="typeFilter" addStyleNames="w-100"/>
                    </form:FormGroup>
                </g:FlowPanel>
                <g:SimplePanel ui:field="dataGrid" styleName="dock-max"/>
                <g:Label ui:field="statusMessage" styleName="dock-min elasticFieldListView-statusMessage"/>
            </g:FlowPanel>
        </g:north>
        <g:center>
            <g:ResizeFlowPanel styleName="max">
                <g:ResizeFlowPanel ui:field="detailsTabs" styleName="max dock-container-vertical">
                    <g:FlowPanel styleName="dock-min linkTabPanelViewImpl">
                        <tab:LinkTabBar ui:field="tabBar" styleName="linkTabPanelViewImpl-middle linkTabBar"/>
                    </g:FlowPanel>
                    <g:SimplePanel ui:field="infoPanel" styleName="dock-max"/>
                    <g:SimplePanel ui:field="settingsPanel" styleName="dock-max"/>
                </g:ResizeFlowPanel>
                <g:Label ui:field="noSelection" addStyleNames="{style.noSelection}"
                         text="Select a field to see how it is mapped and change its settings."/>
            </g:ResizeFlowPanel>
        </g:center>
    </g:ThinSplitLayoutPanel>
</ui:UiBinder>
