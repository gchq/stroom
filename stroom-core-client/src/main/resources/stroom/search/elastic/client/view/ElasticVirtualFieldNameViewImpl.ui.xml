<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max form">
        <form:FormGroup identity="elasticVirtualFieldName" label="Name" addStyleNames="dock-min">
            <g:FlowPanel>
                <g:TextBox ui:field="name" addStyleNames="w-100"/>
                <g:Label ui:field="nameError" styleName="invalid-feedback" visible="false"/>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
