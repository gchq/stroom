<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="elasticClusterSettingsConnectionURLs" label="Connection URLs">
            <g:TextArea ui:field="connectionUrls" width="400px"/>
        </form:FormGroup>
        <form:FormGroup identity="elasticClusterSettingsAPIKey"
                        label="API Key (optional)"
                        helpText="Select the Access Token credential holding the Elasticsearch API key, if the cluster requires authentication. The access token must be the base64 encoded API key, i.e. the 'encoded' value returned by Elasticsearch when the key is created.">
            <l:SelectionBox ui:field="apiKey"/>
        </form:FormGroup>
        <b:Button ui:field="setHttpClientConfig" text="Set Http Client Config" width="200px"
                  addStyleNames="allow-focus"/>
        <b:Button ui:field="testConnection" text="Test Connection" width="200px" addStyleNames="allow-focus"/>
    </g:FlowPanel>
</ui:UiBinder>
