<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client">
    <!-- The name row keeps its height and the query editor takes the rest of the dialog body -->
    <g:FlowPanel styleName="max form dock-container-vertical">
        <form:FormGroup identity="elasticVirtualFieldGroupName" label="Name" addStyleNames="dock-min"
                        helpText="The value users search the virtual field for to run the group's query.">
            <g:FlowPanel>
                <g:TextBox ui:field="name" addStyleNames="w-100"/>
                <g:Label ui:field="nameError" styleName="invalid-feedback" visible="false"/>
            </g:FlowPanel>
        </form:FormGroup>
        <form:FormGroup identity="elasticVirtualFieldGroupQuery" label="Query" addStyleNames="dock-max"
                        helpText="The query run when users search the virtual field for the group. Terms may
                                  use the index's keyword fields.">
            <g:SimplePanel ui:field="expression" styleName="dock-max stroom-control"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
