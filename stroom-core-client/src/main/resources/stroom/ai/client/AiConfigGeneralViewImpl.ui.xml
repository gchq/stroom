<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client.view">
    <g:FlowPanel styleName="max default-min-sizes dock-container-vertical">
        <form:FormGroup identity="model"
                        label="Model">
            <g:SimplePanel ui:field="modelRef"/>
        </form:FormGroup>
        <form:FormGroup identity="dockTypeSelectionBox" label="Dock Type">
            <l:SelectionBox ui:field="dockTypeSelectionBox"/>
        </form:FormGroup>
        <form:FormGroup identity="dockLocationSelectionBox" label="Dock Location">
            <l:SelectionBox ui:field="dockLocationSelectionBox"/>
        </form:FormGroup>
        <form:FormGroup identity="chatSystemPrompt" label="Chat System Prompt">
            <g:TextArea ui:field="chatSystemPrompt" width="100%" visibleLines="5"/>
        </form:FormGroup>
        <form:FormGroup identity="historySummaryPrompt" label="History Summary Prompt">
            <g:TextArea ui:field="historySummaryPrompt" width="100%" visibleLines="3"/>
        </form:FormGroup>
        <form:FormGroup identity="showToolCalls"
                        helpText="Show the tools the agent calls, with their arguments and results, in each turn's activity. Turning this off only hides them: the agent still uses its tools.">
            <tickbox:CustomCheckBox ui:field="showToolCalls" label="Show tool calls"/>
        </form:FormGroup>
        <form:FormGroup identity="showReasoning"
                        helpText="Show the model's reasoning in each turn's activity, when the model gives any and its settings allow it to be shown.">
            <tickbox:CustomCheckBox ui:field="showReasoning" label="Show reasoning"/>
        </form:FormGroup>
        <form:FormGroup identity="enableDebugDetail"
                        helpText="Keep the full exchange with the model (the messages sent and the response received) with each answer, and show it as a 'Request detail' entry in the turn's activity. Useful for working out why the agent did something.">
            <tickbox:CustomCheckBox ui:field="enableDebugDetail" label="Show request detail"/>
        </form:FormGroup>
        <form:FormGroup identity="browserNotifications"
                        helpText="Show a browser notification when a chat finishes, or needs you to answer something, while you're in another browser tab.">
            <tickbox:CustomCheckBox ui:field="browserNotifications" label="Enable browser notifications"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
