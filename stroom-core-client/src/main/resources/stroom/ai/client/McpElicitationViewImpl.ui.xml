<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client">
    <g:FlowPanel styleName="max dock-container-vertical form aiElicitation">
        <g:Label ui:field="message" styleName="dock-min aiElicitation-message"/>
        <g:Label ui:field="warning" styleName="dock-min aiMemory-intro"/>
        <g:SimplePanel ui:field="form" styleName="dock-max aiElicitation-form"/>
        <g:FlowPanel styleName="button-group dock-min">
            <b:Button ui:field="decline" text="Decline" addStyleNames="allow-focus"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
