<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:p="urn:import:stroom.widget.button.client"
             xmlns:l="urn:import:stroom.item.client">
    <g:FlowPanel ui:field="root" styleName="askStroomAiViewImpl max default-min-sizes dock-container-vertical empty">
        <g:FlowPanel styleName="dock-min askStroomAiViewImpl-top">
            <g:FlowPanel styleName="dock-max askStroomAiViewImpl-title">
                <g:Label ui:field="chatTitle" text="Agent"/>
            </g:FlowPanel>
            <g:FlowPanel styleName="dock-min askStroomAiViewImpl-buttons">
                <p:Button ui:field="newChat" text="New chat"
                          addStyleNames="allow-focus askStroomAiViewImpl-newChat"/>
                <p:InlineSvgButton ui:field="tabToggle" text="Open in a Tab"
                                   addStyleNames="allow-focus navigation-menu-button"/>
                <p:InlineSvgButton ui:field="menu" text="More"
                                   addStyleNames="allow-focus navigation-menu-button"/>
            </g:FlowPanel>
        </g:FlowPanel>
        <g:SimplePanel ui:field="markdownPreview" styleName="dock-max askStroomAiViewImpl-middle markdown-container"/>
        <g:FlowPanel ui:field="chatList" styleName="dock-max askStroomAiViewImpl-chatList" visible="false">
            <g:FlowPanel styleName="ai-chat-list-header">
                <g:TextBox ui:field="chatSearch" addStyleNames="allow-focus ai-chat-list-search"/>
                <g:HTML ui:field="chatListActions" styleName="ai-chat-list-actions"/>
            </g:FlowPanel>
            <g:HTML ui:field="chatListItems" styleName="ai-chat-list-items"/>
        </g:FlowPanel>
        <g:FlowPanel ui:field="jumpToLatestBar" styleName="dock-min askStroomAiViewImpl-jumpToLatestBar">
            <g:Button ui:field="jumpToLatest" styleName="allow-focus askStroomAiViewImpl-jumpToLatest"
                      title="Scroll to the latest message, and follow the chat"/>
        </g:FlowPanel>
        <g:FlowPanel styleName="dock-container-vertical dock-min askStroomAiViewImpl-bottom">
            <g:Label ui:field="emptyPrompt" styleName="askStroomAiViewImpl-emptyPrompt" text="How can I help?"/>
            <g:FlowPanel ui:field="taskList" styleName="dock-min askStroomAiViewImpl-taskList">
                <g:Button ui:field="taskListHeader" styleName="allow-focus askStroomAiViewImpl-taskList-header"/>
                <g:HTML ui:field="taskListItems" styleName="askStroomAiViewImpl-taskList-items"/>
            </g:FlowPanel>
            <g:FlowPanel ui:field="commandReference" styleName="dock-min askStroomAiViewImpl-commandReference">
                <g:SimplePanel ui:field="commandReferenceResize"
                               styleName="askStroomAiViewImpl-commandReference-resize"/>
                <p:InlineSvgButton ui:field="commandReferenceClose"
                                   addStyleNames="allow-focus askStroomAiViewImpl-commandReference-close"/>
                <g:HTML ui:field="commandReferenceContent"
                        styleName="markdown askStroomAiViewImpl-commandReference-content"/>
            </g:FlowPanel>
            <g:FlowPanel ui:field="followUps" styleName="dock-min askStroomAiViewImpl-followUps"/>
            <g:FlowPanel ui:field="inputBox"
                         styleName="dock-container-vertical dock-min askStroomAiViewImpl-bottom-inner">
                <g:FlowPanel ui:field="commandSuggestions" styleName="dock-min askStroomAiViewImpl-commands"/>
                <g:FlowPanel styleName="dock-container-horizontal dock-min askStroomAiViewImpl-messagePane">
                    <g:Label ui:field="contextIndicator"
                             styleName="askStroomAiViewImpl-contextChip"/>
                    <g:TextArea ui:field="message" addStyleNames="dock-max w-100"/>
                </g:FlowPanel>
                <g:FlowPanel styleName="dock-container-horizontal dock-min askStroomAiViewImpl-modelPane">
                    <l:SelectionBox ui:field="agentMode" addStyleNames="askStroomAiViewImpl-agentMode"/>
                    <p:InlineSvgButton ui:field="autoApprove" addStyleNames="allow-focus askStroomAiViewImpl-autoApprove"/>
                    <g:SimplePanel ui:field="modelRef" styleName="dock-max"/>
                    <g:Button ui:field="contextMeter" styleName="allow-focus askStroomAiViewImpl-contextMeter"/>
                    <g:HTML ui:field="contextDetails" styleName="askStroomAiViewImpl-contextDetails"/>
                    <p:InlineSvgButton ui:field="run" text="Run" addStyleNames="allow-focus play"/>
                </g:FlowPanel>
            </g:FlowPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
