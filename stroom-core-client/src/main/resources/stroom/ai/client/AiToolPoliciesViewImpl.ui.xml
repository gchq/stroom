<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:ThinSplitLayoutPanel styleName="max">
        <g:north size="400">
            <g:ThinSplitLayoutPanel styleName="max">
                <g:west size="500">
                    <g:FlowPanel styleName="max dashboard-panel dock-container-vertical">
                        <g:FlowPanel styleName="dock-min aiToolPolicies-heading">
                            <g:Label text="Policies" styleName="aiToolPolicies-headingText"/>
                        </g:FlowPanel>
                        <g:SimplePanel ui:field="listContainer" styleName="dock-max"/>
                    </g:FlowPanel>
                </g:west>
                <g:center>
                    <g:SimplePanel ui:field="categoriesContainer" styleName="max dashboard-panel"/>
                </g:center>
            </g:ThinSplitLayoutPanel>
        </g:north>
        <g:center>
            <g:ThinSplitLayoutPanel styleName="max">
                <g:north size="200">
                    <g:SimplePanel ui:field="membersContainer" styleName="max dashboard-panel"/>
                </g:north>
                <g:center>
                    <g:SimplePanel ui:field="effectiveContainer" styleName="max dashboard-panel"/>
                </g:center>
            </g:ThinSplitLayoutPanel>
        </g:center>
    </g:ThinSplitLayoutPanel>
</ui:UiBinder>
