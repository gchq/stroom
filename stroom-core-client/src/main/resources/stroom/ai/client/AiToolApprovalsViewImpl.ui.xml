<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client.view">
    <g:FlowPanel styleName="max dock-container-vertical form aiToolApprovals">
        <g:Label styleName="dock-min aiMemory-intro"
                 text="Tools you have allowed, or not, for the rest of this chat. Remove a decision to be asked again."/>
        <g:HTML ui:field="approvals" styleName="dock-max aiToolApprovals-list"/>
        <g:FlowPanel styleName="dock-min aiToolApprovals-everything">
            <tickbox:CustomCheckBox ui:field="approveEverything"
                                    label="Approve everything in this chat"/>
            <g:Label ui:field="approveEverythingNote" styleName="aiMemory-intro"/>
        </g:FlowPanel>
        <g:FlowPanel styleName="button-group dock-min">
            <b:Button ui:field="resetAll" text="Remove All" addStyleNames="allow-focus"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
