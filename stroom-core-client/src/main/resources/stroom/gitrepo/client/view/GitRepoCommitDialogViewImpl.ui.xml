<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="gitrepo-commit-message-dialog">
        <form:FormGroup identity="commitMessage"
                        label="Commit message"
                        helpText="Message recorded with the Git commit that this push creates. Required."
                        screenReaderText="Recorded with the Git commit this push creates."
                        required="true">
            <g:TextArea ui:field="txtCommitMessage"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>