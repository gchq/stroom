<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder" xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="userTaskView-layout">
        <g:FlowPanel styleName="userTaskView-details">
            <g:Label ui:field="taskName" addStyleNames="userTaskView-taskName"/>
            <g:Label ui:field="taskAge"/>
            <g:Label ui:field="taskStatus"/>
        </g:FlowPanel>
        <g:SimplePanel styleName="userTaskView-terminateCell">
            <g:Button ui:field="terminate" addStyleNames="userTaskView-terminate" title="Terminate" visible="false"/>
        </g:SimplePanel>
    </g:FlowPanel>
</ui:UiBinder>
