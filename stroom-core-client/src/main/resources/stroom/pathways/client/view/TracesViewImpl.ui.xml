<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:q="urn:import:stroom.query.client.view">
    <g:DockLayoutPanel addStyleNames="max" unit="PX">
        <g:north size="30">
            <g:FlowPanel styleName="TracesViewImpl-toolbar">
                <g:Label ui:field="label" addStyleNames="TracesViewImpl-label"/>
                <q:TimeRangeSelector ui:field="timeRangeSelector"/>
            </g:FlowPanel>
        </g:north>
        <g:center>
            <g:ThinSplitLayoutPanel addStyleNames="max default-min-sizes">
                <g:north size="400">
                    <g:SimplePanel ui:field="topWidget" addStyleNames="max"/>
                </g:north>
                <g:center>
                    <g:SimplePanel ui:field="bottomWidget" addStyleNames="max"/>
                </g:center>
            </g:ThinSplitLayoutPanel>
        </g:center>
    </g:DockLayoutPanel>
</ui:UiBinder>
