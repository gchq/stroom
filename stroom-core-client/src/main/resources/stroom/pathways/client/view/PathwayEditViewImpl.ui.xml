<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tab="urn:import:stroom.widget.tab.client.view">
    <g:FlowPanel styleName="max form form-padding dock-container-vertical">
        <g:FlowPanel styleName="pager dock-container-horizontal dock-min align-center">
            <g:FlowPanel ui:field="toolbarWidgets" addStyleNames="pager-toolbar"/>
        </g:FlowPanel>
        <g:MySplitLayoutPanel ui:field="mainSplit" styleName="dock-max">
            <g:south size="280">
                <g:FlowPanel ui:field="lowerPanel" styleName="max dock-container-vertical">
                    <tab:LinkTabBar ui:field="tabBar" styleName="dock-min linkTabBar pathway-tabs"/>
                    <tab:LayerContainerImpl ui:field="layerContainer"
                                            styleName="dock-max form-control-background form-control-border"/>
                </g:FlowPanel>
            </g:south>
            <g:center>
                <g:MySplitLayoutPanel ui:field="centreSplit" addStyleNames="pathway-headings">
                    <g:west size="400">
                        <form:FormGroup ui:field="treeGroup" identity="pathwayDetails" label="Pathway">
                            <g:SimplePanel ui:field="tree"
                                           styleName="max form-control-background form-control-border"/>
                        </form:FormGroup>
                    </g:west>
                    <g:center>
                        <g:FlowPanel styleName="max dock-container-vertical">
                            <tab:LinkTabBar ui:field="nodeTabBar"
                                            styleName="dock-min linkTabBar pathway-tabs"/>
                            <g:FlowPanel
                                    styleName="max dock-container-vertical form-control-background form-control-border">
                                <g:Label ui:field="nodePath" styleName="dock-min pathway-node-path"/>
                                <tab:LayerContainerImpl ui:field="nodeLayerContainer"
                                                        styleName="dock-max"/>
                            </g:FlowPanel>
                        </g:FlowPanel>
                    </g:center>
                </g:MySplitLayoutPanel>
            </g:center>
        </g:MySplitLayoutPanel>
    </g:FlowPanel>
</ui:UiBinder>
