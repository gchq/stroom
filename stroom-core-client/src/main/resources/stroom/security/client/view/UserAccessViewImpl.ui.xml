<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="max dock-container-vertical">
        <!-- Only shown behind an authenticating edge proxy (e.g. an AWS ALB), where the actions that end
             sessions are hidden because the proxy signs the user straight back in. -->
        <g:Label ui:field="edgeAuthenticationNote" styleName="dock-min form-padding" visible="false">
            Users here sign in through an authenticating load balancer or proxy, so ending their
            sessions would not sign them out. To stop a user's access, disable them (open the user
            from the toolbar) and disable or revoke them at the identity provider.
        </g:Label>
        <!-- Master/detail: users above, the selected user's individual sessions below, so a single session can be
             ended without a separate screen. Split rather than fixed heights because how much of each an
             administrator wants to see depends entirely on the situation - triaging one user's devices wants the
             lower pane, scanning for who is active wants the upper. -->
        <g:ThinSplitLayoutPanel styleName="dock-max default-min-sizes">
            <g:south size="250">
                <g:SimplePanel ui:field="sessionsContainer" styleName="max"/>
            </g:south>
            <g:center>
                <g:SimplePanel ui:field="listContainer" styleName="max"/>
            </g:center>
        </g:ThinSplitLayoutPanel>
    </g:FlowPanel>
</ui:UiBinder>
