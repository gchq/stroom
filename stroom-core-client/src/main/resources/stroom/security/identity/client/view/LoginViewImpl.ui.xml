<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:b="urn:import:stroom.widget.button.client">
    <g:FlowPanel ui:field="page" styleName="LoginView">
        <!-- The page's heading, for screen readers (the logo and form say it to sighted users) -->
        <g:HTML styleName="sr-only"><h1>Sign in to Stroom</h1></g:HTML>

        <g:FlowPanel styleName="LoginViewFormPanel">
            <g:FlowPanel styleName="max form-padding form LoginViewForm">

                <g:SimplePanel styleName="LoginViewUserImageContainer">
                    <g:SimplePanel ui:field="userImage" styleName="LoginViewUserImage"/>
                </g:SimplePanel>

                <!-- User Name -->
                <form:FormGroup identity="userName" label="User Name" required="true"
                                helpText="Enter your Stroom account user name. This is the name you were given when your account was created.">
                    <g:FlowPanel>
                        <!-- Add user name text box -->
                        <g:FlowPanel addStyleNames="userNameTextBoxOuter">
                            <form:TextBox ui:field="userName" addStyleNames="userNameTextBox"/>
                        </g:FlowPanel>

                        <!-- Add feedback -->
                        <g:Label ui:field="userNameFeedback" styleName="feedback"/>
                    </g:FlowPanel>
                </form:FormGroup>

                <!-- Password -->
                <form:FormGroup ui:field="passwordGroup" identity="password" label="Password" required="true">
                    <g:FlowPanel>
                        <!-- Add password text box -->
                        <form:PasswordBox ui:field="password"/>

                        <!-- Add feedback -->
                        <g:Label ui:field="passwordFeedback" styleName="feedback"/>
                    </g:FlowPanel>
                </form:FormGroup>


                <b:Button ui:field="signInButton" text="Sign In" addStyleNames="LoginViewSignInButton button--contained-primary allow-focus"/>

                <b:LinkButton ui:field="forgotPasswordLink" addStyleNames="LoginViewForgotPassword">Forgot password?</b:LinkButton>

            </g:FlowPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
