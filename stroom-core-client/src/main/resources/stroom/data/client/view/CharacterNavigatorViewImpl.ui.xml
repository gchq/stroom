<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:btn="urn:import:stroom.widget.button.client"
             xmlns:refresh-button="urn:import:stroom.data.pager.client">
    <g:FlowPanel styleName="characterNavigator">
        <g:FlowPanel styleName="characterNavigator-labels">
            <btn:LinkButton ui:field="lblLines" addStyleNames="characterNavigator-label"/>
            <btn:LinkButton ui:field="lblCharacters" addStyleNames="characterNavigator-label"/>
        </g:FlowPanel>
        <!--        <g:SimplePanel ui:field="progressBarPanel"-->
        <!--                       styleName="characterNavigator-progressBarPanel"/>-->
        <btn:Toolbar name="Character navigation">
            <btn:ToolbarButton ui:field="showHeadCharactersBtn" svg="FAST_BACKWARD" title="Show Beginning"/>
            <btn:ToolbarButton ui:field="advanceCharactersBackwardBtn" svg="STEP_BACKWARD"
                               title="Advance Range Backwards"/>
            <btn:ToolbarButton ui:field="advanceCharactersForwardBtn" svg="STEP_FORWARD"
                               title="Advance Range Forwards"/>
            <refresh-button:RefreshButton ui:field="refresh"/>
        </btn:Toolbar>
    </g:FlowPanel>
</ui:UiBinder>
