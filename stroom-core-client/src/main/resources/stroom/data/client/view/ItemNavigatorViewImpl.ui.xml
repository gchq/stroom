<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:btn="urn:import:stroom.widget.button.client"
             xmlns:refresh-button="urn:import:stroom.data.pager.client">
    <g:FlowPanel styleName="itemNavigator">
        <g:Label ui:field="lblDetail" styleName="itemNavigator-label"/>
        <btn:Toolbar name="Navigation">
            <btn:ToolbarButton ui:field="firstPageBtn" svg="FAST_BACKWARD" title="First"/>
            <btn:ToolbarButton ui:field="previousPageBtn" svg="STEP_BACKWARD" title="Backward"/>
            <btn:ToolbarButton ui:field="nextPageBtn" svg="STEP_FORWARD" title="Forward"/>
            <btn:ToolbarButton ui:field="lastPageBtn" svg="FAST_FORWARD" title="Last"/>
            <refresh-button:RefreshButton ui:field="refresh"/>
        </btn:Toolbar>
    </g:FlowPanel>
</ui:UiBinder>
