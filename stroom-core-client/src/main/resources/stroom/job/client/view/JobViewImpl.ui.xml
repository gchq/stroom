<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:SimplePanel styleName="max">
        <split:SplitPane vertical="true" thin="true" sizes="400px, *"
                         names="Jobs, Job nodes" addStyleNames="max">
            <g:SimplePanel ui:field="jobList" styleName="max dashboard-panel"/>
            <g:FlowPanel styleName="max dashboard-panel form">
                <form:FormGroup ui:field="jobNodeListFormGroup" addStyleNames="max">
                    <g:SimplePanel ui:field="jobNodeList" styleName="max dashboard-panel"/>
                </form:FormGroup>
            </g:FlowPanel>
        </split:SplitPane>
    </g:SimplePanel>
</ui:UiBinder>
