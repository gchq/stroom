<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:button="urn:import:stroom.widget.button.client">
    <g:FlowPanel styleName="max form">
        <form:FormGroup identity="accessKeyId"
                        label="Access Key ID"
                        helpText="The ID of an AWS access key, such as AKIAIOSFODNN7EXAMPLE.">
            <g:TextBox ui:field="accessKeyId" addStyleNames="wide-control"/>
        </form:FormGroup>
        <form:FormGroup identity="secretAccessKey"
                        label="Secret Access Key"
                        helpText="The secret access key that goes with the access key ID.">
            <g:FlowPanel>
                <g:FlowPanel addStyleNames="passwordTextBoxOuter wide-control">
                    <g:PasswordTextBox ui:field="secretAccessKey" addStyleNames="confirmPasswordTextBox"/>
                    <g:FlowPanel addStyleNames="confirmPasswordTextBoxOverlay">
                        <button:InlineSvgButton ui:field="showSecretAccessKey" addStyleNames="showPassword"/>
                    </g:FlowPanel>
                </g:FlowPanel>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
