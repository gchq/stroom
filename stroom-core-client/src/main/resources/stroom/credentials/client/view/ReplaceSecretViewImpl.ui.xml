<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:chk="urn:import:stroom.widget.tickbox.client.view"
             xmlns:datetimebox="urn:import:stroom.widget.datepicker.client">
    <g:FlowPanel styleName="credentials-details-dialog">
        <g:Label ui:field="warning"/>
        <form:FormGroup>
            <g:SimplePanel ui:field="secret"/>
        </form:FormGroup>
        <form:FormGroup identity="replaceCredsExpire"
                        helpText="Tick if the new secret has an expiry date, then set it in Expires."
                        screenReaderText="Enables the Expires field.">
            <chk:CustomCheckBox ui:field="credsExpire" identity="replaceCredsExpireChk" label="Secret expires"/>
        </form:FormGroup>
        <form:FormGroup identity="replaceExpires"
                        label="Expires"
                        ui:field="expiryTimeFormGroup"
                        helpText="The date and time the new secret expires. This is shown in the credentials list as a reminder; Stroom does not stop using it after this time."
                        screenReaderText="Reminder only; not enforced.">
            <datetimebox:DateTimeBox ui:field="expiryTime" addStyleNames="wide-control"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
