<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:view="urn:import:stroom.widget.dropdowntree.client.view">
    <g:FlowPanel styleName="max dock-container-vertical mcpToolList">
        <g:FlowPanel styleName="dock-min dock-container-horizontal mcpToolList-toolbar">
            <b:ButtonPanel ui:field="buttons" addStyleNames="dock-min"/>
            <view:QuickFilter ui:field="filter" addStyleNames="dock-min mcpToolList-filter"/>
            <g:Label ui:field="status" styleName="dock-max mcpToolList-status"/>
        </g:FlowPanel>
        <g:SimplePanel styleName="dock-max">
            <g:ThinSplitLayoutPanel styleName="max">
                <!-- About 20 tools, with the rest of the space for the selected tool's documentation. -->
                <g:north size="510">
                    <g:SimplePanel ui:field="grid" styleName="max"/>
                </g:north>
                <g:center>
                    <g:HTML ui:field="details" styleName="max markdown mcpToolList-details"/>
                </g:center>
            </g:ThinSplitLayoutPanel>
        </g:SimplePanel>
    </g:FlowPanel>
</ui:UiBinder>
