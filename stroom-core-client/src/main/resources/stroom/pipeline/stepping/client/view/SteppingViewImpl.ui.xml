<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tab="urn:import:stroom.widget.tab.client.view">
    <g:FlowPanel styleName="stepping-screen max dock-container-vertical">
        <g:FlowPanel styleName="dock-min dock-container-horizontal stepping-screen__top">
            <g:SimplePanel ui:field="treeContainer" styleName="stepping-screen__pipeline"/>
            <g:FlowPanel ui:field="right" styleName="dock-min stepping-screen__controls"/>
        </g:FlowPanel>
        <tab:LayerContainerImpl ui:field="layerContainer" styleName="dock-max stepping-screen__panes"/>
    </g:FlowPanel>
</ui:UiBinder>
