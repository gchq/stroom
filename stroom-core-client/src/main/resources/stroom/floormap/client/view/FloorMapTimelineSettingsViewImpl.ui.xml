<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:datetimebox="urn:import:stroom.widget.datepicker.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client.view">

    <g:FlowPanel addStyleNames="stroom-floormap-timeline-settings-popup">
        <!-- Loop playback toggle -->
        <g:FlowPanel addStyleNames="stroom-floormap-timeline-settings-row">
            <g:Label text="Loop Playback" addStyleNames="stroom-floormap-timeline-settings-label" />
            <tickbox:CustomCheckBox ui:field="loopCheckBox" identity="floorMapTimelineLoop" label="" />
        </g:FlowPanel>

        <!-- Date Range -->
        <g:FlowPanel addStyleNames="stroom-floormap-timeline-settings-row">
            <g:Label text="Start Date" addStyleNames="stroom-floormap-timeline-settings-label" />
            <datetimebox:DateTimeBox ui:field="startDateTimeBox" addStyleNames="stroom-floormap-timeline-settings-date-box" />
        </g:FlowPanel>
        <g:FlowPanel addStyleNames="stroom-floormap-timeline-settings-row">
            <g:Label text="End Date" addStyleNames="stroom-floormap-timeline-settings-label" />
            <datetimebox:DateTimeBox ui:field="endDateTimeBox" addStyleNames="stroom-floormap-timeline-settings-date-box" />
        </g:FlowPanel>

        <!-- Show All — sets date range to cover all data in the store -->
        <g:FlowPanel addStyleNames="stroom-floormap-timeline-settings-show-all-row">
            <g:Button ui:field="showAllButton" text="Show All" addStyleNames="stroom-button stroom-button-blue stroom-floormap-timeline-settings-show-all-button" />
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
