<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max dock-container-vertical form-padding form">
        <!-- Facts Store (SQL Temporal Store) Selection -->
        <form:FormGroup label="Facts Store">
            <g:SimplePanel ui:field="factsStoreContainer" />
        </form:FormGroup>
        <!-- Events Store (FloorMap Event Store) Selection -->
        <form:FormGroup label="Events Store">
            <g:SimplePanel ui:field="eventsStoreContainer" />
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
