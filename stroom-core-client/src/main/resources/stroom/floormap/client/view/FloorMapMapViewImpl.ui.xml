<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.widget.layout.client">
    <g:DockLayoutPanel unit='PX' styleName="max stroom-border-top" ui:field="mainDockPanel">
        <!-- Timeline strip: docked south at a fixed height with no splitter, so it is
             not user-resizable — matches TIMELINE_HEIGHT in FloorMapEditorViewImpl -->
        <g:south size="110">
            <g:SimplePanel ui:field="timelinePanel" addStyleNames="max" />
        </g:south>
        <!-- The SVG map with the right-hand dock docked east -->
        <g:center>
            <l:SplitPane ui:field="topSplitPane" thin="true" sizes="*, 25%" names="Map, Controls"
                         addStyleNames="max">
                <g:SimplePanel ui:field="mapPanel" addStyleNames="max"/>
                <g:SimplePanel ui:field="dockPanel"
                               addStyleNames="max dashboard-panel overflow-hidden"/>
            </l:SplitPane>
        </g:center>
    </g:DockLayoutPanel>
</ui:UiBinder>
