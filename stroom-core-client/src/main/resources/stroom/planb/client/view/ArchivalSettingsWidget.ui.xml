<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client.view"
             xmlns:valuespinner="urn:import:stroom.widget.valuespinner.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:i="urn:import:stroom.item.client">
    <g:FlowPanel styleName="form-group">
        <form:FormGroup
                label="Enable Archiving"
                helpText="Choose if data should be moved to archive shards after a period of time.">
            <tickbox:CustomCheckBox ui:field="archivalEnabled"
                                    identity="archivalEnabled"/>
        </form:FormGroup>
        <form:FormGroup ui:field="archivalLeadTimePanel"
                        identity="archivalLeadTimePanel"
                        label="Minimum Archive Age"
                        helpText="Data older than this period becomes eligible for archiving. Must be less than the retention duration.">
            <g:FlowPanel styleName="durationSetting">
                <valuespinner:ValueSpinner ui:field="archivalAge"/>
                <i:SelectionBox ui:field="archivalTimeUnit" addStyleNames="allow-focus"/>
            </g:FlowPanel>
        </form:FormGroup>
        <form:FormGroup identity="archivalGranularityPanel"
                        label="Granularity"
                        helpText="How archive shards are time-bucketed: Hour, Day, or Week.">
            <i:SelectionBox ui:field="archivalGranularity" addStyleNames="allow-focus"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
