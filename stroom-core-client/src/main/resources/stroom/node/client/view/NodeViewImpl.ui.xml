<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
        xmlns:ui="urn:ui:com.google.gwt.uibinder"
        xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
        xmlns:form="urn:import:stroom.widget.form.client">
    <g:SimplePanel styleName="max">
        <split:SplitPane vertical="true" thin="true" sizes="500px, *"
                         names="Nodes, Node jobs" addStyleNames="max">
            <g:SimplePanel ui:field="nodeList" styleName="max dashboard-panel"/>
            <g:FlowPanel styleName="max dashboard-panel form">
                <form:FormGroup ui:field="nodeJobListFormGroup" addStyleNames="max">
                    <g:SimplePanel ui:field="nodeJobList" styleName="max"/>
                </form:FormGroup>
            </g:FlowPanel>
        </split:SplitPane>
    </g:SimplePanel>
</ui:UiBinder>
