<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <g:FlowPanel styleName="max default-min-sizes dock-container-vertical columnFunctionEditorViewImpl">
        <split:SplitPane thin="true" sizes="300px, *"
                         names="Help, Expression" addStyleNames="dock-max columnFunctionEditorViewImpl-editorContainer form-control-border form-control-background">
            <g:SimplePanel ui:field="queryHelpContainer" styleName="max"/>
            <g:SimplePanel ui:field="editorContainer" styleName="dock-max"/>
        </split:SplitPane>
        <g:FlowPanel addStyleNames="dock-min dock-container-horizontal columnFunctionEditorViewImpl-labelPanel">
            <g:HTML styleName="columnFunctionEditorViewImpl-completionLabel">
                <code>ctrl-space</code>
                for auto-completion
            </g:HTML>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
