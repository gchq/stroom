<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.cell.list.client"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <split:SplitPane vertical="true" thin="true" sizes="*, 120px"
                     names="History, Selected query" addStyleNames="max default-min-sizes">
        <g:ScrollPanel ui:field="top" styleName="max stroom-control">
            <l:CustomCellList ui:field="cellList" styleName="queryHistoryViewImpl-cellList" />
        </g:ScrollPanel>
        <g:ScrollPanel ui:field="bottom" styleName="max stroom-control" />
    </split:SplitPane>
</ui:UiBinder>
