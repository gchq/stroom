<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client" xmlns:b="urn:import:stroom.widget.button.client">
    <split:SplitPane vertical="true" sizes="*, 120px"
                     names="Favourites, Selected query" addStyleNames="max default-min-sizes">
        <g:FlowPanel styleName="dock-container-vertical max stroom-control">
            <b:Toolbar ui:field="toolbar" name="Favourite query actions" addStyleNames="dock-min"/>
            <g:SimplePanel ui:field="list" styleName="dock-max"/>
        </g:FlowPanel>
        <g:ScrollPanel styleName="max stroom-control">
            <g:SimplePanel ui:field="bottom"/>
        </g:ScrollPanel>
    </split:SplitPane>
</ui:UiBinder>
