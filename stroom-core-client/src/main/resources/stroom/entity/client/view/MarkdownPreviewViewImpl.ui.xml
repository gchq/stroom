<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <split:SplitPane thin="true" sizes="800px, *"
                     names="Editor, Preview" addStyleNames="QueryHelpViewImpl max">
        <g:SimplePanel ui:field="editorContainer" styleName="max dashboard-panel"/>
        <g:FlowPanel styleName="QueryHelpViewImpl-details max dashboard-panel dock-container-vertical">
            <g:SimplePanel ui:field="previewContainer" styleName="max dashboard-panel"/>
        </g:FlowPanel>
    </split:SplitPane>
</ui:UiBinder>
