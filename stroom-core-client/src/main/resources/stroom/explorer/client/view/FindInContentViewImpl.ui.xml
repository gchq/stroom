<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.widget.layout.client"
             xmlns:p="urn:import:stroom.widget.button.client"
             xmlns:spinner="urn:import:stroom.widget.spinner.client">
    <g:FlowPanel styleName="find-panel find-panel--dialog max dock-container-vertical">
        <g:FlowPanel styleName="find-panel__top dock-container-horizontal dock-min">
            <form:TextArea ui:field="pattern" addStyleNames="dock-max allow-focus"/>
            <p:Toolbar ui:field="buttonContainer" name="Search options"
                       addStyleNames="dock-min find-buttons toolbar--control">
                <p:ToolbarToggleButton ui:field="toggleMatchCase" svg="CASE_SENSITIVE" title="Match case"/>
                <p:ToolbarToggleButton ui:field="toggleRegex" svg="REGEX" title="Regex"/>
            </p:Toolbar>
        </g:FlowPanel>
        <!-- What may be typed, and what is wrong with it, under the pattern -->
        <g:FlowPanel styleName="find-panel__guidance dock-min">
            <g:Label ui:field="patternFeedback" styleName="form-group__feedback"/>
            <g:Label ui:field="patternHint" styleName="form-group__description"/>
        </g:FlowPanel>
        <!-- The results above the text of the selected one (addStyleNames, as styleName would replace
             the split pane's own class) -->
        <l:SplitPane vertical="true" sizes="300px, *" names="Results, Text"
                     addStyleNames="find-panel__bottom dock-max overflow-hidden">
            <g:SimplePanel ui:field="resultContainer"
                           styleName="max form-control-border form-control-background"/>
            <g:FlowPanel ui:field="textContainer" styleName="max form-control-border form-control-background">
                <spinner:SpinnerLarge ui:field="spinner" addStyleNames="busy-spinner--centred" />
            </g:FlowPanel>
        </l:SplitPane>
    </g:FlowPanel>
</ui:UiBinder>
