<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The cluster's nodes, with a pager and their actions -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Node actions">
        <b:ToolbarToggleButton ui:field="autoRefreshButton" svg="AUTO_REFRESH" title="Auto Refresh" pressed="true"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Nodes"/>
    </dg:PagerPanel>
</ui:UiBinder>
