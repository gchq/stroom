<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A script's dependencies, with Add, Remove and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel toolbarName="Script actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="Add Script Dependency"/>
        <b:ToolbarButton ui:field="removeButton" svg="REMOVE" title="Remove Selected Script Dependency"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Script Dependencies"/>
    </dg:PagerPanel>
</ui:UiBinder>
