<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:s="urn:import:stroom.script.client.component">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="scriptSettingsDependencies"
                        label="Dependencies"
                        addStyleNames="default-min-sizes dock-max"
                        helpText="Other scripts that this script needs. They are loaded before this script, in the order listed.">
            <g:SimplePanel styleName="dock-max control-box control-box--padded">
                <s:ScriptDependencyList ui:field="dependencies"/>
            </g:SimplePanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
