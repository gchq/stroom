<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A job's nodes, under a heading, with a filter, auto refresh and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:form="urn:import:stroom.widget.form.client">
    <form:FormGroup ui:field="heading" addStyleNames="form-group--inset-label max">
        <dg:PagerPanel ui:field="pager" toolbarName="Job node actions">
            <b:ToolbarToggleButton ui:field="showEnabled" svg="FILTER" title="Show Only Enabled Jobs"/>
            <b:ToolbarToggleButton ui:field="autoRefresh" svg="AUTO_REFRESH" title="Auto Refresh"/>
            <dg:DataGrid ui:field="dataGrid" tableName="Job Nodes"/>
        </dg:PagerPanel>
    </form:FormGroup>
</ui:UiBinder>
