<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The user's activities, with a filter, to choose the current one -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:view="urn:import:stroom.widget.quickfilter.client">
    <g:FlowPanel styleName="max dock-container-vertical quick-filter-layout overflow-hidden focus-ring-room">
        <view:QuickFilter accessibleName="Filter activities" ui:field="nameFilter" addStyleNames="dock-min"/>
        <g:SimplePanel ui:field="list" styleName="dock-max stroom-control"/>
    </g:FlowPanel>
</ui:UiBinder>
