<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder" xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:stroom.data.client.component"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <!-- A processor filter's tasks: their summary above the tasks of the summary row selected -->
    <g:SimplePanel styleName="max">
        <split:SplitPane vertical="true" thin="true" sizes="200px, *"
                         names="Task summary, Tasks" addStyleNames="max">
            <g:SimplePanel styleName="max overflow-hidden">
                <d:ProcessorTaskSummaryList ui:field="summary"/>
            </g:SimplePanel>
            <g:SimplePanel styleName="max overflow-hidden">
                <d:ProcessorTasksList ui:field="tasks"/>
            </g:SimplePanel>
        </split:SplitPane>
    </g:SimplePanel>
</ui:UiBinder>
