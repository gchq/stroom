<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A processor filter's feed dependencies, bordered, with New, Edit, Remove and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel toolbarName="Feed dependency actions"
                   addStyleNames="control-box">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="New Feed Dependency"/>
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Feed Dependency" enabled="false"/>
        <b:ToolbarButton ui:field="removeButton" svg="REMOVE" title="Remove Selected Feed Dependency"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Feed Dependencies" multiLine="true"/>
    </dg:PagerPanel>
</ui:UiBinder>
