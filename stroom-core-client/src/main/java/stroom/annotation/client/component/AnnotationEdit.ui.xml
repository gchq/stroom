<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:annotation="urn:import:stroom.annotation.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <!-- An annotation's Annotation tab (stroom-annotation.css, annotation-edit.css) -->
    <g:FlowPanel styleName="annotationContainer">
        <g:FlowPanel styleName="annotationTop">
            <annotation:SettingBlock ui:field="titleBlock">
                <g:FlowPanel addStyleNames="annotationTitleContainer">
                    <!-- Named, as a placeholder is only a hint, and the title each is given (its
                         value, for when it is too long to show) would otherwise be read as its name -->
                    <form:TextBox ui:field="titleTextBox" placeholder="Title" ariaLabel="Title"
                               addStyleNames="annotationTitle annotationTitleTextBox annotationTextBox allow-focus"/>
                    <tx:Label ui:field="annotationId" styleName="annotationId"/>
                </g:FlowPanel>
            </annotation:SettingBlock>
            <annotation:SettingBlock ui:field="subjectBlock">
                <g:FlowPanel addStyleNames="annotationSubjectContainer">
                    <form:TextBox ui:field="subjectTextBox" placeholder="Subject" ariaLabel="Subject"
                               addStyleNames="annotationSubject annotationSubjectTextBox annotationTextBox allow-focus"/>
                </g:FlowPanel>
            </annotation:SettingBlock>
        </g:FlowPanel>
        <g:FlowPanel styleName="annotationBottom">
            <g:FlowPanel styleName="dock-max annotationLeft">
                <g:SimplePanel styleName="annotationHistory">
                    <!-- Shown once the history is fetched -->
                    <g:FlowPanel ui:field="historyContainer"
                                 styleName="max dock-container-vertical annotationHistoryContainer"
                                 visible="false">
                        <tx:Html ui:field="historyHtml" styleName="dock-max annotationHistoryOuter"/>
                        <b:Button ui:field="copyHistory" icon="COPY" text="Copy History"
                                  addStyleNames="dock-min allow-focus annotationHistoryCopyButton"/>
                    </g:FlowPanel>
                </g:SimplePanel>
                <form:FormGroup identity="annotationComment" label="Add a comment"
                                helpText="Text to add to the annotation's history. Select Comment to save it. Choose Comment adds the text of a standard comment to the end of this text."
                                screenReaderText="Saved to the history when you select Comment.">
                    <g:FlowPanel styleName="annotationCommentContainer">
                        <form:TextArea ui:field="comment" addStyleNames="annotationComment allow-focus"/>
                        <g:FlowPanel ui:field="buttons" styleName="annotationButtons">
                            <b:Button ui:field="commentButton" addStyleNames="allow-focus annotation-edit__button"
                                      text="Choose Comment"/>
                            <b:Button ui:field="create" icon="ADD"
                                      addStyleNames="allow-focus button--contained-primary annotation-edit__button"
                                      text="Create"/>
                        </g:FlowPanel>
                    </g:FlowPanel>
                </form:FormGroup>
            </g:FlowPanel>
            <g:FlowPanel styleName="dock-min dock-container-vertical annotationRight">
                <g:FlowPanel styleName="max form annotationSetting">
                    <annotation:SettingBlock ui:field="statusBlock" title="Change Status">
                        <form:FormGroup identity="annotationStatus" label="Status"
                                        helpText="The current status of the annotation. Select it to choose a different status.">
                            <g:FlowPanel addStyleNames="annotationSettingHeading clickable">
                                <tx:Label ui:field="status" styleName="annotationLabel"/>
                            </g:FlowPanel>
                        </form:FormGroup>
                    </annotation:SettingBlock>
                    <annotation:SettingBlock ui:field="assignedToBlock" title="Change Assigned To">
                        <form:FormGroup identity="annotationAssignedTo" label="Assigned To"
                                        helpText="The user the annotation is assigned to. Select it to choose a user, or select Assign Yourself.">
                            <g:FlowPanel addStyleNames="annotationSettingHeading clickable">
                                <tx:Label ui:field="assignedTo" styleName="annotationLabel"/>
                                <annotation:AssignYourselfLink ui:field="assignYourself"/>
                            </g:FlowPanel>
                        </form:FormGroup>
                    </annotation:SettingBlock>
                    <annotation:SettingBlock ui:field="annotationLabelBlock" title="Change Labels">
                        <form:FormGroup identity="annotationLabel" label="Labels"
                                        helpText="The labels attached to the annotation. Select them to add or remove labels.">
                            <g:FlowPanel addStyleNames="annotationSettingHeading clickable">
                                <tx:Html ui:field="labels" styleName="annotationLabel"/>
                            </g:FlowPanel>
                        </form:FormGroup>
                    </annotation:SettingBlock>
                    <annotation:SettingBlock ui:field="annotationCollectionBlock" title="Change Collections">
                        <form:FormGroup identity="annotationCollection" label="Collections"
                                        helpText="The collections this annotation belongs to. Select them to add or remove collections.">
                            <g:FlowPanel addStyleNames="annotationSettingHeading clickable">
                                <tx:Html ui:field="collections" styleName="annotationLabel"/>
                            </g:FlowPanel>
                        </form:FormGroup>
                    </annotation:SettingBlock>
                    <annotation:SettingBlock ui:field="annotationRetentionPeriodBlock" title="Change Retention Period">
                        <form:FormGroup identity="annotationRetentionPeriod" label="Retain For"
                                        helpText="How long the annotation is kept, measured from when it was created. Select it to change the period or keep it forever.">
                            <g:FlowPanel addStyleNames="annotationSettingHeading clickable">
                                <tx:Label ui:field="retentionPeriod" styleName="annotationLabel"/>
                            </g:FlowPanel>
                        </form:FormGroup>
                    </annotation:SettingBlock>
                    <g:SimplePanel styleName="annotationDelete">
                        <b:Button ui:field="delete" icon="DELETE" addStyleNames="allow-focus button--contained-secondary"
                                  text="Delete Annotation"/>
                    </g:SimplePanel>
                </g:FlowPanel>
            </g:FlowPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>

