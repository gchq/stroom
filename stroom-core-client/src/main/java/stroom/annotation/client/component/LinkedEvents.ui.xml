<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- An annotation's Linked Events tab: its events above the data of the one selected -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:d="urn:import:stroom.data.client.component"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <split:SplitPane vertical="true" thin="true" sizes="400px, *"
                     names="Linked events, Data" addStyleNames="max">
        <g:SimplePanel styleName="max">
            <dg:PagerPanel toolbarName="Linked event actions">
                <b:ToolbarButton ui:field="addButton" svg="ADD" title="Add Event Link" enabled="false"/>
                <b:ToolbarButton ui:field="removeButton" svg="DELETE" title="Remove Event Link" enabled="false"/>
                <dg:DataGrid ui:field="dataGrid" tableName="Linked Events"/>
            </dg:PagerPanel>
        </g:SimplePanel>
        <g:SimplePanel styleName="max">
            <d:DataViewer ui:field="data"/>
        </g:SimplePanel>
    </split:SplitPane>
</ui:UiBinder>
