<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The annotations found: a striped list of a page of them, with a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <!-- Add and Remove are for an annotation's links only, hidden until asked for -->
    <dg:PagerPanel ui:field="pager" toolbarName="Link actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="Add Annotation Link" enabled="false"
                         visible="false"/>
        <b:ToolbarButton ui:field="removeButton" svg="DELETE" title="Remove Annotation Link" enabled="false"
                         visible="false"/>
        <dg:DataGrid ui:field="resultList" pageSize="100" profile="LISTBOX" accessibleName="Annotations found"
                     striped="true"/>
    </dg:PagerPanel>
</ui:UiBinder>
