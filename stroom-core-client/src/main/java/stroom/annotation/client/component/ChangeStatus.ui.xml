             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:c="urn:import:stroom.annotation.client.component">
    <g:FlowPanel addStyleNames="annotation-setting">
        <c:AnnotationStatusSetting ui:field="status"
