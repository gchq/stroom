<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The annotation finders' content: the filter above the annotations found -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:ex="urn:import:stroom.explorer.client.component"
             xmlns:an="urn:import:stroom.annotation.client.component">
    <ex:FindPanel ui:field="findPanel">
        <ex:content>
            <an:FindAnnotationList ui:field="resultList"/>
        </ex:content>
    </ex:FindPanel>
</ui:UiBinder>
