<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A setting of an annotation: its ⋮ hint (or button), then the setting itself, added after it -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel ui:field="formGroupPanel" styleName="setting-block icon-colour__grey">
        <g:SimplePanel ui:field="icon" styleName="setting-block__icon icon-colour__grey icon-wrap"/>
    </g:FlowPanel>
</ui:UiBinder>
