<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.widget.quickfilter.client">
    <g:FlowPanel ui:field="panel" styleName="find-panel find-panel--dialog max dock-container-vertical">
        <g:FlowPanel styleName="find-panel__top dock-min">
            <v:QuickFilter ui:field="nameFilter" addStyleNames="dock-max"/>
        </g:FlowPanel>
        <!-- The list of what is found, which the template declaring the panel gives it -->
        <g:SimplePanel ui:field="bottomPanel" styleName="find-panel__bottom dock-max"/>
    </g:FlowPanel>
</ui:UiBinder>
