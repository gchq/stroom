<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  The explorer's tree (explorer-tree.css): the grid, with its tree profile set in Java, filling the
  panel, then the live region that tells screen reader users why an item's key did nothing.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <g:HTMLPanel styleName="max explorer-tree-panel">
        <dg:DataGrid ui:field="tree" addStyleNames="explorerTree"/>
        <div ui:field="liveRegion" class="sr-only" role="status" aria-live="polite"></div>
    </g:HTMLPanel>
</ui:UiBinder>
