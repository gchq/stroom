<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  The explorer's tree (explorer-tree.css): the grid, on its tree profile, filling the panel, then the
  live region that tells screen reader users why an item's key did nothing. The explorer's cells
  draw their own padding, and a long name scrolls the tree sideways
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <g:HTMLPanel styleName="max explorer-tree">
        <dg:DataGrid ui:field="tree" addStyleNames="explorer-tree__grid" profile="TREE" cellPadding="false"
                     fitWidth="true" hasContextMenu="false"/>
        <div ui:field="liveRegion" class="sr-only" role="status" aria-live="polite"></div>
    </g:HTMLPanel>
</ui:UiBinder>
