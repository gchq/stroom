<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A quick filter as an expression tree, below a message when its text couldn't be converted -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="max dock-container-vertical advanced-quick-filter">
        <g:Label ui:field="message" styleName="dock-min advanced-quick-filter__message" visible="false"/>
        <g:SimplePanel ui:field="expression" styleName="dock-max advanced-quick-filter__expression"/>
    </g:FlowPanel>
</ui:UiBinder>
