<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The chats found: a striped list of a page of them, bordered, with a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" addStyleNames="form-control-border form-control-background">
        <dg:DataGrid ui:field="resultList" pageSize="100" profile="LISTBOX" accessibleName="Chats"
                     striped="true"/>
    </dg:PagerPanel>
</ui:UiBinder>
