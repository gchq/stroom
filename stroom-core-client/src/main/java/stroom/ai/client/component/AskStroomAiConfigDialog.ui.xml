<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- Ask Stroom AI's settings: a tab bar above the tab showing, then the default buttons -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:tab="urn:import:stroom.widget.tab.client.view">
    <g:FlowPanel styleName="max dock-container-vertical form">
        <g:FlowPanel styleName="dock-min linkTabPanelViewImpl">
            <tab:LinkTabBar ui:field="tabBar" addStyleNames="linkTabPanelViewImpl-middle"/>
        </g:FlowPanel>
        <tab:LayerContainerImpl ui:field="layerContainer" styleName="dock-max"/>
        <g:FlowPanel styleName="button-group dock-min">
            <b:Button ui:field="restoreFromDefaults"
                      text="Restore From Defaults"
                      addStyleNames="allow-focus"/>
            <b:Button ui:field="setDefaults"
                      text="Set As Default"
                      addStyleNames="allow-focus"
                      visible="false"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
