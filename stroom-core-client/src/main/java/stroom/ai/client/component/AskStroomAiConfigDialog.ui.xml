<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- Ask Stroom AI's settings: a tab bar above the tab showing, then the default buttons -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:e="urn:import:stroom.entity.client.component">
    <g:FlowPanel styleName="ask-stroom-ai-config-dialog max dock-container-vertical form">
        <e:LinkTabPanel ui:field="tabs" addStyleNames="ask-stroom-ai-config-dialog__tabs dock-max overflow-hidden"/>
        <g:FlowPanel styleName="button-group dock-min">
            <b:Button ui:field="restoreFromDefaults"
                      text="Restore From Defaults"
                      addStyleNames="allow-focus"/>
            <b:Button ui:field="setDefaults"
                      text="Set As Default"
                      addStyleNames="allow-focus"
                      visible="false"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
