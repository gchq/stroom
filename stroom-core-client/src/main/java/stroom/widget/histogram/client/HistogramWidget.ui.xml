<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A histogram (histogram-widget.css): the canvas the bars are drawn on (made in Java, as a canvas may not be
  supported) and the tooltip over it that shows a bar's count.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="histogram-widget">
        <g:FlowPanel ui:field="wrapper" styleName="histogram-widget__wrapper">
            <g:Label ui:field="tooltip" addStyleNames="histogram-widget__tooltip"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
