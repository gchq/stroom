<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.widget.quickfilter.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:btn="urn:import:stroom.widget.button.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <!--
      A chooser (chooser.css): Select All and Select None, shown only when asked for, then a quick
      filter above a list of values, which its controller fills. A choice is made with a click,
      Enter or Space; moving through the list chooses nothing
    -->
    <g:FlowPanel styleName="chooser max default-min-sizes dock-container-vertical quick-filter-layout overflow-hidden">
        <g:FlowPanel ui:field="selectBar" styleName="chooser__bar" visible="false">
            <btn:LinkButton ui:field="selectAllLink" addStyleNames="chooser__link" text="Select All"/>
            <!-- Only drawn between the two buttons, not read out -->
            <tx:Html styleName="text-label"><span aria-hidden="true">-</span></tx:Html>
            <btn:LinkButton ui:field="selectNoneLink" addStyleNames="chooser__link" text="Select None"/>
        </g:FlowPanel>
        <g:FlowPanel styleName="chooser__filter">
            <v:QuickFilter ui:field="nameFilter" accessibleName="Filter choices"/>
        </g:FlowPanel>
        <g:FlowPanel styleName="chooser__values">
            <dg:DataGrid ui:field="list" profile="LISTBOX" fitContent="true" addStyleNames="w-100"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
