<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A credential's new secret, and whether and when it expires -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:chk="urn:import:stroom.widget.tickbox.client"
             xmlns:datetimebox="urn:import:stroom.widget.datepicker.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="credentials-details-dialog">
        <tx:Label ui:field="warning" addStyleNames="credentials-details-dialog__warning"/>
        <form:FormGroup>
            <g:SimplePanel ui:field="secret"/>
        </form:FormGroup>
        <form:FormGroup identity="replaceCredsExpire"
                        label="Secret expires"
                        helpText="Does the new secret expire?">
            <chk:TickBox ui:field="credsExpire" identity="replaceCredsExpireChk"/>
        </form:FormGroup>
        <form:FormGroup identity="replaceExpires"
                        label="Expires"
                        ui:field="expiryTimeFormGroup"
                        helpText="When does the new secret expire?">
            <datetimebox:DateTimeBox ui:field="expiryTime" addStyleNames="wide-control"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
