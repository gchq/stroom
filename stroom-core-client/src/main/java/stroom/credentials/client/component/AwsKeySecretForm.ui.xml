<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max form secret-form">
        <form:FormGroup identity="accessKeyId"
                        label="Access Key ID" required="true"
                        helpText="The ID of an AWS access key, e.g. AKIAIOSFODNN7EXAMPLE. Required.">
            <form:TextBox ui:field="accessKeyId" addStyleNames="secret-form__field"/>
        </form:FormGroup>
        <form:FormGroup identity="secretAccessKey"
                        label="Secret Access Key" required="true"
                        helpText="The secret access key that goes with the access key ID. Required.">
            <form:PasswordBox ui:field="secretAccessKey" addStyleNames="secret-form__field"
                              placeholder="Enter Secret Access Key"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
