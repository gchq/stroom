<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The credentials, with New, Delete, Edit, Replace Secret and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Credential actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="New Credential"/>
        <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete Selected Credential" enabled="false"/>
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Credential" enabled="false"/>
        <b:ToolbarButton ui:field="replaceSecretButton" svg="PASSWORD" title="Replace Selected Credential's Secret"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Credentials" multiLine="true" addStyleNames="w-100"/>
    </dg:PagerPanel>
</ui:UiBinder>
