<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The credentials to pick from, under an optional note on where to get them -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max credentials-manager-dialog">
        <tx:Html ui:field="lblHtml" visible="false"/>
        <g:SimplePanel styleName="max credentials-manager-dialog__list" ui:field="pnlCredentialsList"/>
    </g:FlowPanel>
</ui:UiBinder>
