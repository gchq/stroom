<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max form secret-form">
        <form:FormGroup identity="username"
                        label="User Name" required="true"
                        helpText="Enter a user name">
            <form:TextBox ui:field="username" addStyleNames="secret-form__field"/>
        </form:FormGroup>
        <form:FormGroup identity="password"
                        label="Password" required="true"
                        helpText="Enter a password">
            <g:FlowPanel>

                <!-- Add password text box -->
                <form:PasswordBox ui:field="password" addStyleNames="secret-form__field" placeholder="Enter Password"/>

            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
