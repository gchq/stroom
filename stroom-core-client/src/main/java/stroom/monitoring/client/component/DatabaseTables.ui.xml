<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- Stroom's database tables: a pager above their grid -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager">
        <dg:DataGrid ui:field="dataGrid" tableName="Database Tables" pageSize="1000"/>
    </dg:PagerPanel>
</ui:UiBinder>
