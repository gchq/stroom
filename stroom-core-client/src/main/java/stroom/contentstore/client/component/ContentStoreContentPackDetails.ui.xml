<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A content pack's details in the content store (contentstore-details.css) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="contentstore-details">
        <tx:Html ui:field="icon" addStyleNames="contentstore-details-icon"/>
        <g:FlowPanel styleName="contentstore-details-vertical">
            <tx:Label ui:field="name" addStyleNames="contentstore-details-heading"/>
            <tx:Html ui:field="details" wordWrap="true"
                    addStyleNames="contentstore-details-markdown control-box"/>
            <g:FlowPanel styleName="contentstore-details-list">
                <tx:Label addStyleNames="contentstore-details-name" text="Installed status:"/>
                <tx:Label ui:field="installedStatus"/>
                <tx:Label addStyleNames="contentstore-details-name" text="Licence:"/>
                <tx:Label ui:field="licence"/>
                <tx:Label addStyleNames="contentstore-details-name" text="Licence details:"/>
                <g:FlowPanel>
                    <tx:Link ui:field="licenceLink"/>
                    <tx:InlineLabel ui:field="licenceUrl" addStyleNames="contentstore-details-url"/>
                </g:FlowPanel>
                <tx:Label addStyleNames="contentstore-details-name" text="Installed location:"/>
                <tx:Label ui:field="installedLocation"/>
                <tx:Label addStyleNames="contentstore-details-name" text="Git URL:"/>
                <g:FlowPanel>
                    <tx:Link ui:field="gitLink"/>
                    <tx:InlineLabel ui:field="gitUrl" addStyleNames="contentstore-details-url"/>
                </g:FlowPanel>
                <tx:Label addStyleNames="contentstore-details-name" text="Git branch:"/>
                <tx:Label ui:field="gitBranch"/>
                <tx:Label addStyleNames="contentstore-details-name" text="Git path:"/>
                <tx:Label ui:field="gitPath"/>
                <tx:Label addStyleNames="contentstore-details-name" text="Git commit:"/>
                <tx:Label ui:field="gitCommit"/>
            </g:FlowPanel>
            <g:FlowPanel styleName="contentstore-buttons">
                <b:Button ui:field="install" text="Install"/>
                <b:Button ui:field="upgrade" text="Upgrade"/>
            </g:FlowPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
