<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A schedule box (ScheduleBox), the BEM block schedule-box (schedule-box.css): a text field for a
     schedule's expression with a clock that opens the "Change Schedule" dialog -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:svg="urn:import:stroom.svg.client">
    <svg:IconBox ui:field="iconBox" addStyleNames="schedule-box" icon="HISTORY" opensDialog="true">
        <svg:field>
            <form:TextInput ui:field="textBox" styleName="schedule-box__input stroom-control allow-focus"/>
        </svg:field>
    </svg:IconBox>
</ui:UiBinder>
