<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:datetimebox="urn:import:stroom.widget.datepicker.client.component"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client"
             xmlns:tx="urn:import:stroom.widget.text.client">

    <g:FlowPanel addStyleNames="floor-map-timeline-settings">
        <!-- Loop playback toggle -->
        <g:FlowPanel addStyleNames="floor-map-timeline-settings__row">
            <tx:Label text="Loop Playback" addStyleNames="floor-map-timeline-settings__label" />
            <tickbox:TickBox ui:field="loopCheckBox" identity="floorMapTimelineLoop" label="" ariaLabel="Loop Playback"/>
        </g:FlowPanel>

        <!-- Date Range -->
        <g:FlowPanel addStyleNames="floor-map-timeline-settings__row">
            <tx:Label text="Start Date" addStyleNames="floor-map-timeline-settings__label" />
            <datetimebox:DateTimeBox ui:field="startDateTimeBox" addStyleNames="floor-map-timeline-settings__date-box" />
        </g:FlowPanel>
        <g:FlowPanel addStyleNames="floor-map-timeline-settings__row">
            <tx:Label text="End Date" addStyleNames="floor-map-timeline-settings__label" />
            <datetimebox:DateTimeBox ui:field="endDateTimeBox" addStyleNames="floor-map-timeline-settings__date-box" />
        </g:FlowPanel>

        <!-- Show All — sets date range to cover all data in the store -->
        <g:FlowPanel addStyleNames="floor-map-timeline-settings__show-all-row">
            <b:Button ui:field="showAllButton" addStyleNames="allow-focus" text="Show All"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
