<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The floor map editor's Time List panel: its actions above its grid (floormap-list.css) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <g:FlowPanel styleName="floormap-list">
        <b:Toolbar name="Time list actions" addStyleNames="floormap-list__toolbar">
            <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit" enabled="false"/>
            <b:ToolbarButton ui:field="addButton" svg="ADD" title="Add"/>
            <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete" enabled="false"/>
            <b:ToolbarButton ui:field="helpButton" svg="HELP_OUTLINE" title="Time List help"/>
        </b:Toolbar>
        <dg:DataGrid ui:field="dataGrid" tableName="Fact Times" addStyleNames="floormap-list__grid"/>
    </g:FlowPanel>
</ui:UiBinder>
