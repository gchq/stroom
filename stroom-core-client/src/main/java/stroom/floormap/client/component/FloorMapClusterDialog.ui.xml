<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:view="urn:import:stroom.widget.dropdowntree.client.view">
    <g:FlowPanel styleName="max dock-container-vertical">
        <!-- Search and filters on one line: all three narrow the same list, so
             none of them outranks the others. The search box takes the slack
             because what is typed into it is the only unbounded value here.

             The row layout is the feature's own class rather than the usual
             "dock-container-horizontal form" pair: .form sets
             flex-direction: column and, being on the same element, wins. -->
        <g:FlowPanel styleName="dock-min form-padding floor-map-cluster-dialog__filters">
            <form:FormGroup identity="clusterSearch" label="Search"
                            addStyleNames="floor-map-cluster-dialog__search">
                <view:QuickFilter ui:field="quickFilter"/>
            </form:FormGroup>
            <!-- Both dropdowns are hidden unless the cluster's members actually
                 differ; they start out hidden so a dialog whose first cluster
                 offers neither never flashes them. -->
            <form:FormGroup ui:field="areaFilterGroup" identity="clusterArea" label="Area"
                            addStyleNames="floor-map-cluster-dialog__filter"
                            visible="false"
                            helpText="Show only members inside this area, or those not inside any area. Only shown when the members are in at least two different areas, or some are in none. Works together with Search and Group.">
                <l:SelectionBox ui:field="areaFilter" addStyleNames="w-100"/>
            </form:FormGroup>
            <form:FormGroup ui:field="groupFilterGroup" identity="clusterGroup" label="Group"
                            addStyleNames="floor-map-cluster-dialog__filter"
                            visible="false"
                            helpText="Show only members of this group, from the map's Groups panel, or those in no group. Only shown when the members are in at least two different groups, or some are in none. Works together with Search and Area.">
                <l:SelectionBox ui:field="groupFilter" addStyleNames="w-100"/>
            </form:FormGroup>
        </g:FlowPanel>
        <g:SimplePanel styleName="dock-max overflow-hidden">
            <dg:PagerPanel toolbarName="Cluster member actions">
                <b:ToolbarButton ui:field="trackButton" svg="LOCATE" title="Track this entity" enabled="false"/>
                <!-- Says which of the two empty states this is: a filter that matched
                     nothing looks exactly like a broken dialog otherwise. -->
                <dg:DataGrid ui:field="dataGrid" tableName="Cluster Members"
                             emptyText="No members match the search and filters"/>
            </dg:PagerPanel>
        </g:SimplePanel>
    </g:FlowPanel>
</ui:UiBinder>
