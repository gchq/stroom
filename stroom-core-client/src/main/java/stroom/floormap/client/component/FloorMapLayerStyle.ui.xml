<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:colour="urn:import:stroom.widget.colour.client"
             xmlns:dd="urn:import:stroom.widget.dropdowntree.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:i="urn:import:stroom.item.client"
             xmlns:fv="urn:import:stroom.floormap.client.component">
    <!--
      The layer appearance dialog's content (stroom-floormap.css): the graphic a layer draws (a
      shape, an icon or an image), its colour and a preview. The table only lays the labels beside
      their controls, so it is presentation to assistive technology
    -->
    <g:HTMLPanel>
        <table class="floormap-layer-style-dialog" role="presentation">
            <tbody>
                <tr>
                    <td ui:field="graphicLabel">Graphic</td>
                    <td><form:RadioGroup ui:field="modeGroup"/></td>
                </tr>
                <tr ui:field="shapeRow">
                    <td ui:field="shapeLabel">Shape</td>
                    <td><i:SelectionBox ui:field="shapeBox"/></td>
                </tr>
                <tr ui:field="iconRow">
                    <td ui:field="iconLabel">Icon</td>
                    <td><fv:FloorMapIconPicker ui:field="iconPicker"/></td>
                </tr>
                <tr ui:field="imageRow">
                    <td ui:field="imageLabel">Image</td>
                    <td>
                        <g:FlowPanel addStyleNames="floormap-layer-style-image">
                            <g:SimplePanel ui:field="assetPickerPanel">
                                <dd:DropDownBox ui:field="assetBox"/>
                            </g:SimplePanel>
                            <b:Button ui:field="uploadButton"
                                      text="Upload"
                                      title="Upload a new image into this document's assets"
                                      ariaLabel="Upload a new image into this document's assets"/>
                        </g:FlowPanel>
                    </td>
                </tr>
                <tr>
                    <td ui:field="colourLabel">Colour</td>
                    <td><colour:ColourBox ui:field="colourBox"/></td>
                </tr>
                <tr>
                    <td>Preview</td>
                    <td>
                        <g:FlowPanel addStyleNames="floormap-layer-style-preview-row">
                            <g:SimplePanel ui:field="previewPanel" addStyleNames="floormap-layer-style-preview"/>
                            <!-- Uploaded assets are only served once the document is saved, so an
                                 image picked here can fail to render until then -->
                            <g:Label addStyleNames="floormap-layer-style-hint"
                                     text="Drawn at a fixed size on the map. Newly uploaded images appear after the document is saved."/>
                        </g:FlowPanel>
                    </td>
                </tr>
            </tbody>
        </table>
    </g:HTMLPanel>
</ui:UiBinder>
