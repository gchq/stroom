<!-- A floor map's Editor tab: the map canvas beside the right-hand dock, above the timeline (a
     fixed-height strip) above the Fact List beside the Time List -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.widget.layout.client"
             xmlns:e="urn:import:stroom.entity.client.component"
             xmlns:f="urn:import:stroom.floormap.client.component">
    <!-- The bottom strip is a third of the height; its edge to the top area can be dragged -->
    <l:SplitPane vertical="true" thin="true" sizes="*, 33%" names="Map and Controls, Timeline and Lists"
                 addStyleNames="max stroom-border-top">
        <!-- The dock starts 200px wide, and can be hidden by the toolbar's toggle -->
        <l:SplitPane ui:field="topSplitPane" thin="true" sizes="*, 200px" names="Map, Controls">
            <g:SimplePanel styleName="overflow-hidden">
                <f:FloorMapCanvas ui:field="canvas"/>
            </g:SimplePanel>
            <e:LinkTabPanel ui:field="dock" addStyleNames="overflow-hidden"/>
        </l:SplitPane>
        <g:FlowPanel styleName="max dock-container-vertical">
            <!-- The timeline is a compact bar of a fixed height (floor-map-editor-tab.css) -->
            <g:SimplePanel styleName="overflow-hidden stroom-border-bottom floor-map-editor-tab__timeline">
                <f:FloorMapTimeline ui:field="timeline"/>
            </g:SimplePanel>
            <l:SplitPane thin="true" sizes="50%, *" names="Fact List, Time List" addStyleNames="dock-max">
                <g:SimplePanel styleName="overflow-hidden">
                    <f:FloorMapFactList ui:field="factList"/>
                </g:SimplePanel>
                <g:SimplePanel styleName="overflow-hidden">
                    <f:FloorMapTimeList ui:field="timeList"/>
                </g:SimplePanel>
            </l:SplitPane>
        </g:FlowPanel>
    </l:SplitPane>
</ui:UiBinder>
