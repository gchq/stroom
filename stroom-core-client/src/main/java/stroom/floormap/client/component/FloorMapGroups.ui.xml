<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The floor map's Groups panel: its actions above its grid (floormap-list.css) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <g:FlowPanel styleName="floormap-list">
        <b:Toolbar name="Group actions" addStyleNames="floormap-list__toolbar">
            <b:ToolbarButton ui:field="newButton" svg="ADD" title="New Group"/>
            <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Group (name, colour and members)"
                             enabled="false"/>
            <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete Group" enabled="false"/>
        </b:Toolbar>
        <dg:DataGrid ui:field="dataGrid" tableName="Groups" addStyleNames="floormap-list__grid"/>
    </g:FlowPanel>
</ui:UiBinder>
