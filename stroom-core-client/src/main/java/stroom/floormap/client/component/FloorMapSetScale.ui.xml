<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:i="urn:import:stroom.widget.selection.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <!--
      The Set Scale dialog's content (floor-map-set-scale.css): a form, as every dialog's is, of what the
      line measured comes to now, and what it really is, a distance and its unit
    -->
    <g:FlowPanel styleName="form floor-map-set-scale">
        <form:FormGroup identity="floorMapMeasuredLength" label="Measured Length"
                        helpText="How long the line you drew measures at the map's current scale.">
            <tx:Label ui:field="currentReading" addStyleNames="w-100 text-label--value"/>
        </form:FormGroup>
        <form:FormGroup identity="floorMapRealLength" label="Real Length"
                        helpText="How long the line really is. The map is scaled so that the line measures this."
                        controlNames="Distance, Unit of the distance you typed">
            <g:FlowPanel styleName="floor-map-set-scale__row">
                <form:TextBox ui:field="distanceBox" addStyleNames="floor-map-set-scale__distance"
                              placeholder="e.g. 2.4"/>
                <i:SelectionBox ui:field="unitListBox"/>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
