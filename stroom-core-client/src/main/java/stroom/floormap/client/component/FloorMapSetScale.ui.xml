<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:i="urn:import:stroom.widget.selection.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <!--
      The Set Scale dialog's content (floor-map-set-scale.css): what the line measured comes to now, and
      what it really is, a distance and its unit. The table only lays the labels beside their
      controls, so it is presentation to assistive technology
    -->
    <g:HTMLPanel styleName="floor-map-set-scale">
        <table class="floor-map-set-scale__fields" role="presentation">
            <tbody>
                <tr>
                    <td>The line you measured is currently</td>
                    <td><tx:Label ui:field="currentReading"/></td>
                </tr>
                <tr>
                    <td ui:field="distanceLabel">It is really</td>
                    <td>
                        <g:FlowPanel styleName="floor-map-set-scale__row">
                            <form:TextBox ui:field="distanceBox" addStyleNames="stroom-control floor-map-set-scale__distance"
                                            placeholder="e.g. 2.4"/>
                            <i:SelectionBox ui:field="unitListBox"/>
                        </g:FlowPanel>
                    </td>
                </tr>
            </tbody>
        </table>
    </g:HTMLPanel>
</ui:UiBinder>
