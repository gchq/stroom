<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:c="urn:import:stroom.widget.component.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max form-padding form change-password">
        <form:FormGroup ui:field="passwordGroup" identity="password" label="Password" required="true"
                        helpText="Enter your new password. It must meet the password policy. The strength meter and length badge update as you type."
                        screenReaderText="Must meet the password policy.">
            <g:HTMLPanel>
                <tx:Label ui:field="passwordPolicyMessage" styleName="change-password__policy"/>

                <!-- The strength meter, from none (0) to strong (5) -->
                <div ui:field="strengthMeter" class="change-password__strength" role="meter"
                     aria-label="Password strength" aria-valuemin="0" aria-valuemax="5"
                     aria-valuenow="0" aria-valuetext="None">
                    <div ui:field="strengthMeterBar" class="change-password__strength-bar"></div>
                </div>

                <form:PasswordBox ui:field="password" placeholder="Enter Password">
                    <!-- The length is shown as a picture only: the strength meter says how good the
                         password is -->
                    <form:badge>
                        <c:AriaPanel ui:field="passwordLengthBadge" styleName="change-password__length change-password__length--short"
                                     ariaHidden="true"/>
                    </form:badge>
                </form:PasswordBox>
            </g:HTMLPanel>
        </form:FormGroup>
        <form:FormGroup ui:field="confirmPasswordGroup" identity="confirmPassword" label="Confirm Password" required="true"
                        helpText="Enter your new password again to confirm it. Both must match exactly."
                        screenReaderText="Must match the new password exactly.">
            <form:PasswordBox ui:field="confirmPassword" placeholder="Confirm Password"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
