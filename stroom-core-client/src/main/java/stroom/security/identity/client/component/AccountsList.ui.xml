<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- Accounts: a quick filter above a page of them, with their actions and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:v="urn:import:stroom.widget.dropdowntree.client.view"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <v:QuickFilterPage ui:field="page" accessibleName="Filter accounts">
        <dg:PagerPanel ui:field="pager" toolbarName="Account actions">
            <b:ToolbarButton ui:field="newButton" svg="ADD" title="New Account"/>
            <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Account" enabled="false"/>
            <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete Selected Account" enabled="false"/>
            <dg:DataGrid ui:field="dataGrid" pageSize="1000" tableName="Accounts"/>
        </dg:PagerPanel>
    </v:QuickFilterPage>
</ui:UiBinder>
