<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="password" label="Current Password" required="true"
                        helpText="Enter your existing Stroom account password to confirm your identity before changing it."
                        screenReaderText="Confirms your identity before the change.">
            <g:FlowPanel>
                <form:PasswordBox ui:field="password" placeholder="Enter Your Current Password"/>

                <g:Label ui:field="passwordFeedback" styleName="feedback"/>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
