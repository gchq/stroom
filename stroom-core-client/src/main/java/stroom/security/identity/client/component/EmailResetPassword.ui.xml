<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="email" label="Email Address" required="true"
                        helpText="Enter the email address registered to your account. If it matches an account, an email will be sent to it explaining how to set a new password."
                        screenReaderText="An email is sent if it matches an account.">
            <g:FlowPanel>
                <g:FlowPanel>
                    <form:TextBox ui:field="email" addStyleNames="w-100"
                                  placeholder="Enter Your Email Address"/>
                </g:FlowPanel>

                <tx:Label ui:field="emailFeedback" styleName="feedback"/>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
