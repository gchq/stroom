<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The documents that depend on a user: a quick filter above a page of them -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:v="urn:import:stroom.widget.dropdowntree.client.view"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <v:QuickFilterPage ui:field="page" accessibleName="Filter dependencies">
        <dg:PagerPanel ui:field="pager">
            <dg:DataGrid ui:field="dataGrid" tableName="User Dependencies"/>
        </dg:PagerPanel>
    </v:QuickFilterPage>
</ui:UiBinder>
