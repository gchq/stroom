<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A user's permissions on documents: a page of them, with a pager and their actions -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Document permission actions">
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Permissions For Selected Document"
                         enabled="false"/>
        <b:ToolbarButton ui:field="filterButton" svg="FILTER" title="Filter Documents"/>
        <b:ToolbarButton ui:field="batchEditButton" svg="GENERATE" title="Batch Edit Permissions For Filtered Documents"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Document Permissions"/>
    </dg:PagerPanel>
</ui:UiBinder>
