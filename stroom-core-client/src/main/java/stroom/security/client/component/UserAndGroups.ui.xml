<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
        xmlns:ui="urn:ui:com.google.gwt.uibinder"
        xmlns:g="urn:import:com.google.gwt.user.client.ui"
        xmlns:l="urn:import:stroom.widget.layout.client"
        xmlns:sec="urn:import:stroom.security.client.component">
    <!-- The User Groups screen (user-and-groups.css): the users and groups above; below, the
         groups the selected one is a member of beside the members of the selected group
         (addStyleNames, as styleName would replace the split pane's own class) -->
    <l:SplitPane ui:field="outerSplitPane"
                 vertical="true"
                 thin="true"
                 sizes="50%, *"
                 names="Users and groups, Membership"
                 addStyleNames="max">
        <g:SimplePanel ui:field="userListPane"
                       styleName="max">
            <sec:UserList ui:field="userList"/>
        </g:SimplePanel>
        <l:SplitPane ui:field="innerSplitPane"
                     thin="true"
                     sizes="*, 50%"
                     names="Member of, Members"
                     addStyleNames="max">
            <g:SimplePanel ui:field="parentsPane"
                           styleName="max user-and-groups__pane">
                <sec:UserList ui:field="parents"/>
            </g:SimplePanel>
            <g:SimplePanel ui:field="childrenPane"
                           styleName="max user-and-groups__pane">
                <sec:UserList ui:field="children"/>
            </g:SimplePanel>
        </l:SplitPane>
    </l:SplitPane>
</ui:UiBinder>
