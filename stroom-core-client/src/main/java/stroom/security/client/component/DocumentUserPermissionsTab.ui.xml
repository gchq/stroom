<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A document's permissions: the users and groups with them, above the details of the one chosen -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:tx="urn:import:stroom.widget.text.client"
             xmlns:sec="urn:import:stroom.security.client.component">
    <!-- The details below the rest (addStyleNames, as styleName would replace the
         split pane's own class) -->
    <split:SplitPane vertical="true" thin="true" sizes="*, 200px" names="Users and groups, Details"
                     addStyleNames="document-user-permissions-tab max default-min-sizes">
        <g:FlowPanel styleName="max dock-container-vertical">
            <form:FormGroup label="Permission Visibility"
                            addStyleNames="form-padding"
                            screenReaderText="Filters the users and groups list: explicit, effective or all.">
                <form:HelpHTML>
                    <p>This dropdown controls which users/groups are shown in the <em>Users and Groups</em>
                        pane below.</p>
                    <ul>
                        <li><strong>Show Explicit</strong> - Show only those users/groups that have an explicit
                            permission on this document/folder, i.e. one that has been
                            directly assigned to them.</li>
                        <li><strong>Show Effective</strong> - Show only those users/groups that have an explicit
                        or inherited permission on this document/folder. The permission may be inherited from
                        a group they are a member of or from an ancestor of a group they are a member of.</li>
                        <li><strong>Show All</strong> - Shows all users/groups regardless of permissions held.
                        Select this to grant new permissions to users/groups.</li>
                    </ul>
                </form:HelpHTML>
                <l:SelectionBox ui:field="permissionVisibility"/>
            </form:FormGroup>
            <form:FormGroup label="Users and Groups"
                            addStyleNames="form-group--indented document-user-permissions-tab__users"
                            screenReaderText="Filtered by Permission Visibility. Select one to see and edit its permissions.">
                <form:HelpHTML>
                    <p>Lists users/groups, optionally filtered based on the value of the
                        <em>Permission Visibility</em> dropdown.</p>
                </form:HelpHTML>
                <g:SimplePanel styleName="document-user-permissions-tab__list">
                    <sec:DocumentUserPermissionsList ui:field="docUserPermissionsList"/>
                </g:SimplePanel>
            </form:FormGroup>
        </g:FlowPanel>
        <form:FormGroup ui:field="detailsFormGroup"
                        addStyleNames="form-group--indented">
            <g:SimplePanel styleName="max form-padding document-user-permissions-tab__details">
                <tx:Html ui:field="details" styleName="max permission-details"/>
            </g:SimplePanel>
        </form:FormGroup>
    </split:SplitPane>
</ui:UiBinder>
