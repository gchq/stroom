<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- API keys: a quick filter above a page of them, with a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:v="urn:import:stroom.widget.quickfilter.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <v:QuickFilterPage ui:field="page" accessibleName="Filter API keys">
        <dg:PagerPanel ui:field="pager">
            <dg:DataGrid ui:field="dataGrid" tableName="API Keys"/>
        </dg:PagerPanel>
    </v:QuickFilterPage>
</ui:UiBinder>
