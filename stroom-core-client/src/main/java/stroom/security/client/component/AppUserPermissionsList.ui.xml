<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- Users and groups with their application permissions: a quick filter above a page of them -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:v="urn:import:stroom.widget.quickfilter.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <v:QuickFilterPage ui:field="page" accessibleName="Filter users">
        <dg:PagerPanel ui:field="pager">
            <dg:DataGrid ui:field="dataGrid" tableName="User Permissions" multiLine="true"/>
        </dg:PagerPanel>
    </v:QuickFilterPage>
</ui:UiBinder>
