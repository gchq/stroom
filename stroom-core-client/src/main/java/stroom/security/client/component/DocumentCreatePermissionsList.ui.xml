<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <!-- The document types a user or group may create in a folder, and below them how they hold
         the selected one (the split pane's classes are added, as styleName would replace its own) -->
    <split:SplitPane vertical="true" sizes="*, 200px" names="Create permissions, Details"
                     addStyleNames="max default-min-sizes">
        <g:FlowPanel styleName="max dock-container-vertical">
            <form:FormGroup label="Document Create Permissions" addStyleNames="dock-max"
                            helpText="The document types that can be created in this folder. Tick a type to let the user or group create it here; tick the box in the column header to grant 'Create All'.">
                <dg:DataGrid ui:field="dataGrid" tableName="Document Create Permissions"
                             addStyleNames="max form-control-border form-control-background"/>
            </form:FormGroup>
        </g:FlowPanel>
        <form:FormGroup label="Document Create Permission Details" addStyleNames="max"
                        helpText="Explains how the selected user or group holds permission to create the selected document type here: directly, through 'Create All', through ownership, or inherited from a group.">
            <tx:Html ui:field="details"
                    styleName="max form-control-border form-control-background form-padding"/>
        </form:FormGroup>
    </split:SplitPane>
</ui:UiBinder>
