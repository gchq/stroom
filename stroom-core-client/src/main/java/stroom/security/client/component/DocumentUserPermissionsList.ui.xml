<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The users and groups with permissions on a document: a quick filter above a page of them. In a
     dialog, the table and its toolbar are framed as a control (see components.css) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:v="urn:import:stroom.widget.quickfilter.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <v:QuickFilterPage ui:field="page" accessibleName="Filter users">
        <dg:PagerPanel ui:field="pager" addStyleNames="documentUserPermissions-table">
            <dg:DataGrid ui:field="dataGrid" tableName="Document User Permissions" multiLine="true"/>
        </dg:PagerPanel>
    </v:QuickFilterPage>
</ui:UiBinder>
