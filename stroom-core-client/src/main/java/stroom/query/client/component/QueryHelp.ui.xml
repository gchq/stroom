<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:sl="urn:import:stroom.widget.selection.client">

    <split:SplitPane vertical="true" thin="true" sizes="250px, *"
                     names="Help items, Details" addStyleNames="query-help max">
        <sl:SelectionList ui:field="selectionList" accessibleName="Help contents"
                          keyboardSelectionPolicy="BOUND_TO_SELECTION"/>
        <g:FlowPanel styleName="max dock-container-vertical">
            <b:Toolbar name="Help actions" addStyleNames="dock-min">
                <b:ToolbarButton ui:field="insertButton" svg="INSERT" title="Insert into Query" enabled="false"/>
                <b:ToolbarButton ui:field="copyButton" svg="COPY" title="Copy to Clipboard" enabled="false"/>
            </b:Toolbar>
            <g:SimplePanel ui:field="details" styleName="dock-max query-help-detail"/>
        </g:FlowPanel>
    </split:SplitPane>
</ui:UiBinder>
