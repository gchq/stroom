<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A StroomQL query: its help beside the editor, above the results as a table or a visualisation -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:ed="urn:import:stroom.editor.client.component"
             xmlns:tab="urn:import:stroom.widget.tab.client">
    <split:SplitPane vertical="true" thin="true" sizes="600px, *"
                     names="Query, Results" addStyleNames="QueryEditViewImpl max">
        <split:SplitPane thin="true" sizes="300px, *"
                         names="Help, Query" addStyleNames="max">
            <g:SimplePanel ui:field="help" styleName="max"/>
            <g:SimplePanel styleName="max dashboard-panel overflow-hidden">
                <ed:CodeEditor ui:field="editor"/>
            </g:SimplePanel>
        </split:SplitPane>
        <g:SimplePanel styleName="max">
            <g:FlowPanel styleName="QueryResultTabsViewImpl max dock-container-vertical">
                <g:SimplePanel styleName="QueryResultTabsViewImpl-outer">
                    <tab:LinkTabBar ui:field="tabBar" addStyleNames="dock-min"/>
                </g:SimplePanel>
                <tab:LayerContainerImpl ui:field="layerContainer" styleName="dock-max" fade="true"/>
            </g:FlowPanel>
        </g:SimplePanel>
    </split:SplitPane>
</ui:UiBinder>
