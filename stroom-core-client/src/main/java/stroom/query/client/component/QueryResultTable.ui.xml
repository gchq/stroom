<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A query's results as a table: the rows, grouped and expandable, below the table's actions -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <g:FlowPanel styleName="result-table max stroom-dashboard-table">
        <dg:PagerPanel ui:field="pager" toolbarName="Table actions">
            <dg:DataGrid ui:field="dataGrid" tableName="Query Results" virtual="true"
                         addStyleNames="result-table__grid"/>
        </dg:PagerPanel>
    </g:FlowPanel>
</ui:UiBinder>
