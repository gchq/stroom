<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:q="urn:import:stroom.query.client.component"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <g:SimplePanel styleName="max control-box">
        <split:SplitPane vertical="true" thin="true" sizes="200px, *"
                         names="Result stores, Info" addStyleNames="max">
            <!-- The stores, their list's own -->
            <g:SimplePanel styleName="max overflow-hidden">
                <q:ResultStoreList ui:field="list"/>
            </g:SimplePanel>
            <!-- The store's details scroll when they are long, so the keyboard can reach them to
                 scroll them: a named region that takes the focus -->
            <split:ScrollPane addStyleNames="max scroll-region"
                              focusable="true" role="region" ariaLabel="Info">
                <g:SimplePanel ui:field="infoPanel"/>
            </split:ScrollPane>
        </split:SplitPane>
    </g:SimplePanel>
</ui:UiBinder>
