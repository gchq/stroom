<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A query's results table, beside the source of the row selected when the row has one -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:q="urn:import:stroom.query.client.component"
             xmlns:r="urn:import:stroom.query.client.result.component"
             xmlns:l="urn:import:stroom.widget.layout.client">
    <g:SimplePanel styleName="max overflow-hidden">
        <!-- Half each, the source no narrower than 100px -->
        <l:SplitPane ui:field="split" thin="true" sizes="*, 50%" minSizes="0px, 100px" names="Table, Source"
                     addStyleNames="max">
            <g:SimplePanel styleName="max">
                <r:ResultTable ui:field="table" tableName="Query Results"/>
            </g:SimplePanel>
            <g:SimplePanel ui:field="source" styleName="max">
                <q:QueryTextPane ui:field="textPane"/>
            </g:SimplePanel>
        </l:SplitPane>
    </g:SimplePanel>
</ui:UiBinder>
