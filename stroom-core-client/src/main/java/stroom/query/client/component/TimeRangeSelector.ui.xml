<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A time range selector (TimeRangeSelector), the BEM block time-range-selector
     (time-range-selector.css): a button drawn as a link, its text the range, that opens the Time
     Range dialog -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client">
    <b:LinkButton ui:field="button" addStyleNames="time-range-selector" opensDialog="true"
                  title="Time range to apply to all queries in this dashboard.&#10;The selected time range applies to the time field applicable to each query's data source."/>
</ui:UiBinder>
