<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A store's or index's Data tab: a StroomQL query of its rows with Reset, Run, Stop and Create
     Dashboard, any error in it, and the results table -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:r="urn:import:stroom.query.client.result.component"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:tx="urn:import:stroom.widget.text.client">

    <g:FlowPanel styleName="max dock-container-vertical">
        <g:FlowPanel styleName="dock-min dock-container-horizontal align-center form-padding input-row">
            <tx:Label text="Query:" styleName="dock-min"/>
            <form:TextBox ui:field="query" addStyleNames="dock-max" ariaLabel="Query"/>
            <b:Toolbar name="Query actions" addStyleNames="dock-min">
                <b:ToolbarButton ui:field="reset" svg="UNDO" title="Reset to Default"/>
                <b:ToolbarButton ui:field="run" svg="PLAY" title="Run"
                                 addStyleNames="toolbar-button--play"/>
                <b:ToolbarButton ui:field="stop" svg="STOP" title="Stop"
                                 addStyleNames="toolbar-button--stop"/>
                <b:ToolbarButton ui:field="createDashboard" svg="DOCUMENT_DASHBOARD" title="Create Dashboard"/>
            </b:Toolbar>
        </g:FlowPanel>
        <g:ScrollPanel ui:field="errorContainer" styleName="query-data-tab__error-container" visible="false">
            <tx:Label ui:field="errorLabel" styleName="query-data-tab__error-label"/>
        </g:ScrollPanel>
        <g:SimplePanel styleName="max dock-max">
            <r:ResultTable ui:field="table" tableName="Query Results"/>
        </g:SimplePanel>
    </g:FlowPanel>
</ui:UiBinder>
