<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.data.client.component"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:ed="urn:import:stroom.editor.client.component"
             xmlns:spinner="urn:import:stroom.widget.spinner.client">
    <g:FlowPanel styleName="max dock-container-vertical">
        <g:FlowPanel styleName="dock-min dock-container-horizontal">
            <g:FlowPanel styleName="dock-max"/>
            <b:Toolbar name="Text actions" addStyleNames="dock-min">
                <b:ToolbarButton ui:field="close" svg="CLOSE" title="Close Text Pane"/>
            </b:Toolbar>
        </g:FlowPanel>
        <g:FlowPanel styleName="dock-max">
            <g:FlowPanel styleName="max">
                <ed:CodeEditor ui:field="editor" visible="false"/>
                <ed:HtmlPane ui:field="html" visible="false"/>
            </g:FlowPanel>
        </g:FlowPanel>
        <l:ClassificationLabel ui:field="classification" styleName="dock-min classification-label classification-label--one-line"/>
        <spinner:LargeBusySpinner ui:field="spinner" addStyleNames="busy-spinner--centred" visible="false"/>
    </g:FlowPanel>
</ui:UiBinder>
