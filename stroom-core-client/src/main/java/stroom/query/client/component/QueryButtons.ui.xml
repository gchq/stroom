<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  The query's run button (query-buttons.css): Execute Query (Ctrl+Enter), which becomes Stop Query
  (Escape) while the query runs. Disabled until the query can run.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client">
    <b:Toolbar name="Query" addStyleNames="query-buttons">
        <b:ToolbarButton ui:field="start" svg="PLAY" shortcut="OK" title="Execute Query" enabled="false"
                         addStyleNames="query-buttons__button query-buttons__button--play"/>
    </b:Toolbar>
</ui:UiBinder>
