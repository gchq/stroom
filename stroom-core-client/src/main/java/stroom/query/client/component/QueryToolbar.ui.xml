<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:q="urn:import:stroom.query.client.component"
             xmlns:b="urn:import:stroom.widget.button.client">
    <g:SimplePanel styleName="query-toolbar">
        <g:FlowPanel styleName="query-toolbar__inner">
            <q:TimeRangeSelector ui:field="timeRangeSelector" addStyleNames="dock-min"/>
            <b:Toolbar ui:field="errorsToolbar" name="Query errors"
                       addStyleNames="query-toolbar__errors query-toolbar__errors--hidden">
                <b:ToolbarButton ui:field="errors" svg="ERROR" title="Show Errors"/>
            </b:Toolbar>
            <q:RunQueryButton ui:field="queryButtons" addStyleNames="dock-min"/>
        </g:FlowPanel>
    </g:SimplePanel>
</ui:UiBinder>
