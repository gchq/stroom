<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The search result stores, with a pager and their actions -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Result store actions">
        <b:ToolbarButton ui:field="terminateButton" svg="STOP" title="Terminate Search" enabled="false"/>
        <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete Selected Result Store" enabled="false"/>
        <b:ToolbarButton ui:field="settingsButton" svg="SETTINGS" title="Edit Result Store Settings"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Result Stores"/>
    </dg:PagerPanel>
</ui:UiBinder>
