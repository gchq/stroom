<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:i="urn:import:stroom.item.client"
             xmlns:dt="urn:import:stroom.widget.datepicker.client"
             xmlns:dd="urn:import:stroom.widget.dropdowntree.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <!--
      A term's editor (term-editor.css): its field, its condition and the value boxes the condition
      takes, which the Java shows for the field's type and condition, then the field's type. It is
      shown while its term is edited
    -->
    <g:FlowPanel styleName="term-editor" visible="false">
        <g:FlowPanel ui:field="inner" styleName="term-editor__fields">
            <i:BaseSelectionBox ui:field="fieldListBox" addStyleNames="term-editor__item term-editor__item--field"/>
            <i:SelectionBox ui:field="conditionListBox" addStyleNames="term-editor__item term-editor__item--condition"/>
            <i:SuggestionBox ui:field="value" addStyleNames="term-editor__item term-editor__item--wide" visible="false"/>
            <i:SuggestionBox ui:field="valueFrom" addStyleNames="term-editor__item term-editor__item--narrow" visible="false"/>
            <dt:DateTimeBox ui:field="date" expressionsAllowed="true" addStyleNames="term-editor__item term-editor__item--narrow"
                            visible="false"/>
            <dt:DateTimeBox ui:field="dateFrom" expressionsAllowed="true" addStyleNames="term-editor__item term-editor__item--narrow"
                            visible="false"/>
            <tx:Label ui:field="andLabel" addStyleNames="term-editor__label" wordWrap="false" text=" and "
                     visible="false"/>
            <i:SuggestionBox ui:field="valueTo" addStyleNames="term-editor__item term-editor__item--narrow" visible="false"/>
            <dt:DateTimeBox ui:field="dateTo" expressionsAllowed="true" addStyleNames="term-editor__item term-editor__item--narrow"
                            visible="false"/>
            <dd:DropDownBox ui:field="docRefBox" addStyleNames="term-editor__item term-editor__item--picker term-editor__item--doc"
                            visible="false"/>
            <dd:DropDownBox ui:field="userRefBox" addStyleNames="term-editor__item term-editor__item--picker" visible="false"/>
        </g:FlowPanel>
        <tx:Label ui:field="fieldTypeLabel" addStyleNames="term-editor__label term-editor__label--field-type" wordWrap="false"
                 visible="false"/>
    </g:FlowPanel>
</ui:UiBinder>
