<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:i="urn:import:stroom.item.client"
             xmlns:dt="urn:import:stroom.widget.datepicker.client"
             xmlns:dd="urn:import:stroom.widget.dropdowntree.client">
    <!--
      A term's editor (term-editor.css): its field, its condition and the value boxes the condition
      takes, which the Java shows for the field's type and condition, then the field's type. It is
      shown while its term is edited
    -->
    <g:FlowPanel styleName="termEditor-outer" visible="false">
        <g:FlowPanel ui:field="inner" styleName="termEditor-inner">
            <i:BaseSelectionBox ui:field="fieldListBox" addStyleNames="termEditor-item dropdown field"/>
            <i:SelectionBox ui:field="conditionListBox" addStyleNames="termEditor-item dropdown condition"/>
            <i:SuggestionBox ui:field="value" addStyleNames="termEditor-item wide" visible="false"/>
            <i:SuggestionBox ui:field="valueFrom" addStyleNames="termEditor-item narrow" visible="false"/>
            <dt:DateTimeBox ui:field="date" expressionsAllowed="true" addStyleNames="termEditor-item narrow"
                            visible="false"/>
            <dt:DateTimeBox ui:field="dateFrom" expressionsAllowed="true" addStyleNames="termEditor-item narrow"
                            visible="false"/>
            <g:Label ui:field="andLabel" addStyleNames="termEditor-label" wordWrap="false" text=" and "
                     visible="false"/>
            <i:SuggestionBox ui:field="valueTo" addStyleNames="termEditor-item narrow" visible="false"/>
            <dt:DateTimeBox ui:field="dateTo" expressionsAllowed="true" addStyleNames="termEditor-item narrow"
                            visible="false"/>
            <dd:DropDownBox ui:field="docRefBox" addStyleNames="termEditor-item docRef termEditor-item--doc"
                            visible="false"/>
            <dd:DropDownBox ui:field="userRefBox" addStyleNames="termEditor-item docRef" visible="false"/>
        </g:FlowPanel>
        <g:Label ui:field="fieldTypeLabel" addStyleNames="termEditor-label fieldType" wordWrap="false"
                 visible="false"/>
    </g:FlowPanel>
</ui:UiBinder>
