<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A pipeline element's properties, with Edit and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Property actions">
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Property" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Pipeline Properties" multiLine="true"/>
    </dg:PagerPanel>
</ui:UiBinder>
