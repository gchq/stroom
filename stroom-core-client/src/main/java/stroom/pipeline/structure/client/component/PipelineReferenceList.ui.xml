<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A pipeline element's reference pipelines, with New, Edit, Remove and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Reference actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="New Pipeline Reference"/>
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Pipeline Reference" enabled="false"/>
        <b:ToolbarButton ui:field="removeButton" svg="REMOVE" title="Remove Selected Pipeline Reference"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Pipeline References" multiLine="true"/>
    </dg:PagerPanel>
</ui:UiBinder>
