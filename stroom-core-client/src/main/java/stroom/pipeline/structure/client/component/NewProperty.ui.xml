<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
        xmlns:ui="urn:ui:com.google.gwt.uibinder"
        xmlns:g="urn:import:com.google.gwt.user.client.ui"
        xmlns:i="urn:import:stroom.item.client"
        xmlns:v="urn:import:stroom.widget.valuespinner.client"
        xmlns:dd="urn:import:stroom.widget.dropdowntree.client"
        xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max form">
        <form:FormGroup identity="newPropertyElementId"
                        label="Element"
                        helpText="The pipeline element that this property relates to.">
            <tx:Label ui:field="element" addStyleNames="stroom-control-label"/>
        </form:FormGroup>
        <form:FormGroup identity="newPropertyName"
                        label="Name"
                        helpText="The name of the property on this pipeline element.">
            <tx:Label ui:field="name" addStyleNames="stroom-control-label"/>
        </form:FormGroup>
        <form:FormGroup identity="newPropertyDescription"
                        label="Description"
                        helpText="The description of this property.">
            <tx:Label ui:field="description" addStyleNames="stroom-control-label"/>
        </form:FormGroup>
        <form:FormGroup identity="newPropertySource"
                        label="Source"
                        screenReaderText="Default, Inherit, Local, or Embedded for some document properties.">
            <form:HelpHTML>
                <p>The source of the value for this property.</p>
                <ul>
                    <li>
                        <code>Default</code>
                        means the default value is used.
                    </li>
                    <li>
                        <code>Inherit</code>
                        means the value is inherited from the parent pipeline.
                    </li>
                    <li>
                        <code>Local</code>
                        means the value set on this element is used.
                    </li>
                    <li>
                        <code>Embedded</code>
                        means a new document is created and embedded in this pipeline,
                        rather than referencing an existing document.
                        Only offered for some document properties.
                    </li>
                </ul>
            </form:HelpHTML>
            <i:SelectionBox ui:field="source" addStyleNames="w-100"/>
        </form:FormGroup>
        <form:FormGroup identity="newPropertyValue"
                        label="Value"
                        helpText="The value of this property. Changing it sets Source to Local."
                        screenReaderText="Changing it sets Source to Local.">
            <!--
              One editor is shown, for the property's type. Each is named Value, as the label is
              only for the one shown when the dialog opens (Embedded shows the text box after)
            -->
            <g:FlowPanel addStyleNames="w-100">
                <i:SelectionBox ui:field="booleanValue" ariaLabel="Value" addStyleNames="w-100"/>
                <v:ValueSpinner ui:field="numberValue" minValue="0" maxValue="10000000" ariaLabel="Value"
                                addStyleNames="w-100"/>
                <form:TextBox ui:field="textValue" ariaLabel="Value" addStyleNames="w-100"/>
                <i:SelectionBox ui:field="streamTypeValue" ariaLabel="Value" addStyleNames="w-100"/>
                <i:SelectionBox ui:field="volumeGroupValue" ariaLabel="Value" addStyleNames="w-100"/>
                <dd:DropDownBox ui:field="documentValue" addStyleNames="w-100"/>
            </g:FlowPanel>
        </form:FormGroup>
        <form:FormGroup ui:field="defaultValueGroup"
                        visible="false"
                        identity="newPropertyDefaultValue"
                        label="Default Value"
                        helpText="The default value for this property on this pipeline element type.">
            <tx:Label ui:field="defaultValue" addStyleNames="stroom-control-label"/>
        </form:FormGroup>
        <form:FormGroup ui:field="inheritedValueGroup"
                        visible="false"
                        identity="newPropertyInheritedValue"
                        label="Inherited Value"
                        helpText="The value inherited from the parent pipeline.">
            <tx:Label ui:field="inheritedValue" addStyleNames="stroom-control-label"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>

