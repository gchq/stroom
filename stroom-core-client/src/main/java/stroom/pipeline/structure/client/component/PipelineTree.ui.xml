<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:ht="urn:import:stroom.widget.htree.client"
             xmlns:pv="urn:import:stroom.pipeline.structure.client.component">
    <!--
      The pipeline structure editor's tree of elements, filling its pane. The order of an
      element's children doesn't matter (the model moves nothing), so dropping an element where it
      came from leaves it as it was
    -->
    <ht:DraggableTree ui:field="layoutPanel" addStyleNames="max" putBackOnOwnParent="true">
        <ht:tree>
            <pv:PipelineTreeDiagram ui:field="treePanel"/>
        </ht:tree>
    </ht:DraggableTree>
</ui:UiBinder>
