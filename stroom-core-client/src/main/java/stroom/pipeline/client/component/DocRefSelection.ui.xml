<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The documents changed, each with a tick box to save it -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <g:FlowPanel addStyleNames="max dock-container-vertical">
        <g:HTMLPanel styleName="message-container">
            <div>The following documents have changed. Please select the ones you want to save:</div>
        </g:HTMLPanel>
        <g:FlowPanel addStyleNames="list-container dock-max">
            <dg:DataGrid ui:field="dataGrid" tableName="Document References" hasContextMenu="false"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
