<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A Visualisation pane's Basic settings: its id and name, the table that supplies its data,
     and the visualisation that draws it -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:i="urn:import:stroom.item.client"
             xmlns:dd="urn:import:stroom.widget.dropdowntree.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max form">
        <form:FormGroup identity="basicVisSettingsId" label="Id"
                        helpText="Unique ID of this component on the dashboard, generated when the component is added (e.g. vis-AB1C2). It cannot be changed.">
            <tx:Label ui:field="id" addStyleNames="w-100 stroom-control-label"/>
        </form:FormGroup>
        <form:FormGroup identity="basicVisSettingsName" label="Name"
                        helpText="Name of this component, shown in its tab on the dashboard.">
            <form:TextBox ui:field="name" addStyleNames="w-100"/>
        </form:FormGroup>
        <form:FormGroup identity="basicVisSettingsTable" label="Table"
                        helpText="Table that supplies the data for this visualisation.">
            <i:SelectionBox ui:field="table" addStyleNames="w-100"/>
        </form:FormGroup>
        <form:FormGroup identity="basicVisSettingsVisualisation" label="Visualisation"
                        helpText="Visualisation document used to draw the chart. Choosing one adds its settings tabs. You need Use permission on it.">
            <g:SimplePanel addStyleNames="w-100">
                <dd:DropDownBox ui:field="visualisation" addStyleNames="w-100"/>
            </g:SimplePanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
