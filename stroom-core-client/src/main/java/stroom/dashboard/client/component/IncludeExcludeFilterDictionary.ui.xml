<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A filter's dictionaries, with Add and Remove -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Dictionary actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="Add Dictionary"/>
        <b:ToolbarButton ui:field="removeButton" svg="DELETE" title="Remove Dictionary" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Document References"/>
    </dg:PagerPanel>
</ui:UiBinder>
