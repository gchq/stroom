<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A dashboard's Text pane: the source of the row selected in a table, as text or HTML, with a button to
     step it and its classification -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.data.client.view"
             xmlns:button="urn:import:stroom.widget.button.client"
             xmlns:spinner="urn:import:stroom.widget.spinner.client">
    <g:FlowPanel styleName="max dock-container-vertical stroom-dashboard-text">
        <g:FlowPanel styleName="dock-max stepping-button-container">
            <g:SimplePanel ui:field="content" styleName="max"/>
            <button:FabButton ui:field="steppingButton"
                              addStyleNames="stepping-button"
                              icon="STEPPING"
                              title="Enter Stepping Mode" visible="false"/>
        </g:FlowPanel>
        <l:ClassificationLabel ui:field="classification" styleName="dock-min classification-label classification-label--one-line"/>
        <spinner:SpinnerLarge ui:field="spinner" addStyleNames="busy-spinner--centred" visible="false"/>
    </g:FlowPanel>
</ui:UiBinder>
