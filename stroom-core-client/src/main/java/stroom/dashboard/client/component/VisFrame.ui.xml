<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A visualisation's frame in a container that clips it (dashboard.css), each placed by
  setContainerPositionAndSize and setInnerPositionAndSize. The frame shows Stroom's visualisation
  page until a visualisation with assets of its own sets its URL.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:SimplePanel ui:field="container" addStyleNames="VisFrame-container">
        <g:Frame ui:field="frame" addStyleNames="VisFrame-frame" url="ui/vis.html"/>
    </g:SimplePanel>
</ui:UiBinder>
