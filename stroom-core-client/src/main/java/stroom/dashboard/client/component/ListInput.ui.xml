<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A dashboard's List Input pane: a list of values, one of which is a query parameter, or, when
     several can be chosen, a picker showing those ticked, which opens a chooser of them -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.widget.selection.client"
             xmlns:dd="urn:import:stroom.widget.dropdowntree.client">
    <g:SimplePanel styleName="max dock-container-horizontal">
        <g:FlowPanel styleName="dashboard-input dock-max">
            <l:SelectionBox ui:field="valueSelectionBox" addStyleNames="w-100 allow-focus"/>
            <dd:DropDownBox ui:field="valuesBox" addStyleNames="w-100" visible="false"/>
        </g:FlowPanel>
    </g:SimplePanel>
</ui:UiBinder>
