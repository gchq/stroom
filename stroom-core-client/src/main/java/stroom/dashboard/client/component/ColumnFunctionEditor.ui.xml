<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A dashboard table column's expression: the query help beside its editor -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:ed="urn:import:stroom.editor.client.component">
    <g:FlowPanel styleName="max default-min-sizes dock-container-vertical column-function-editor">
        <split:SplitPane thin="true" sizes="300px, *"
                         names="Help, Expression" addStyleNames="dock-max form-control-border form-control-background">
            <g:SimplePanel ui:field="queryHelp" styleName="max"/>
            <g:SimplePanel styleName="dock-max">
                <ed:CodeEditor ui:field="editor"/>
            </g:SimplePanel>
        </split:SplitPane>
        <g:FlowPanel addStyleNames="dock-min dock-container-horizontal column-function-editor__completion">
            <g:HTML>
                <code>ctrl-space</code>
                for auto-completion
            </g:HTML>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
