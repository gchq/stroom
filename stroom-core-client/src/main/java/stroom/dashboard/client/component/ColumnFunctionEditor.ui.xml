<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A dashboard table column's expression: the query help beside its editor -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:q="urn:import:stroom.query.client.component"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:ed="urn:import:stroom.editor.client.component"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max default-min-sizes dock-container-vertical column-function-editor">
        <split:SplitPane thin="true" sizes="300px, *"
                         names="Help, Expression" addStyleNames="dock-max control-box">
            <g:SimplePanel styleName="max">
                <q:QueryHelp ui:field="queryHelp"/>
            </g:SimplePanel>
            <g:SimplePanel styleName="dock-max">
                <ed:CodeEditor ui:field="editor"/>
            </g:SimplePanel>
        </split:SplitPane>
        <g:FlowPanel addStyleNames="dock-min dock-container-horizontal column-function-editor__completion">
            <tx:Html>
                <code>ctrl-space</code>
                for auto-completion
            </tx:Html>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
