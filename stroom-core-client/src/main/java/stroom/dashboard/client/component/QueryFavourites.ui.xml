<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A query's favourites, above the expression of the one chosen -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:q="urn:import:stroom.query.client.component"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <split:SplitPane vertical="true" sizes="*, 120px"
                     names="Favourites, Selected query" addStyleNames="max default-min-sizes">
        <g:FlowPanel styleName="dock-container-vertical max stroom-control">
            <b:Toolbar name="Favourite query actions" addStyleNames="dock-min">
                <b:ToolbarButton ui:field="createButton" svg="ADD" title="Create Favourite From Current Query"/>
                <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Change Favourite Name" enabled="false"/>
                <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete Favourite" enabled="false"/>
            </b:Toolbar>
            <g:SimplePanel styleName="dock-max">
                <dg:DataGrid ui:field="list" pageSize="100000" profile="LISTBOX"
                             accessibleName="Favourite queries"/>
            </g:SimplePanel>
        </g:FlowPanel>
        <g:ScrollPanel styleName="max stroom-control">
            <q:ExpressionTree ui:field="expressionTree"/>
        </g:ScrollPanel>
    </split:SplitPane>
</ui:UiBinder>
