<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- One column of a Table Filter (table-filter-column.css): its name above its content, e.g. its conditional formatting rules -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel ui:field="panel" styleName="table-filter-column">
        <tx:Label ui:field="label" addStyleNames="table-filter-column__label" wordWrap="false"/>
    </g:FlowPanel>
</ui:UiBinder>
