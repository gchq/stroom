<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- One column of a Table Filter: its name above its content, e.g. its conditional formatting rules -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel ui:field="panel" styleName="table-filter-panel">
        <g:Label ui:field="label" addStyleNames="table-filter-label" wordWrap="false"/>
    </g:FlowPanel>
</ui:UiBinder>
