<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A dashboard's body: its layout of panes -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:fl="urn:import:stroom.dashboard.client.flexlayout">
    <g:FlowPanel styleName="dashboard-body max dock-container-vertical">
        <g:SimplePanel styleName="dock-max dashboard-body__content">
            <fl:FlexLayout ui:field="layout"/>
        </g:SimplePanel>
    </g:FlowPanel>
</ui:UiBinder>
