<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:ed="urn:import:stroom.editor.client.component"
             xmlns:button="urn:import:stroom.widget.button.client">
    <g:FlowPanel styleName="max stepping-button__container">
        <g:SimplePanel styleName="max">
            <ed:CodeEditor ui:field="editor"/>
        </g:SimplePanel>
        <button:FabButton ui:field="steppingButton"
                          addStyleNames="stepping-button fab-button--primary"
                          icon="STEPPING"
                          title="Enter Stepping Mode" visible="false"/>
    </g:FlowPanel>
</ui:UiBinder>
