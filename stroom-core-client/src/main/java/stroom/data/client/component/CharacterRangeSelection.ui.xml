<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The "Set Source Range" dialog's content (CharacterRangeSelection), the BEM block
     character-range-selection (character-range-selection.css). Each part of From and To is named by
     the part it is, as the From and To labels name each group of controls -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.widget.selection.client"
             xmlns:v="urn:import:stroom.widget.valuespinner.client"
             xmlns:lci="urn:import:stroom.widget.linecolinput.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max form">
        <g:FlowPanel addStyleNames="character-range-selection__info">
            <tx:Label>Total characters:</tx:Label>
            <tx:Label ui:field="lblTotalCharCount"/>
        </g:FlowPanel>
        <form:FormGroup identity="characterRangeSelectionFrom" label="From"
                        helpText="Where the range starts, as a line and column (for example 10:5) or as a character offset. Both are counted from 1 and are inclusive."
                        screenReaderText="Line:column such as 10:5, or a character offset. Counted from 1.">
            <g:FlowPanel styleName="character-range-selection__options">
                <l:SelectionBox ui:field="fromType" addStyleNames="allow-focus" accessibleName="Type"/>
                <lci:LineColInput ui:field="fromLineCol" addStyleNames="allow-focus"
                                  accessibleName="Line and column"/>
                <v:ValueSpinner ui:field="fromCharOffset" addStyleNames="allow-focus" minValue="1"
                                accessibleName="Character offset"/>
            </g:FlowPanel>
        </form:FormGroup>
        <form:FormGroup identity="characterRangeSelectionTo" label="To"
                        helpText="Where the range ends, as a line and column, a character offset, or a number of characters from the From position. Line, column and offset are counted from 1 and are inclusive."
                        screenReaderText="End as line:column, character offset or character count.">
            <g:FlowPanel styleName="character-range-selection__options">
                <l:SelectionBox ui:field="toType" addStyleNames="allow-focus" accessibleName="Type"/>
                <lci:LineColInput ui:field="toLineCol" addStyleNames="allow-focus"
                                  accessibleName="Line and column"/>
                <v:ValueSpinner ui:field="toCharOffset" addStyleNames="allow-focus" minValue="1"
                                accessibleName="Character offset"/>
                <v:ValueSpinner ui:field="toCharCount" addStyleNames="allow-focus" minValue="1"
                                accessibleName="Character count"/>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
