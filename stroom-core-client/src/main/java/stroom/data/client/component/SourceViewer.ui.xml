<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A stream's source: the streams being stepped through (when stepping) above its feed, id, part or
     record and type, its navigator, and its text with its classification -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:d="urn:import:stroom.data.client.component"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:pb="urn:import:stroom.widget.progress.client"
             xmlns:spinner="urn:import:stroom.widget.spinner.client"
             xmlns:tx="urn:import:stroom.widget.text.client">

    <split:SplitPane vertical="true" thin="true" sizes="300px, *"
                     names="Streams, Data" addStyleNames="max dock-container-vertical">
        <g:SimplePanel ui:field="metaListContainer" styleName="max"/>
        <g:FlowPanel styleName="source-viewer max dock-container-vertical">
            <g:FlowPanel styleName="dock-min dock-container-horizontal">
                <g:FlowPanel styleName="dock-max">
                    <tx:Label styleName="source-viewer__title-heading">Feed:</tx:Label>
                    <tx:Label ui:field="lblFeed" styleName="source-viewer__title-text"/>

                    <tx:Label styleName="source-viewer__title-heading">ID:</tx:Label>
                    <tx:Label ui:field="lblId" styleName="source-viewer__title-text"/>

                    <tx:Label ui:field="lblPartNoHeading" styleName="source-viewer__title-heading">Part:</tx:Label>
                    <tx:Label ui:field="lblPartNo" styleName="source-viewer__title-text"/>

                    <tx:Label ui:field="lblSegmentNoHeading" styleName="source-viewer__title-heading">Record:</tx:Label>
                    <tx:Label ui:field="lblSegmentNo" styleName="source-viewer__title-text"/>

                    <tx:Label styleName="source-viewer__title-heading">Stream Type:</tx:Label>
                    <tx:Label ui:field="lblType" styleName="source-viewer__title-text"/>
                </g:FlowPanel>
                <g:FlowPanel styleName="dock-min">
                    <g:SimplePanel styleName="source-viewer__character-navigator">
                        <d:CharacterNavigator ui:field="navigator"/>
                    </g:SimplePanel>
                </g:FlowPanel>
            </g:FlowPanel>
            <g:FlowPanel styleName="dock-max dock-container-vertical">
                <g:SimplePanel styleName="dock-min source-viewer__progress-bar-panel">
                    <pb:SourceProgressBar ui:field="progressBar" visible="false"/>
                </g:SimplePanel>
                <g:FlowPanel styleName="dock-max default-min-sizes source-viewer__content">
                    <spinner:LargeBusySpinner ui:field="spinner" addStyleNames="busy-spinner--centred" visible="false"/>
                    <d:ClassificationWrapper ui:field="classification">
                        <d:content>
                            <d:DataTextPane ui:field="text"/>
                        </d:content>
                    </d:ClassificationWrapper>
                </g:FlowPanel>
            </g:FlowPanel>
        </g:FlowPanel>
    </split:SplitPane>
</ui:UiBinder>
