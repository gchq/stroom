<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The item navigator (ItemNavigator), the BEM block item-navigator (item-navigator.css): the
     items shown, a link that opens the item selection dialog, and the buttons that move between
     them, hidden until there are items -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:btn="urn:import:stroom.widget.button.client">
    <g:FlowPanel styleName="item-navigator">
        <btn:LinkButton ui:field="lblDetail" addStyleNames="item-navigator__label" opensDialog="true"
                        visible="false"/>
        <btn:Toolbar name="Navigation">
            <btn:ToolbarButton ui:field="firstPageBtn" svg="FAST_BACKWARD" title="First" visible="false"/>
            <btn:ToolbarButton ui:field="previousPageBtn" svg="STEP_BACKWARD" title="Backward" visible="false"/>
            <btn:ToolbarButton ui:field="nextPageBtn" svg="STEP_FORWARD" title="Forward" visible="false"/>
            <btn:ToolbarButton ui:field="lastPageBtn" svg="FAST_FORWARD" title="Last" visible="false"/>
            <btn:RefreshButton ui:field="refresh" visible="false"/>
        </btn:Toolbar>
    </g:FlowPanel>
</ui:UiBinder>
