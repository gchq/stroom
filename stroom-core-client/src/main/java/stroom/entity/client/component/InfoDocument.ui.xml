             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:SimplePanel styleName="max">
        <tx:Html ui:field="info" styleName="info-layout"/>
    </g:SimplePanel>
</ui:UiBinder>
