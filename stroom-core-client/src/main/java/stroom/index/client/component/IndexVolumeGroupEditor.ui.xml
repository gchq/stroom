<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- An index volume group: its name, above its volumes -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max form">
        <form:FormGroup identity="indexVolumeGroupEditVolumeGroupName" label="Volume Group Name"
                        helpText="A unique name for the volume group."
                        screenReaderText="Must be unique."
                        required="true">
            <form:TextBox ui:field="name" addStyleNames="w-100"/>
        </form:FormGroup>
        <g:SimplePanel ui:field="list" styleName="dock-max control-box control-box--padded"/>
    </g:FlowPanel>
</ui:UiBinder>
