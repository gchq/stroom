<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- An index volume group: its name, above its volumes, with a warning if they are both shared and local -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:index="urn:import:stroom.index.client.component"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max form">
        <form:FormGroup identity="indexVolumeGroupEditVolumeGroupName" label="Volume Group Name"
                        helpText="A unique name for the volume group."
                        screenReaderText="Must be unique."
                        required="true">
            <form:TextBox ui:field="name" addStyleNames="w-100"/>
        </form:FormGroup>
        <tx:Label ui:field="mixedWarning" styleName="index-volume-group-editor__mixed-warning" visible="false"
                  text="This group holds both shared and local volumes. New shards are created on the shared volumes. Shards on the local volumes can only be read by the node that owns them, so they are not searched while that node is down."/>
        <g:SimplePanel styleName="dock-max control-box">
            <index:IndexVolumeStatusList ui:field="list"/>
        </g:SimplePanel>
    </g:FlowPanel>
</ui:UiBinder>
