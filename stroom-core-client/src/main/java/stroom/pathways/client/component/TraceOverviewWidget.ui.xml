<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:p="urn:import:stroom.data.pager.client">
    <!--
      A trace's overview (pathways.css): a vertical stack of the pager bar, shown once a trace is,
      with the group level buttons on the left and the pager on the right, then the trace itself
      (a fixed timeline above a scrolling list of its spans), which TraceOverviewWidget draws
    -->
    <g:FlowPanel styleName="trace-overview-root">
        <g:FlowPanel ui:field="pagerBar" styleName="trace-pager-bar" visible="false">
            <b:Toolbar ui:field="expandControls" name="Group levels" addStyleNames="trace-expand-controls"/>
            <p:Pager ui:field="pager"/>
        </g:FlowPanel>
        <g:HTML ui:field="panel" addStyleNames="trace-overview"/>
    </g:FlowPanel>
</ui:UiBinder>
