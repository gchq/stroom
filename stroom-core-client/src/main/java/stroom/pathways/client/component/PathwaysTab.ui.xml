<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:p="urn:import:stroom.pathways.client.component">
    <!-- A pathways document's Pathways tab: its pathways above the paths of the one selected -->
    <split:SplitPane vertical="true" thin="true" sizes="*, 400px"
                     names="Pathways, Paths" addStyleNames="max default-min-sizes">
        <g:SimplePanel styleName="max">
            <p:PathwayList ui:field="pathwayList"/>
        </g:SimplePanel>
        <g:SimplePanel styleName="max">
            <p:PathwayTree ui:field="pathwayTree"/>
        </g:SimplePanel>
    </split:SplitPane>
</ui:UiBinder>
