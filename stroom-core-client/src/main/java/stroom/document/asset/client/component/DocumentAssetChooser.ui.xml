<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:t="urn:import:stroom.document.asset.client.component">

    <!-- The asset tree, which scrolls itself, in a bordered panel -->
