<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- An alert's or confirmation's content (alert.css): its icon, its message, and the detail that
     Show Detail shows and hides -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:c="urn:import:stroom.widget.component.client">
    <g:HTMLPanel styleName="alert-layout">
        <div ui:field="icon" class="alert-icon"></div>
        <g:FlowPanel styleName="alert-message-area">
            <g:HTML ui:field="message" styleName="alert-message"/>
            <b:LinkButton ui:field="showHideDetail" addStyleNames="alert-showHide" visible="false"><span
                    class="alert-showHide-arrow" aria-hidden="true"></span>Show Detail</b:LinkButton>
            <!-- Scrolls when it is long (e.g. a stack trace), so the keyboard can reach it to scroll it -->
            <c:AriaPanel ui:field="detail" styleName="alert-detail" role="region" ariaLabel="Detail"
                         tabIndex="0" visible="false"/>
        </g:FlowPanel>
    </g:HTMLPanel>
</ui:UiBinder>
