<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A dictionary's imports, a row each, with Add, Remove and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel toolbarName="Dictionary actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="Add Imported Dictionary"/>
        <b:ToolbarButton ui:field="removeButton" svg="DELETE" title="Remove Imported Dictionary"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Document References"/>
    </dg:PagerPanel>
</ui:UiBinder>
