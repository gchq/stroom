<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A frame showing a page (iframe-panel and iframe-frame, stroom.css) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:SimplePanel styleName="iframe-panel">
        <g:Frame ui:field="frame" addStyleNames="iframe-frame"/>
    </g:SimplePanel>
</ui:UiBinder>
