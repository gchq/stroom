<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The place of a page shown as a tab (iframe-panel, stroom.css): the page's frame is over it,
     outside the tab, so the page isn't reloaded when the tab moves (iframe-content.css) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:SimplePanel styleName="iframe-panel"/>
</ui:UiBinder>
