<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.planb.client.component">
    <!--
      The settings of a traces store, each group a titled set of Plan B's settings widgets. Its
      maximum store size and the per-trace span limit are both about how much space the store may
      take, so they share the Storage group. A trace store has one file per time bucket and shard, so
      its size limit is per file, and neither of the general settings' write options reaches the
      shared file store. Trace retention deletes by insert time whatever the settings say, so it
      offers no "use state time", and the shared file store merge processor is the only thing that
      acts on the check frequency
    -->
    <g:FlowPanel styleName="max form">
        <v:SettingsGroup label="Shared File Store">
            <v:SharedFileStoreSettingsForm ui:field="sharedFileStore"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Publishing">
            <v:PublishingSettingsForm ui:field="publishing"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Storage">
            <g:FlowPanel styleName="form">
                <v:GeneralSettingsForm ui:field="general"
                                         maxStoreSizeHelpText="The size limit for each file in the store. A trace store has one file per time bucket and shard, so the whole store can be much bigger than this."
                                         writeOptionsVisible="false"/>
                <v:TraceGeneralSettingsForm ui:field="traceGeneral"/>
            </g:FlowPanel>
        </v:SettingsGroup>
        <v:SettingsGroup label="Data Retention">
            <v:RetentionSettingsForm ui:field="retention" useStateTimeVisible="false" checkIntervalVisible="true"/>
        </v:SettingsGroup>
    </g:FlowPanel>
</ui:UiBinder>
