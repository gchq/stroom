<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.planb.client.component">
    <!-- The settings of a session store, each group a titled set of Plan B's settings widgets -->
    <g:FlowPanel styleName="max form">
        <v:SettingsGroup label="General">
            <v:GeneralSettingsWidget ui:field="general"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Snapshot">
            <v:SnapshotSettingsWidget ui:field="snapshot"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Condense Data">
            <v:CondenseSettingsWidget ui:field="condense"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Data Retention">
            <v:RetentionSettingsWidget ui:field="retention"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Key Schema">
            <v:SessionKeySchemaSettingsWidget ui:field="keySchema"/>
        </v:SettingsGroup>
    </g:FlowPanel>
</ui:UiBinder>
