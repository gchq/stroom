<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.planb.client.component">
    <!-- The settings of a metric store, each group a titled set of Plan B's settings widgets -->
    <g:FlowPanel styleName="max form">
        <v:SettingsGroup label="General">
            <v:GeneralSettingsForm ui:field="general"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Snapshot">
            <v:SnapshotSettingsForm ui:field="snapshot"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Data Retention">
            <v:RetentionSettingsForm ui:field="retention"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Key Schema">
            <v:MetricKeySchemaSettingsForm ui:field="keySchema"/>
        </v:SettingsGroup>
        <v:SettingsGroup label="Value Schema">
            <v:MetricValueSchemaSettingsForm ui:field="valueSchema"/>
        </v:SettingsGroup>
    </g:FlowPanel>
</ui:UiBinder>
