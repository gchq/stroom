<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A rule's duplicate check rows, with a pager and their actions -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Duplicate check actions">
        <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete Selected Duplicate Check Rows"
                         enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Duplicate Management"/>
    </dg:PagerPanel>
</ui:UiBinder>
