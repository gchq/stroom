<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A rule's notifications, with New, Edit, Remove and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel toolbarName="Notification actions">
        <b:ToolbarButton ui:field="addButton" svg="ADD" title="New Notification"/>
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Notification" enabled="false"/>
        <b:ToolbarButton ui:field="removeButton" svg="DELETE" title="Remove Selected Notification" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Notifications"/>
    </dg:PagerPanel>
</ui:UiBinder>
