<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- An execution schedule's past executions, with Replay and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="History actions">
        <b:ToolbarButton ui:field="replayButton" svg="RERUN" title="Replay Selected Execution" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Scheduled Process History" multiLine="true"/>
    </dg:PagerPanel>
</ui:UiBinder>
