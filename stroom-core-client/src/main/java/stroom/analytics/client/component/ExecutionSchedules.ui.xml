<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The execution schedules: Edit, Batch Edit, Filter, Clear Filter, Run Now and Delete, how many
     are selected, and a pager above their grid -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Execution schedule actions">
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Schedule" enabled="false"/>
        <b:ToolbarButton ui:field="batchEditButton" svg="GENERATE" title="Batch Edit Schedules"/>
        <b:ToolbarButton ui:field="filterButton" svg="FILTER" title="Filter Schedules"/>
        <b:ToolbarButton ui:field="clearFilterButton" svg="CLEAR" title="Clear Schedule Filter" enabled="false"/>
        <b:ToolbarButton ui:field="runNowButton" svg="STEP_FORWARD" title="Run Schedules Now"/>
        <b:ToolbarButton ui:field="deleteButton" svg="DELETE" title="Delete Selected Schedules" enabled="false"/>
        <dg:toolbarWidget>
            <tx:Html ui:field="selectionCount" addStyleNames="paging-bar paging-bar__label"/>
        </dg:toolbarWidget>
        <dg:DataGrid ui:field="dataGrid" tableName="Execution Schedules"/>
    </dg:PagerPanel>
</ui:UiBinder>
