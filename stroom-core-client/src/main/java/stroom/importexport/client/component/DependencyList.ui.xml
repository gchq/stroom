<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The dependencies between documents, with a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager">
        <dg:DataGrid ui:field="dataGrid" pageSize="100" tableName="Dependencies"/>
    </dg:PagerPanel>
</ui:UiBinder>
