<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:layout="urn:import:stroom.widget.layout.client"
             xmlns:v="urn:import:stroom.widget.quickfilter.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:ex="urn:import:stroom.explorer.client.component">
    <g:FlowPanel styleName="max form overflow-hidden">
        <form:FormGroup identity="exportConfigSelect" label="Items To Export"
                        helpText="Tick the documents and folders to include in the export. Type in the filter box to find items by name." addStyleNames="max overflow-hidden"
                        screenReaderText="Tick items to export; use the filter to find them.">
            <g:FlowPanel styleName="dock-container-vertical dock-max quick-filter-layout overflow-hidden">
                <g:FlowPanel styleName="dock-min dock-container-horizontal">
                    <v:QuickFilter ui:field="nameFilter" addStyleNames="dock-max"/>
                    <b:Toolbar name="Export options" addStyleNames="dock-min">
                        <b:ToolbarToggleButton ui:field="filter" svg="FILTER" title="Filter Document Types"/>
                    </b:Toolbar>
                </g:FlowPanel>
                <layout:ScrollPane addStyleNames="dock-max form-control-border form-control-background">
                    <ex:ExplorerTree ui:field="tree"/>
                </layout:ScrollPane>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
