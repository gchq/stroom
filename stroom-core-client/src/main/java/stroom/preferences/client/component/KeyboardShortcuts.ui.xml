<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The keyboard shortcuts dialog's content: a filter above the list of shortcuts -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:view="urn:import:stroom.widget.quickfilter.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <g:FlowPanel styleName="max dock-container-vertical">
        <g:SimplePanel styleName="dock-min">
            <view:QuickFilter ui:field="quickFilter" accessibleName="Filter keyboard shortcuts"/>
        </g:SimplePanel>
        <g:SimplePanel styleName="dock-max keyBindingPreferences-list">
            <dg:DataGrid ui:field="dataGrid" tableName="Keyboard Shortcuts"/>
        </g:SimplePanel>
    </g:FlowPanel>
</ui:UiBinder>
