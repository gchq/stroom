<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:form="urn:import:stroom.widget.form.client">
    <split:SplitPane vertical="true" thin="true" sizes="50%, *"
                     names="Templates, Template" addStyleNames="max">
        <g:SimplePanel ui:field="table" styleName="max"/>
        <g:FlowPanel styleName="max form form-padding">
            <form:FormGroup
                    ui:field="descriptionFormGroup"
                    identity="contentTemplateTabDescription"
                    label="Description"
                    helpText="The description of the selected content template.">
                <g:HTML ui:field="description" addStyleNames="w-100"/>
            </form:FormGroup>

            <form:FormGroup
                    ui:field="expressionFormGroup"
                    identity="contentTemplateTabExpression"
                    label="Expression"
                    addStyleNames="dock-max"
                    helpText="When data arrives for a feed that does not exist yet, the first active template whose expression matches the data's header attributes is used. Attribute names are not case sensitive; an empty expression matches all data.">
                <g:SimplePanel ui:field="expression" styleName="w-100"/>
            </form:FormGroup>
        </g:FlowPanel>
    </split:SplitPane>
</ui:UiBinder>
