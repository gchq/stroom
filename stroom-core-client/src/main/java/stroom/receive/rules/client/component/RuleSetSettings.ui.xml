<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:q="urn:import:stroom.query.client.component"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <g:SimplePanel styleName="max">
        <split:SplitPane vertical="true" thin="true" sizes="50%, *"
                         names="Rules, Expression" addStyleNames="max">
            <g:SimplePanel ui:field="table" styleName="max dashboard-panel dock-container-vertical"/>
            <g:SimplePanel styleName="max dashboard-panel dock-container-vertical">
                <q:ExpressionTree ui:field="expressionTree"/>
            </g:SimplePanel>
        </split:SplitPane>
    </g:SimplePanel>
</ui:UiBinder> 
