<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A rule set's fields, with New, Edit, Delete and a pager -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Field actions">
        <b:ToolbarButton ui:field="newButton" svg="ADD" title="New Field"/>
        <b:ToolbarButton ui:field="editButton" svg="EDIT" title="Edit Selected Field" enabled="false"/>
        <b:ToolbarButton ui:field="removeButton" svg="DELETE" title="Delete Selected Fields" enabled="false"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Fields"/>
    </dg:PagerPanel>
</ui:UiBinder>
