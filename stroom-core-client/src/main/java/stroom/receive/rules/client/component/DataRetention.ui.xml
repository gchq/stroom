<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tab="urn:import:stroom.widget.tab.client"
             xmlns:c="urn:import:stroom.widget.component.client">
    <g:FlowPanel styleName="max dock-container-vertical">
        <g:FlowPanel styleName="dock-min data-retention__tab-bar-outer">
            <tab:LinkTabBar ui:field="tabBar" addStyleNames="max data-retention__tab-bar-inner"/>
        </g:FlowPanel>
        <c:LayerContainer ui:field="layerContainer" styleName="dock-max"/>
    </g:FlowPanel>
</ui:UiBinder>
