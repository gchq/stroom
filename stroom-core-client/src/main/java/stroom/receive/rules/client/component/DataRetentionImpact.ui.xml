<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The data retention rules' Impact Summary: how many streams each rule would delete, with buttons
     to run and stop the query, filter it, show it nested or flat, and expand or collapse it -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:dg="urn:import:stroom.widget.datagrid.client">
    <dg:PagerPanel ui:field="pager" toolbarName="Retention impact actions">
        <b:ToolbarButton ui:field="runButton" svg="PLAY" title="Run Query"/>
        <b:ToolbarButton ui:field="stopButton" svg="STOP" title="Stop Query"/>
        <b:ToolbarButton ui:field="filterButton" svg="FILTER" title="Set Query Filter"/>
        <!-- Pressed while the results are shown nested -->
        <b:ToolbarToggleButton ui:field="nestedButton" svg="TABLE_NESTED" title="Nested Results"/>
        <b:ToolbarButton ui:field="expandAllButton" svg="EXPAND_ALL" title="Expand All Results"/>
        <b:ToolbarButton ui:field="collapseAllButton" svg="COLLAPSE_ALL" title="Collapse All Results"/>
        <dg:DataGrid ui:field="dataGrid" tableName="Data Retention Impact"/>
    </dg:PagerPanel>
</ui:UiBinder>
