<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client">
    <!-- BEM block file-upload (file-upload.css) -->
    <g:FlowPanel styleName="file-upload">
        <b:Button ui:field="chooseFile" text="Choose File" addStyleNames="allow-focus Button--contained-primary file-upload__button"/>
        <g:Label ui:field="fileName" styleName="file-upload__name"/>
        <g:FileUpload ui:field="fileUpload" styleName="file-upload__input" name="fileUpload"/>
    </g:FlowPanel>
</ui:UiBinder>
