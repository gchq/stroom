<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:v="urn:import:stroom.widget.valuespinner.client">
    <g:FlowPanel styleName="date-time-view max dock-container-horizontal">
        <form:FormGroup identity="hour" label="Hour" addStyleNames="dock-min"
                        helpText="Hour of the day, 0 to 23. Values wrap round. Reset sets the hour, minute and second to 0."
                        screenReaderText="0 to 23.">
            <g:FlowPanel styleName="date-time-view__field">
                <v:ValueSpinner ui:field="hour" wrapValues="true"/>
                <b:LinkButton ui:field="hourReset" addStyleNames="date-time-view__shortcut"
                              text="Reset" ariaLabel="Reset hour"/>
            </g:FlowPanel>
        </form:FormGroup>
        <form:FormGroup ui:field="minuteGroup" identity="minute" label="Minute" addStyleNames="dock-min"
                        helpText="Minute, 0 to 59. Values wrap round. Reset sets the minute and second to 0."
                        screenReaderText="0 to 59.">
            <g:FlowPanel styleName="date-time-view__field">
                <v:ValueSpinner ui:field="minute" wrapValues="true"/>
                <b:LinkButton ui:field="minuteReset" addStyleNames="date-time-view__shortcut"
                              text="Reset" ariaLabel="Reset minute"/>
            </g:FlowPanel>
        </form:FormGroup>
        <form:FormGroup ui:field="secondGroup" identity="second" label="Second" addStyleNames="dock-min"
                        helpText="Second, 0 to 59. Values wrap round. Reset sets it to 0."
                        screenReaderText="0 to 59.">
            <g:FlowPanel styleName="date-time-view__field">
                <v:ValueSpinner ui:field="second" wrapValues="true"/>
                <b:LinkButton ui:field="secondReset" addStyleNames="date-time-view__shortcut"
                              text="Reset" ariaLabel="Reset second"/>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
