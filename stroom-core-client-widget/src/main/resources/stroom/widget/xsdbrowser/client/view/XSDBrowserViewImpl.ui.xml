<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder" xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:view="urn:import:stroom.widget.xsdbrowser.client.view"
             xmlns:btn="urn:import:stroom.widget.button.client">
    <g:FlowPanel styleName="xsdBrowser dock-container-vertical max">
        <g:FlowPanel ui:field="navigation" styleName="dock-min bar">
            <btn:LinkButton ui:field="homeLink" addStyleNames="link" text="Home" ariaLabel="Schema Home"
                            title="Go to the schema's top level"/>
            <btn:LinkButton ui:field="backLink" addStyleNames="link" text="Back"
                            title="Go back to the element shown before"/>
            <btn:LinkButton ui:field="forwardLink" addStyleNames="link" text="Forward"
                            title="Go forward to the element shown next"/>
        </g:FlowPanel>
        <split:SplitPane thin="true" sizes="*, 200px"
                         names="Diagram, Details" addStyleNames="dock-max">
            <view:XSDDisplay ui:field="diagram" styleName="dashboard-panel xsdBrowser-content" />
            <split:SplitPane vertical="true" thin="true" sizes="50%, *"
                             names="Documentation, Constraints" addStyleNames="max">
                <g:HTML ui:field="documentation" styleName="dashboard-panel xsdBrowser-documentation"/>
                <view:XSDConstraintDisplay ui:field="constraints" styleName="dashboard-panel xsdBrowser-constraints" />
            </split:SplitPane>
        </split:SplitPane>
    </g:FlowPanel>
</ui:UiBinder> 
