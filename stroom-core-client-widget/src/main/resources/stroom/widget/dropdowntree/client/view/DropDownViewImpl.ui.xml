<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <!-- A picker (drop-down.css). A problem with its value is shown under it (DropDownViewImpl) -->
    <g:FlowPanel styleName="drop-down stroom-control allow-focus">
        <g:Label ui:field="label" styleName="drop-down__value"/>
        <g:SimplePanel ui:field="ellipsesBtnPanel" styleName="drop-down__icon"/>
    </g:FlowPanel>
</ui:UiBinder>
