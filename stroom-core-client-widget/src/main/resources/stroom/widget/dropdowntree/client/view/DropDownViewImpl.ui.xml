<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:btn="urn:import:stroom.widget.button.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="dropDownView-container stroom-control allow-focus">
        <g:Label ui:field="label" styleName="dropDownView-label"/>
        <btn:Toolbar name="Warnings" addStyleNames="dropDownView-warningToolbar">
            <btn:ToolbarButton ui:field="warningButton" svg="ALERT" title="Show Warnings"
                               visible="false" addStyleNames="dropDownView-warning"/>
        </btn:Toolbar>
        <g:SimplePanel ui:field="ellipsesBtnPanel" styleName="dropDownView-button"/>
    </g:FlowPanel>
</ui:UiBinder>
