<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A pager (paging-bar.css): which rows are shown, of how many, and the buttons that page through them -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:paging="urn:import:stroom.widget.button.client"
             xmlns:refresh-button="urn:import:stroom.data.pager.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="paging-bar">
        <tx:Label ui:field="lblTitle" styleName="paging-bar__label"/>
        <g:HTMLPanel styleName="paging-bar__space">&nbsp;</g:HTMLPanel>
        <tx:Label ui:field="lblFrom" styleName="paging-bar__label"/>
        <form:TextBox ui:field="txtFrom" addStyleNames="paging-bar__text-box" visible="false"/>
        <tx:Label ui:field="lblToSeparator" text="&nbsp;to&nbsp;" styleName="paging-bar__label"/>
        <tx:Label ui:field="lblTo" styleName="paging-bar__label"/>
        <form:TextBox ui:field="txtTo" addStyleNames="paging-bar__text-box" visible="false"/>
        <tx:Label ui:field="lblOfSeparator" text="&nbsp;of&nbsp;" styleName="paging-bar__label"/>
        <tx:Label ui:field="lblOf" styleName="paging-bar__label"/>
        <g:HTMLPanel styleName="paging-bar__space">&nbsp;</g:HTMLPanel>
        <paging:Toolbar name="Paging">
            <paging:ToolbarButton ui:field="first" svg="FAST_BACKWARD" title="First"/>
            <paging:ToolbarButton ui:field="prev" svg="STEP_BACKWARD" title="Backward"/>
            <paging:ToolbarButton ui:field="next" svg="STEP_FORWARD" title="Forward"/>
            <paging:ToolbarButton ui:field="last" svg="FAST_FORWARD" title="Last"/>
            <refresh-button:RefreshButton ui:field="refresh"/>
        </paging:Toolbar>
    </g:FlowPanel>
</ui:UiBinder>
