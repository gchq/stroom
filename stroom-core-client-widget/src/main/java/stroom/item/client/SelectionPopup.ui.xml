<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A selection popup's content (the popup panel itself is SelectionPopup's, styled by
  selection-popup.css): the list, as big as its options within the popup's limits.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:v="urn:import:stroom.widget.popup.client"
             xmlns:i="urn:import:stroom.item.client">
    <v:SimplePopupLayout>
        <i:SelectionList ui:field="selectionList" fitContent="true"/>
    </v:SimplePopupLayout>
</ui:UiBinder>
