<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:e="urn:import:stroom.editor.client.ace">
    <!--
      A code editor (code-editor.css): the text, in Ace, with the overview bar of its errors and warnings
      beside it. An error loading the text is shown in place of the text, which is hidden
    -->
    <g:FlowPanel styleName="code-editor max dock-container-horizontal">
        <g:FlowPanel ui:field="content" styleName="code-editor__text dock-max">
            <e:Editor ui:field="editor" styleName="code-editor__ace"/>
            <g:ScrollPanel ui:field="errorPanel" styleName="code-editor__load-error-container max" visible="false">
                <g:HTML ui:field="errorText" styleName="code-editor__load-error"/>
            </g:ScrollPanel>
        </g:FlowPanel>
        <e:RightBar ui:field="rightBar" styleName="code-editor__overview dock-min"/>
    </g:FlowPanel>
</ui:UiBinder>
