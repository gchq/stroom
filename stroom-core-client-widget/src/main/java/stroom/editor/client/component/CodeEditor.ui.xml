<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:layout="urn:import:stroom.widget.layout.client"
             xmlns:e="urn:import:stroom.editor.client.ace"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <!--
      A code editor (code-editor.css): the text, in Ace, with the overview bar of its errors and warnings
      beside it. An error loading the text is shown in place of the text, which is hidden
    -->
    <g:FlowPanel styleName="code-editor max dock-container-horizontal">
        <g:FlowPanel ui:field="content" styleName="code-editor__text dock-max">
            <e:AceEditorPane ui:field="editor" styleName="code-editor__ace"/>
            <layout:ScrollPane ui:field="errorPanel" addStyleNames="code-editor__load-error-container max" visible="false"
                               role="region" ariaLabel="Load error">
                <tx:Html ui:field="errorText" styleName="code-editor__load-error"/>
            </layout:ScrollPane>
        </g:FlowPanel>
        <e:OverviewBar ui:field="rightBar" styleName="code-editor__overview dock-min"/>
    </g:FlowPanel>
</ui:UiBinder>
