<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A button (Button.css): an invisible copy of the text that sizes it (so it isn't part of its name),
  the ripples of a press, and its content: the busy spinner (only a picture: the button says it is
  busy with aria-busy), an optional icon and the text.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder">
    <button type="button" class="Button Button--base Button--contained has-text">
        <span ui:field="backgroundText" class="Button__backgroundText" aria-hidden="true">Close</span>
        <div ui:field="rippleContainer" class="ripple-container"></div>
        <div class="Button__content">
            <span class="Button__spinner">
                <span class="Button__spinner-ring" aria-hidden="true"></span>
            </span>
            <span ui:field="icon" class="Button__icon svgIcon" aria-hidden="true" focusable="false"></span>
            <span ui:field="text" class="Button__text">Close</span>
        </div>
    </button>
</ui:UiBinder>
