<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A quick filter above what it filters, bordered, as a dialog's content -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:view="urn:import:stroom.widget.dropdowntree.client.view"
             xmlns:c="urn:import:stroom.widget.component.client">
    <g:FlowPanel styleName="max dock-container-vertical quick-filter-layout">
        <view:QuickFilter ui:field="quickFilter" addStyleNames="dock-min"/>
        <g:SimplePanel ui:field="data" styleName="dock-max form-control-border form-control-background"/>
        <!-- Says which item is chosen, to screen readers -->
        <c:AriaPanel ui:field="status" styleName="sr-only" ariaLive="polite"/>
    </g:FlowPanel>
</ui:UiBinder>
