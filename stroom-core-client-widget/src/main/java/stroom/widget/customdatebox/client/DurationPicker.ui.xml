<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A duration (duration-picker.css): an amount and its unit, side by side, each named by the part it
  is, as the label of the field (a FormGroup) names the duration. The units are added in Java.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.widget.valuespinner.client"
             xmlns:i="urn:import:stroom.item.client">
    <g:FlowPanel styleName="duration-picker">
        <v:ValueSpinner ui:field="time" addStyleNames="duration-picker__amount" ariaLabel="Amount"/>
        <i:SelectionBox ui:field="timeUnit" addStyleNames="duration-picker__unit icon-box--fluid" ariaLabel="Unit"/>
    </g:FlowPanel>
</ui:UiBinder>
