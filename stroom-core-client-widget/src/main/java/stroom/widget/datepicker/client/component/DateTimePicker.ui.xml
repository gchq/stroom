<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- The "Set Date And Time" dialog's content (DateTimePicker), styled by date-time-view.css -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:date="urn:import:stroom.widget.datepicker.client"
             xmlns:v="urn:import:stroom.widget.valuespinner.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="date-time-view max dock-container-horizontal">
        <g:FlowPanel styleName="date-time-view__column dock-min">
            <form:FormLabel identity="dateHeading" label="Date" addStyleNames="date-time-view__heading"/>
            <tx:Label ui:field="date" addStyleNames="date-time-view__value"/>
            <g:FlowPanel addStyleNames="date-time-view__shortcuts">
                <b:LinkButton ui:field="today" addStyleNames="date-time-view__shortcut" text="Today"/>
                <b:LinkButton ui:field="yesterday" addStyleNames="date-time-view__shortcut" text="Yesterday"/>
                <b:LinkButton ui:field="weekStart" addStyleNames="date-time-view__shortcut" text="Week Start"/>
            </g:FlowPanel>
            <form:FormGroup identity="date" label="Select date" addStyleNames="dock-min"
                            helpText="Calendar for choosing the date. In the days, the arrow keys move a day or a week, Home and End to the start and end of the week, Page Up and Page Down a month, Shift with Page Up and Page Down a year, and Enter or Space chooses the day. Use Today, Yesterday or Week Start for quick choices.">
                <date:Calendar ui:field="datePicker"/>
            </form:FormGroup>
        </g:FlowPanel>
        <g:FlowPanel styleName="date-time-view__column date-time-view__column--time dock-max">
            <form:FormLabel identity="timeHeading" label="Time" addStyleNames="date-time-view__heading"/>
            <tx:Label ui:field="time" addStyleNames="date-time-view__value"/>
            <g:FlowPanel addStyleNames="date-time-view__shortcuts">
                <b:LinkButton ui:field="now" addStyleNames="date-time-view__shortcut" text="Now"/>
                <b:LinkButton ui:field="midnight" addStyleNames="date-time-view__shortcut" text="Midnight"/>
                <b:LinkButton ui:field="midday" addStyleNames="date-time-view__shortcut" text="Midday"/>
            </g:FlowPanel>
            <form:FormGroup identity="hour" label="Hour" addStyleNames="dock-min"
                            helpText="Hour of the day, 0 to 23, in the displayed time zone. Values wrap round. Reset sets the hour, minute, second and millisecond to 0."
                            screenReaderText="0 to 23.">
                <g:FlowPanel styleName="date-time-view__field">
                    <v:ValueSpinner ui:field="hour" addStyleNames="date-time-view__spinner" wrapValues="true" minValue="0" maxValue="23" minStep="1" maxStep="1"/>
                    <b:LinkButton ui:field="hourReset" addStyleNames="date-time-view__shortcut"
                                  text="Reset" ariaLabel="Reset hour"/>
                </g:FlowPanel>
            </form:FormGroup>
            <form:FormGroup identity="minute" label="Minute" addStyleNames="dock-min"
                            helpText="Minute, 0 to 59. Values wrap round. Reset sets the minute, second and millisecond to 0."
                            screenReaderText="0 to 59.">
                <g:FlowPanel styleName="date-time-view__field">
                    <v:ValueSpinner ui:field="minute" addStyleNames="date-time-view__spinner" wrapValues="true" minValue="0" maxValue="59" minStep="1" maxStep="1"/>
                    <b:LinkButton ui:field="minuteReset" addStyleNames="date-time-view__shortcut"
                                  text="Reset" ariaLabel="Reset minute"/>
                </g:FlowPanel>
            </form:FormGroup>
            <form:FormGroup identity="second" label="Second" addStyleNames="dock-min"
                            helpText="Second, 0 to 59. Values wrap round. Reset sets the second and millisecond to 0."
                            screenReaderText="0 to 59.">
                <g:FlowPanel styleName="date-time-view__field">
                    <v:ValueSpinner ui:field="second" addStyleNames="date-time-view__spinner" wrapValues="true" minValue="0" maxValue="59" minStep="1" maxStep="1"/>
                    <b:LinkButton ui:field="secondReset" addStyleNames="date-time-view__shortcut"
                                  text="Reset" ariaLabel="Reset second"/>
                </g:FlowPanel>
            </form:FormGroup>
            <form:FormGroup identity="millisecond" label="Millisecond" addStyleNames="dock-min"
                            helpText="Millisecond, 0 to 999. Values wrap round. Reset sets it to 0."
                            screenReaderText="0 to 999.">
                <g:FlowPanel styleName="date-time-view__field">
                    <v:ValueSpinner ui:field="millisecond" addStyleNames="date-time-view__spinner" wrapValues="true" minValue="0" maxValue="999" minStep="1" maxStep="10"/>
                    <b:LinkButton ui:field="millisecondReset" addStyleNames="date-time-view__shortcut"
                                  text="Reset" ariaLabel="Reset millisecond"/>
                </g:FlowPanel>
            </form:FormGroup>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
