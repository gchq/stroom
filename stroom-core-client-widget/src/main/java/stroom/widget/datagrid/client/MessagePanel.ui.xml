<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A message over the middle of what it is put in (dashboard.css), hidden until shown -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:SimplePanel styleName="dashboardVis-messageOuter" visible="false">
        <g:HTML ui:field="message" styleName="dashboardVis-messageInner"/>
    </g:SimplePanel>
</ui:UiBinder>
