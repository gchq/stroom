<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A message over the middle of what it is put in (message-panel.css), hidden until shown -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:SimplePanel styleName="message-panel" visible="false">
        <tx:Html ui:field="message" styleName="message-panel__message"/>
    </g:SimplePanel>
</ui:UiBinder>
