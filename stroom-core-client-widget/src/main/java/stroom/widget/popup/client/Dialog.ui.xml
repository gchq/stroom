<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A dialog (dialog.css) of a fixed size: its frame, then its title bar (an icon and its caption, set
  by its caller, the busy spinner and the window options button) above its content, and the hint
  shown while it is moved from the keyboard, said as it changes.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:spinner="urn:import:stroom.widget.spinner.client"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:svg="urn:import:stroom.svg.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:HTMLPanel styleName="dialog__container">
        <g:SimplePanel styleName="dialog__frame"/>
        <g:FlowPanel styleName="dialog__layout">
            <g:FlowPanel styleName="dialog__title-bar">
                <svg:Icon ui:field="icon" addStyleNames="dialog__icon"/>
                <tx:Label ui:field="titleText" styleName="dialog__title">Caption</tx:Label>
                <g:SimplePanel styleName="dialog__spinner">
                    <spinner:SpinnerLarge ui:field="spinner" visible="false"/>
                </g:SimplePanel>
                <b:Toolbar ui:field="windowToolbar" name="Window" addStyleNames="dialog__toolbar">
                    <b:ToolbarButton ui:field="windowButton" svg="ELLIPSES_VERTICAL" title="Window Options"
                                     opensMenu="true"/>
                </b:Toolbar>
            </g:FlowPanel>
            <g:SimplePanel ui:field="content" styleName="dialog__body"/>
        </g:FlowPanel>
        <div ui:field="hint" class="dialog__hint" role="status"></div>
    </g:HTMLPanel>
</ui:UiBinder>
