<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A dialog's content, then Accept and Reject at the end of the row below it (dialog.css); Accept
     is green, as on the splash screen -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client">
    <g:FlowPanel styleName="max dock-container-vertical">
        <g:SimplePanel ui:field="content" styleName="dialog__content"/>
        <g:FlowPanel styleName="dialog__buttons dialog__buttons--end">
            <b:Button ui:field="accept" addStyleNames="allow-focus button--contained-green" text="Accept"
                      icon="OK"/>
            <b:Button ui:field="reject" addStyleNames="allow-focus button--contained-secondary" text="Reject"
                      icon="CANCEL"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
