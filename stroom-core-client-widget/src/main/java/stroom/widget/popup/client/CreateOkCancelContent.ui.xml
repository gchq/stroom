<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A dialog's content, then New at the start of the row below it, and OK and Cancel at its end (dialog.css) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client">
    <g:FlowPanel styleName="max dock-container-vertical">
        <g:SimplePanel ui:field="content" styleName="dialog__content"/>
        <g:FlowPanel styleName="dialog__buttons dialog__buttons--start">
            <b:Button ui:field="create" addStyleNames="allow-focus button--contained-green" text="New" icon="ADD"/>
            <g:FlowPanel styleName="dialog__button-group">
                <b:Button ui:field="ok" addStyleNames="allow-focus button--contained-primary" text="OK" icon="OK"/>
                <b:Button ui:field="cancel" addStyleNames="allow-focus button--contained-secondary" text="Cancel"
                          icon="CANCEL"/>
            </g:FlowPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
