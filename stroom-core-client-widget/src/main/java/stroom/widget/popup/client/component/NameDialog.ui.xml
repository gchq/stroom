<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A name dialog's content (form.css): the name, which must be given, and why it isn't valid -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="max form">
        <form:FormGroup identity="textBoxFieldName" label="Name"
                        helpText="The name to save this under. A name is required."
                        screenReaderText="The name to save this under."
                        required="true">
            <g:FlowPanel>
                <form:TextBox ui:field="textBox"/>
                <tx:Label ui:field="feedback" styleName="feedback"/>
            </g:FlowPanel>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
