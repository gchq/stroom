<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A pane of HTML (info-page.css), scrolling when it is bigger than the pane -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:layout="urn:import:stroom.widget.layout.client">
    <layout:ScrollPane ui:field="scroll" addStyleNames="max info-page" role="region" ariaLabel="Text">
        <g:HTMLPanel ui:field="content"/>
    </layout:ScrollPane>
</ui:UiBinder>
