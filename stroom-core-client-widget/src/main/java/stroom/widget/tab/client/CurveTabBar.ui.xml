<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  The document tabs' bar (tab-bar.css): its tab list, named for what it holds, which the tabs go in.
  Its overflow selector is added after it when first needed.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder">
    <div class="tab-bar tab-bar--curved">
        <div ui:field="tabList" class="tab-bar__tabs" role="tablist" aria-label="Open documents"></div>
    </div>
</ui:UiBinder>
