<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A document tab (tab-bar.css): its icon (a picture: the tab is named by its label), its label, then
  its busy spinner and its close cross (which the spinner gives way to on hover or keyboard focus;
  a tab is closed from the keyboard with Delete, so the cross isn't read).
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:c="urn:import:stroom.widget.component.client"
             xmlns:sp="urn:import:stroom.widget.spinner.client"
             xmlns:svg="urn:import:stroom.svg.client">
    <c:AriaPanel styleName="tab-bar__tab" role="tab" tabIndex="-1" ariaSelected="false">
        <c:AriaPanel ui:field="iconPanel" styleName="tab-bar__icon" ariaHidden="true">
            <svg:Icon ui:field="icon"/>
        </c:AriaPanel>
        <g:Label ui:field="label" styleName="tab-bar__label"/>
        <g:FlowPanel styleName="tab-bar__end">
            <sp:SpinnerSmall ui:field="spinner" addStyleNames="tab-bar__spinner"/>
            <c:AriaPanel ui:field="close" styleName="tab-bar__close" ariaHidden="true">
                <svg:Icon image="TAB_CLOSE"/>
            </c:AriaPanel>
        </g:FlowPanel>
    </c:AriaPanel>
</ui:UiBinder>
