<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tab="urn:import:stroom.widget.tab.client"
             xmlns:c="urn:import:stroom.widget.component.client"
             xmlns:b="urn:import:stroom.widget.button.client">
    <tab:CurveTabLayoutPanel ui:field="layout" styleName="curve-tab-layout__layout">
        <g:FlowPanel styleName="curve-tab-layout__bar">
            <b:Toolbar name="Sidebar" addStyleNames="curve-tab-layout__toolbar toolbar--quiet">
                <b:ToolbarButton ui:field="menu" svg="HIDE_MENU" title="Hide Sidebar"/>
            </b:Toolbar>
            <g:SimplePanel styleName="curve-tab-layout__tab-bar-outer">
                <tab:CurveTabBar ui:field="tabBar"/>
            </g:SimplePanel>
        </g:FlowPanel>
        <g:SimplePanel styleName="curve-tab-layout__layer-container-outer">
            <c:LayerContainer ui:field="layerContainer" styleName="curve-tab-layout__content"/>
        </g:SimplePanel>
    </tab:CurveTabLayoutPanel>
</ui:UiBinder> 
