<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tab="urn:import:stroom.widget.tab.client"
             xmlns:b="urn:import:stroom.widget.button.client">
    <tab:CurveTabLayoutPanel ui:field="layout" styleName="curve-tab-layout__layout">
        <g:FlowPanel ui:field="tabBarContainer"  styleName="tab-bar-container">
            <b:Toolbar name="Sidebar" addStyleNames="toolbar--quiet">
                <b:ToolbarButton ui:field="menu" svg="HIDE_MENU" title="Hide Sidebar"/>
            </b:Toolbar>
            <g:SimplePanel ui:field="tabBarOuter"
                           styleName="curve-tab-layout__tab-bar-outer">
                <tab:CurveTabBar ui:field="tabBar"/>
            </g:SimplePanel>
        </g:FlowPanel>
        <g:SimplePanel ui:field="layerContainerOuter"
                       styleName="curve-tab-layout__layer-container-outer">
            <tab:LayerContainerImpl ui:field="layerContainer" styleName="stroom-main-content-container"/>
        </g:SimplePanel>
    </tab:CurveTabLayoutPanel>
</ui:UiBinder> 
