<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A link tab (tab-bar.css): an invisible bold copy of its label that keeps its width the same when it
  is selected (so screen readers don't read it), its label, and where a dashboard pane being dragged
  would be dropped.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:c="urn:import:stroom.widget.component.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <c:AriaPanel styleName="tab-bar__tab" role="tab" tabIndex="-1" ariaSelected="false">
        <c:AriaPanel ui:field="sizer" styleName="tab-bar__sizer" ariaHidden="true"/>
        <tx:Label ui:field="label" styleName="tab-bar__label"/>
        <g:SimplePanel ui:field="hotspot" styleName="tab-bar__hotspot"/>
    </c:AriaPanel>
</ui:UiBinder>
