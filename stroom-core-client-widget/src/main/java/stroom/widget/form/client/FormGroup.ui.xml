<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A form group's parts (form-group.css), in the order they are shown: the label row (label and help
  button), the description row, the control (added by the template that declares the group), what
  is wrong with its value, and the description screen readers read but nobody sees. FormGroup shows
  only the parts in use, so it arranges them itself once it has something to show.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:f="urn:import:stroom.widget.form.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel ui:field="formGroupPanel" styleName="form-group">
        <g:FlowPanel ui:field="labelPanel" styleName="form-group__label-row">
            <f:FormLabel ui:field="formLabel" addStyleNames="form-group__label"/>
            <f:FormGroupHelpButton ui:field="helpButton" title="Click for help"/>
        </g:FlowPanel>
        <g:FlowPanel ui:field="descriptionPanel" styleName="form-group__description-row"/>
        <tx:Label ui:field="feedbackLabel" styleName="form-group__feedback"/>
        <tx:Label ui:field="helpDescription" styleName="form-group__help-text" visible="false"/>
    </g:FlowPanel>
</ui:UiBinder>
