<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A password box (password-box.css): the text box, then over its end any badge and the button that
  shows and hides the password (named for what pressing it does, in Java), then an unseen line that
  tells a screen reader the password was shown or hidden.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client">
    <g:HTMLPanel styleName="password-box">
        <g:PasswordTextBox ui:field="input" addStyleNames="password-box__input"/>
        <g:FlowPanel ui:field="end" styleName="password-box__end">
            <b:Toolbar name="Password" addStyleNames="password-box__toolbar">
                <b:ToolbarButton ui:field="revealButton" svg="EYE"/>
            </b:Toolbar>
        </g:FlowPanel>
        <div ui:field="status" class="password-box__status sr-only" aria-live="polite"></div>
    </g:HTMLPanel>
</ui:UiBinder>
