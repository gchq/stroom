<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A box of the schema diagram (xsdbrowser.css): its title (an image for its kind of node, then its
  name), which selects its node when clicked, then any content below it, added in Java.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.widget.xsdbrowser.client.view">
    <g:FlowPanel styleName="outerBox">
        <g:FlowPanel ui:field="box" styleName="box">
            <v:ClickPanel ui:field="title" styleName="boxTitle">
                <g:FlowPanel styleName="boxTitle-row">
                    <g:SimplePanel ui:field="image" styleName="marginRight"/>
                    <g:Label ui:field="titleText" addStyleNames="boxTitle-text"/>
                </g:FlowPanel>
            </v:ClickPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
