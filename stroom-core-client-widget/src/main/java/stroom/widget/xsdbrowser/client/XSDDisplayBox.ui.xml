<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A box of the schema diagram (xsd-browser.css): its title (an image for its kind of node, then its
  name), which selects its node when clicked, then any content below it (given in Java), which
  takes the rest of the height and scrolls; hidden when there is none.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.widget.xsdbrowser.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="xsd-browser__outer-box">
        <g:FlowPanel styleName="xsd-browser__box">
            <v:ClickPanel ui:field="title" styleName="xsd-browser__box-title">
                <g:FlowPanel styleName="xsd-browser__box-title-row">
                    <g:SimplePanel ui:field="image" styleName="xsd-browser__icon"/>
                    <tx:Label ui:field="titleText" addStyleNames="xsd-browser__box-title-text"/>
                </g:FlowPanel>
            </v:ClickPanel>
            <g:ScrollPanel ui:field="content" addStyleNames="xsd-browser__box-content" visible="false"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
