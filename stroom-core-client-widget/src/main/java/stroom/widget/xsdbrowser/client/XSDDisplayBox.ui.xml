<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A box of the schema diagram (xsd-browser.css): its title (an image for its kind of node, then its
  name), which selects its node when clicked, then any content below it, added in Java.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:v="urn:import:stroom.widget.xsdbrowser.client">
    <g:FlowPanel styleName="xsd-browser__outer-box">
        <g:FlowPanel ui:field="box" styleName="xsd-browser__box">
            <v:ClickPanel ui:field="title" styleName="xsd-browser__box-title">
                <g:FlowPanel styleName="xsd-browser__box-title-row">
                    <g:SimplePanel ui:field="image" styleName="xsd-browser__icon"/>
                    <g:Label ui:field="titleText" addStyleNames="xsd-browser__box-title-text"/>
                </g:FlowPanel>
            </v:ClickPanel>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
