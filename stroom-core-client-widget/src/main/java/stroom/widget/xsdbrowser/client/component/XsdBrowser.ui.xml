<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A schema's diagram, with its navigation, the selected node's documentation and its constraints (xsd-browser.css) -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder" xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:view="urn:import:stroom.widget.xsdbrowser.client"
             xmlns:a="urn:import:stroom.widget.component.client"
             xmlns:btn="urn:import:stroom.widget.button.client"
             xmlns:tx="urn:import:stroom.widget.text.client">
    <g:FlowPanel styleName="xsd-browser dock-container-vertical max">
        <a:AriaPanel styleName="dock-min" role="group" ariaLabel="Schema navigation">
            <btn:LinkButton ui:field="homeLink" addStyleNames="xsd-browser__link" text="Home" ariaLabel="Schema Home"
                            title="Go to the schema's top level"/>
            <btn:LinkButton ui:field="backLink" addStyleNames="xsd-browser__link" text="Back"
                            title="Go back to the element shown before"/>
            <btn:LinkButton ui:field="forwardLink" addStyleNames="xsd-browser__link" text="Forward"
                            title="Go forward to the element shown next"/>
        </a:AriaPanel>
        <split:SplitPane thin="true" sizes="*, 200px"
                         names="Diagram, Details" addStyleNames="dock-max">
            <view:XsdDiagram ui:field="diagram" styleName="xsd-browser__diagram" />
            <split:SplitPane vertical="true" thin="true" sizes="50%, *"
                             names="Documentation, Constraints" addStyleNames="max">
                <tx:Html ui:field="documentation" styleName="xsd-browser__documentation"/>
                <view:XsdConstraints ui:field="constraints" styleName="xsd-browser__constraints" />
            </split:SplitPane>
        </split:SplitPane>
    </g:FlowPanel>
</ui:UiBinder>
