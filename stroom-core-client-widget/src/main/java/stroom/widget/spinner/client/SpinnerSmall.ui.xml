<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A small spinner (busy-spinner.css); its picture is put in the inner element -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder">
    <div class="busy-spinner busy-spinner--small">
        <div class="busy-spinner__outer">
            <div ui:field="inner" class="busy-spinner__inner" title="Loading..."></div>
        </div>
    </div>
</ui:UiBinder>
