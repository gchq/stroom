<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!--
  A selection box (selection-box.css): a WAI-ARIA combobox, its text box (the named control, which
  opens the list of values) over a picture of its value (which screen readers skip, as the text box
  holds the value too), in an icon box with a drop-down arrow at its end. Only one of the two shows:
  the text box in a box that can be typed in, the picture in one that can't (the select-only modifier).
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:c="urn:import:stroom.widget.component.client"
             xmlns:f="urn:import:stroom.widget.form.client">
    <f:IconBox ui:field="iconBox" addStyleNames="selection-box selection-box--select-only">
        <f:dropDown>
            <g:FlowPanel styleName="selection-box__control">
                <c:AriaPanel ui:field="renderBox" styleName="selection-box__value stroom-control allow-focus"
                             ariaHidden="true"/>
                <f:TextBox ui:field="textBox" addStyleNames="selection-box__input stroom-control allow-focus"
                             readOnly="true" role="combobox" ariaHasPopup="listbox" ariaExpanded="false"/>
            </g:FlowPanel>
        </f:dropDown>
    </f:IconBox>
</ui:UiBinder>
