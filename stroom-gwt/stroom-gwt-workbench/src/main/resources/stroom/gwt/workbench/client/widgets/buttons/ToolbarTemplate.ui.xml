<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<!-- A row of two toolbars declared in a template, as a view would: the icons are set by the svg
     attribute, the names by the toolbar's name and each button's title, and a separator divides
     the first toolbar's buttons -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:stroom.widget.button.client">
    <b:ToolbarRow>
        <b:Toolbar name="Document actions">
            <b:ToolbarButton ui:field="save" svg="SAVE" title="Save"/>
            <b:ToolbarButton svg="SAVEAS" title="Save As"/>
            <b:ToolbarSeparator/>
            <b:ToolbarToggleButton ui:field="filter" svg="FILTER" title="Show Filters"/>
        </b:Toolbar>
        <b:Toolbar name="Paging">
            <b:ToolbarButton ui:field="first" svg="FAST_BACKWARD" title="First"/>
            <b:ToolbarButton svg="FAST_FORWARD" title="Last"/>
        </b:Toolbar>
    </b:ToolbarRow>
</ui:UiBinder>
