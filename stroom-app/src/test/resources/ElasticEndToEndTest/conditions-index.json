{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "StreamId": { "type": "long" },
      "EventId": { "type": "long" },
      "Id": { "type": "keyword" },
      "Keyword": { "type": "keyword" },
      "ConstantKeyword": { "type": "constant_keyword", "value": "fixed" },
      "Wildcard": { "type": "wildcard" },
      "Text": { "type": "text" },
      "Boolean": { "type": "boolean" },
      "Date": { "type": "date" },
      "DateNanos": { "type": "date_nanos" },
      "Ip": { "type": "ip" },
      "Long": { "type": "long" },
      "UnsignedLong": { "type": "unsigned_long" },
      "Integer": { "type": "integer" },
      "Short": { "type": "short" },
      "Byte": { "type": "byte" },
      "Version": { "type": "version" },
      "Float": { "type": "float" },
      "HalfFloat": { "type": "half_float" },
      "ScaledFloat": { "type": "scaled_float", "scaling_factor": 100 },
      "Double": { "type": "double" },
      "Nested": {
        "type": "nested",
        "properties": {
          "Number": { "type": "long" }
        }
      }
    }
  }
}
